# ------------------------------------------------------------------ small helpers

MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()


def game_dir(path):
    real = os.path.realpath(os.path.expanduser(path))
    return real if os.path.isdir(real) else os.path.dirname(real)


def derive_profile(path):
    """The profile name gom would pick for this game (resolve_game in bin/gom).
    gom's tr works on bytes, so every byte of a non-ASCII letter becomes one '_'."""
    gdir = game_dir(path)
    data = os.path.realpath(GOM_DATA)
    if gdir.startswith(data + os.sep):
        rest = gdir[len(data) + 1:].split(os.sep)
        if len(rest) >= 3 and rest[1] == "home" and rest[2]:
            return rest[0]
    base = os.path.basename(gdir)
    if base.lower() in GENERIC_DIRS:
        base = os.path.basename(os.path.dirname(gdir))
    raw = base.encode("utf-8", "surrogateescape")
    keep = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-"
    name = bytes(c if c in keep else 0x5F for c in raw).decode("ascii")
    return name.lstrip("._-")[:64] or "game"


def clean_title(text):
    """'ULTRAKILL (v.17d4) [Unity3D] [Goldberg].sh' -> 'ULTRAKILL'"""
    t = re.sub(r"\.(sh|run|x86_64|x86|bin|appimage)$", "", text, flags=re.I)
    t = re.sub(r"[\[(\{][^\])\}]*[\])\}]", " ", t)
    t = t.replace("_", " ")
    if " " not in t.strip() and t.count(".") >= 2:          # Some.Game.Name
        t = t.replace(".", " ")
    t = re.sub(r"\b(v|ver|version)\.?\s*\d[\w.]*", " ", t, flags=re.I)
    t = re.sub(r"\b(linux|gog|goldberg|repack|x64|x86_64|setup|installer)\b", " ", t, flags=re.I)
    return re.sub(r"\s+", " ", t).strip(" -._") or text


def title_from_path(path):
    real = os.path.realpath(os.path.expanduser(path))
    parent = os.path.basename(os.path.dirname(real))
    if os.path.isfile(real) and re.search(r"\.(sh|run)$", real, re.I) and parent.lower() not in GENERIC_DIRS:
        return clean_title(parent)
    gdir = game_dir(path)
    base = os.path.basename(gdir)
    if base.lower() in GENERIC_DIRS:
        base = os.path.basename(os.path.dirname(gdir))
    return clean_title(base)


def sort_key(title):
    """Natural, case-blind order that ignores a leading article: 'Doom 2' < 'Doom 10'."""
    t = re.sub(r"^(the|a|an)\s+", "", title.casefold().strip())
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", t)]


def fmt_duration(s):
    s = int(s or 0)
    if s < 60:
        return "under a minute"
    if s < 3600:
        return "%d min" % (s // 60)
    if s < 36000:
        return ("%.1f h" % (s / 3600)).replace(".0 h", " h")
    return "%d h" % (s // 3600)


def fmt_long_duration(s):
    s = int(s or 0)
    if s < 60:
        return "under a minute"
    h, m = s // 3600, (s % 3600) // 60
    return ("%d h %d min" % (h, m) if m else "%d h" % h) if h else "%d min" % m


def fmt_date(ts):
    d = date.fromtimestamp(ts)
    return "%d %s %d" % (d.day, MONTHS[d.month - 1], d.year)


def fmt_when(ts):
    if not ts:
        return ""
    days = (date.today() - date.fromtimestamp(ts)).days
    if days <= 0:
        return "today"
    if days == 1:
        return "yesterday"
    if days < 30:
        return "%d days ago" % days
    return fmt_date(ts)


def fmt_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%d %s" if unit == "B" else "%.1f %s") % (n, unit)
        n /= 1024
    return "%.1f TB" % n


def short_path(p):
    return "~" + p[len(HOME):] if p == HOME or p.startswith(HOME + os.sep) else p


ANSI_RE = re.compile(r"\x1b(\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)|[@-Z\\-_])")
CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")


def sanitize(text):
    """Logs come from untrusted games: drop escape sequences and control characters."""
    text = ANSI_RE.sub("", text).replace("\r\n", "\n").replace("\r", "\n")
    return CTRL_RE.sub("", text)


def parse_env(text):
    out = []
    for tok in shlex.split(text or ""):
        if not ENV_RE.match(tok):
            raise ValueError("'%s' is not NAME=VALUE" % tok)
        out.append(tok)
    return out


def parse_tags(text):
    seen = []
    for t in (text or "").split(","):
        t = " ".join(t.split())
        if t and t.casefold() not in (s.casefold() for s in seen):
            seen.append(t)
    return seen


def dir_size(path):
    """Disk usage like du: allocated blocks, symlinks not followed, errors skipped."""
    total, stack = 0, [path]
    while stack:
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    try:
                        st = e.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    total += st.st_blocks * 512
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
        except OSError:
            pass
    return total


def spawn(fn, done, *args):
    """Run fn(*args) on a thread; done(result, error) runs later on the GTK thread."""
    def work():
        try:
            res, err = fn(*args), None
        except Exception as e:      # noqa: BLE001  any failure must reach the UI, not kill the thread
            res, err = None, e
        GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=work, daemon=True).start()


# ------------------------------------------------------------------ gom

def find_gom():
    env = os.environ.get("GOM")
    if env:
        return env
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gom")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("gom") or "gom"


def gom_launchers(gom, folder):
    """What gom would start in FOLDER (gom --launchers). Returns (state, names) where state
    is ok (gom picks names[0] itself), choose, none, or unknown (old gom, or it failed)."""
    try:
        r = subprocess.run([gom, "--launchers", folder], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=20, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown", []
    names = [n for n in r.stdout.splitlines() if n]
    return {0: "ok", 3: "choose", 4: "none"}.get(r.returncode, "unknown"), names


def gom_command(gom, g, path=None):
    cmd = [gom]
    if g.get("windowed"):
        cmd.append("-w")
    if g.get("res"):
        cmd += ["-r", g["res"]]
    if g.get("grab"):
        cmd.append("-g")
    if g.get("mute"):
        cmd.append("-m")
    for kv in g.get("env") or []:
        cmd += ["-e", kv]
    if g.get("profile"):
        cmd += ["-n", g["profile"]]
    cmd.append(path or g["path"])
    if g.get("args"):
        cmd += ["--"] + shlex.split(g["args"])
    return cmd


def gom_environ(g):
    env = dict(os.environ)
    env.pop("GOM_GAMESCOPE_ARGS", None)
    if g.get("gamescope"):
        env["GOM_GAMESCOPE_ARGS"] = g["gamescope"]
    return env


def parse_run_log(text):
    """What gom said during one run: did the game start, errors, folders an installer made."""
    r = {"started": False, "errors": [], "installed": []}
    for ln in text.splitlines():
        ln = ln.strip()
        if ln.startswith("gom: running '"):
            r["started"] = True
        elif ln.startswith("gom: error: "):
            r["errors"].append(ln[len("gom: error: "):])
        elif ln.startswith("gom: new game folder in the private home: "):
            r["installed"].append(ln[len("gom: new game folder in the private home: "):])
    return r


def read_tail(path, limit=512 * 1024):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - limit))
            data = f.read()
    except OSError:
        return None
    text = data.decode("utf-8", "replace")
    if size > limit:
        text = "[only the last %s are shown]\n" % fmt_size(limit) + text.split("\n", 1)[-1]
    return sanitize(text)


def held_locks():
    """dev:ino keys of every file somebody holds a lock on. Read-only: shelf never takes
    gom's profile lock itself, so it cannot make a starting gom think the game runs."""
    try:
        with open("/proc/locks") as f:
            return set(re.findall(r"\b([0-9a-f]+:[0-9a-f]+:\d+)\b", f.read()))
    except OSError:
        return set()


def profile_running(profile, held):
    if not profile:
        return False
    try:
        st = os.stat(os.path.join(GOM_DATA, profile, ".lock"))
    except OSError:
        return False
    return "%02x:%02x:%d" % (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino) in held


def shelf_alive(pid):
    try:
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return b"shelf" in f.read()
    except (OSError, TypeError):
        return False


def gom_profiles():
    try:
        return sorted(d for d in os.listdir(GOM_DATA)
                      if PROFILE_RE.match(d) and os.path.isdir(os.path.join(GOM_DATA, d)))
    except OSError:
        return []


def profile_dirs(profile):
    """Visible top-level folders in a profile's private home (where installers put games)."""
    home = os.path.join(GOM_DATA, profile, "home")
    try:
        return {d for d in os.listdir(home)
                if not d.startswith(".") and os.path.isdir(os.path.join(home, d))}
    except OSError:
        return set()


def find_terminal():
    """argv prefix that runs a command in a terminal window, or None."""
    cands = []
    if os.environ.get("TERMINAL"):
        cands.append((os.environ["TERMINAL"], ["-e"]))
    cands += [("urxvt", ["-e"]), ("urxvtc", ["-e"]), ("xterm", ["-e"]), ("alacritty", ["-e"]),
              ("st", ["-e"]), ("kitty", []), ("foot", [])]
    for name, flag in cands:
        exe = shutil.which(name)
        if exe:
            return [exe] + flag
    return None


# ------------------------------------------------------------------ library and settings

class Library:
    """The game list in games.json. Every change happens under a file lock, on top of the
    newest version of the file, so the window and `shelf --run` never undo each other."""

    def __init__(self, path=LIBRARY):
        self.path = path
        self.games, self.by_id = [], {}
        self.history = {}
        self.stamp = None
        self.warning = None
        for d in (os.path.dirname(path), COVERS, LOGS):
            os.makedirs(d, mode=0o700, exist_ok=True)
        with self.locked():
            self._load()

    @contextlib.contextmanager
    def locked(self):
        fd = os.open(self.path + ".lock", os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(fd)

    def _stat(self):
        try:
            st = os.stat(self.path)
        except FileNotFoundError:
            return None
        return (st.st_ino, st.st_size, st.st_mtime_ns)

    def _load(self):
        self.stamp = self._stat()
        games, history = [], {}
        if self.stamp is not None:
            try:
                with open(self.path, encoding="utf-8") as f:
                    raw = json.load(f)
                if not isinstance(raw, dict) or not isinstance(raw.get("games"), list):
                    raise ValueError("there is no game list in it")
                for g in raw["games"]:
                    if isinstance(g, dict) and all(isinstance(g.get(k), str) and g[k]
                                                   for k in ("id", "title", "path")):
                        games.append(g)
                if isinstance(raw.get("history"), dict):
                    history = {k: v for k, v in raw["history"].items() if isinstance(v, dict)}
            except (OSError, ValueError) as e:
                # Keep a copy and start over; the next save writes a fresh file.
                backup = "%s.broken-%d" % (self.path, time.time())
                with contextlib.suppress(OSError):
                    shutil.copy2(self.path, backup)
                self.warning = ("The library file could not be read (%s). A copy of it is in %s."
                                % (e, short_path(backup)))
                games = []
        self.games, self.history = games, history
        self.by_id = {g["id"]: g for g in games}

    def changed_on_disk(self):
        return self._stat() != self.stamp

    def reload(self):
        """Re-read the file if another process changed it. True when it did."""
        with self.locked():
            if not self.changed_on_disk():
                return False
            self._load()
            return True

    @contextlib.contextmanager
    def edit(self):
        with self.locked():
            if self.changed_on_disk():
                self._load()
            yield self
            self._save()

    def _save(self):
        tmp = "%s.%d.tmp" % (self.path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"version": 2, "games": self.games, "history": self.history}, f, indent=1,
                      ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.path)
        self.stamp = self._stat()

    def get(self, gid):
        return self.by_id.get(gid)

    REMEMBERED = ("playtime", "sessions", "last_played", "added")

    def add(self, game):
        """Inside edit(): add a game and return the stored copy. A game that was on the shelf
        before gets its play time, sessions and dates back from the history."""
        game = dict(game)
        game["id"] = uuid.uuid4().hex[:12]
        old = self.history.get(history_key(game))
        if old:
            for k in self.REMEMBERED:
                if old.get(k) and not game.get(k):
                    game[k] = old[k]
            old.pop("removed", None)
            old["back"] = int(time.time())
        game.setdefault("added", int(time.time()))
        self.games.append(game)
        self.by_id[game["id"]] = game
        return game

    def delete(self, gid):
        """Inside edit(). What the game was, how long it was played and when, stays in the history."""
        g = self.by_id.pop(gid, None)
        if g is not None:
            self.games.remove(g)
            entry = {k: g[k] for k in ("title", "path", "archive") + self.REMEMBERED if g.get(k)}
            entry["removed"] = int(time.time())
            self.history[history_key(g)] = entry
        return g

    def change(self, gid, fn):
        with self.edit():
            g = self.get(gid)
            if g is not None:
                fn(g)
            return g

    def update(self, gid, **fields):
        return self.change(gid, lambda g: g.update(fields))

    def find(self, name):
        """For the command line: exact title, then id, then a unique prefix or substring."""
        key = name.casefold().strip()
        for test in (lambda g: g["title"].casefold() == key, lambda g: g["id"] == name,
                     lambda g: g["title"].casefold().startswith(key),
                     lambda g: key in g["title"].casefold()):
            hits = [g for g in self.games if test(g)]
            if hits:
                return hits
        return []


def history_key(g):
    """Archive games are known by their archive.org item, everything else by its folder."""
    return "archive:" + g["archive"] if g.get("archive") else "dir:" + game_dir(g["path"])


def book_run(g, start, end, started, rc, error=None, approx=False):
    """Record one finished run in the game's entry (call it inside Library.change)."""
    secs = max(0, int(end - start))
    g["session"] = None
    g["last_exit"] = {"code": rc, "seconds": secs, "at": int(end), "approx": approx}
    if not started:
        g["last_error"] = error or "gom exited with code %s before the game started" % rc
        return
    g["playtime"] = int(g.get("playtime") or 0) + secs
    g["sessions"] = int(g.get("sessions") or 0) + 1
    stopped = rc is None or rc <= 0 or rc in (130, 143)
    g["last_error"] = (None if stopped or secs >= QUICK_EXIT else
                       "The game quit after %d s with exit code %d. The game log may say why." % (secs, rc))


class Settings(dict):
    DEFAULTS = {"tab": "all", "sort": "name", "zoom": 200, "details": True, "online": True,
                "width": 1260, "height": 860, "maximized": False, "view": "library",
                "archive_tab": "all", "archive_sort": "popular", "games_dir": "~/Games"}

    def __init__(self, path=SETTINGS):
        super().__init__(self.DEFAULTS)
        self.path = path
        try:
            with open(path, encoding="utf-8") as f:
                raw = json.load(f)
            for k, v in raw.items():
                if k in self.DEFAULTS and type(v) is type(self.DEFAULTS[k]):
                    self[k] = v
        except (OSError, ValueError, AttributeError):
            pass
        if self["zoom"] not in ZOOMS:
            self["zoom"] = 200
        if self["tab"] not in dict(TABS):
            self["tab"] = "all"
        if self["sort"] not in dict(SORTS):
            self["sort"] = "name"
        if self["view"] not in ("library", "archive"):
            self["view"] = "library"

    def save(self):
        with contextlib.suppress(OSError):
            tmp = self.path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(dict(self), f, indent=1)
            os.replace(tmp, self.path)


# ------------------------------------------------------------------ covers

NET_ERRORS = (OSError, http.client.HTTPException)      # URLError and HTTPError are OSErrors
DATA_ERRORS = (ValueError, KeyError, TypeError, AttributeError)


def sniff_image(path):
    """Format by magic bytes. Files from the internet are decoded only if they are one of these."""
    try:
        with open(path, "rb") as f:
            head = f.read(16)
    except OSError:
        return None
    if head[:3] == b"\xff\xd8\xff":
        return "jpeg"
    if head[:8] == b"\x89PNG\r\n\x1a\n":
        return "png"
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "webp"
    return None


def image_size(path):
    """(width, height) read from the header only, or None if it is no image GdkPixbuf knows."""
    fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(path)
    return (w, h) if fmt is not None and w > 0 and h > 0 else None


def checked_image(path, untrusted):
    if untrusted and sniff_image(path) is None:
        raise ValueError("not a JPEG, PNG or WebP image")
    size = image_size(path)
    if not size:
        raise ValueError("not an image shelf can read")
    if size[0] * size[1] > MAX_PIXELS:
        raise ValueError("the image is too large (%dx%d)" % size)
    return size


def fit_cover(pb, cw, ch):
    """A new cw x ch pixbuf: box art is cropped to fit, wide pictures (store headers,
    screenshots, logos) are letterboxed on black. Transparency is flattened onto black."""
    w, h = pb.get_width(), pb.get_height()
    out = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, cw, ch)
    out.fill(0x000000ff)
    s = cw / w if w / h > 0.9 else max(cw / w, ch / h)
    ox, oy = (cw - w * s) / 2, (ch - h * s) / 2
    dx, dy = max(0, round(ox)), max(0, round(oy))
    dw, dh = min(cw - dx, round(w * s)), min(ch - dy, round(h * s))
    pb.composite(out, dx, dy, dw, dh, ox, oy, s, s,
                 GdkPixbuf.InterpType.HYPER if s < 1 else GdkPixbuf.InterpType.BILINEAR, 255)
    return out


def import_cover(src, gid, untrusted=False):
    """Store an image as a COVER_W x COVER_H JPEG and return its file name. Box art is cropped
    to 2:3; wide pictures (store headers, screenshots, icons) are letterboxed on black."""
    checked_image(src, untrusted)
    pb = GdkPixbuf.Pixbuf.new_from_file(src)
    out = fit_cover(pb.apply_embedded_orientation() or pb, COVER_W, COVER_H)
    name = "%s-%d.jpg" % (gid, time.time() * 1000)
    out.savev(os.path.join(COVERS, name), "jpeg", ["quality"], ["90"])
    return name


def load_thumb(path, w, h, untrusted=False):
    """Pixbuf scaled to fit w x h, or None."""
    try:
        checked_image(path, untrusted)
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, True)
    except (GLib.Error, ValueError):
        return None


def http_get(url, limit, want_image=False):
    if not url.startswith(("https://", "http://")):
        raise ValueError("not a web address")
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=20) as r:
        ctype = r.headers.get("Content-Type", "")
        if want_image and not ctype.startswith("image/"):
            raise ValueError("the server did not send an image (%s)" % (ctype or "no type"))
        data = r.read(limit + 1)
    if len(data) > limit:
        raise ValueError("the download is larger than %s" % fmt_size(limit))
    return data


def download_image(url, folder=COVERS):
    """Fetch an image into a temp file in FOLDER. The caller deletes it."""
    data = http_get(url, MAX_DOWNLOAD, want_image=True)
    fd, tmp = tempfile.mkstemp(prefix=".dl-", dir=folder)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    if sniff_image(tmp) is None:
        os.unlink(tmp)
        raise ValueError("not a JPEG, PNG or WebP image")
    return tmp


def steam_search(term):
    q = urllib.parse.urlencode({"term": term, "cc": "us", "l": "english"})
    data = json.loads(http_get("https://store.steampowered.com/api/storesearch/?" + q, 2 << 20))
    return [(i["name"], int(i["id"])) for i in data.get("items") or []
            if isinstance(i, dict) and i.get("name") and str(i.get("id", "")).isdigit()]


def steam_art(appid):
    base = "https://cdn.cloudflare.steamstatic.com/steam/apps/%d/" % appid
    return [base + "library_600x900_2x.jpg", base + "library_600x900.jpg", base + "header.jpg"]


def wiki_search(term, limit=3):
    q = urllib.parse.urlencode({
        "action": "query", "format": "json", "generator": "search", "gsrlimit": limit,
        "gsrsearch": term + " video game", "prop": "pageimages", "piprop": "original",
        "pilicense": "any"})
    pages = json.loads(http_get("https://en.wikipedia.org/w/api.php?" + q, 2 << 20))
    pages = (pages.get("query") or {}).get("pages") or {}
    out = []
    for p in sorted(pages.values(), key=lambda p: p.get("index", 99)):
        src = (p.get("original") or {}).get("source", "")
        if src and not src.lower().endswith((".svg", ".gif")):
            out.append((re.sub(r"\s*\(.*\)$", "", p.get("title", "")), src))
    return out


def norm(text):
    t = re.sub(r"[^a-z0-9 ]", " ", text.lower().replace("&", " and "))
    t = re.sub(r"\b(the|a|an)\b", " ", t)
    return re.sub(r"\s+", " ", t).strip()


ROMAN = {"ii": "2", "iii": "3", "iv": "4", "v": "5", "vi": "6", "vii": "7", "viii": "8",
         "ix": "9", "x": "10"}


def numbers(t):
    """Sequel numbers in a normalized title: 'quake iii arena' -> {'3'}."""
    return {ROMAN.get(w, w) for w in t.split() if w.isdigit() or w in ROMAN}


def similar(a, b):
    a, b = norm(a), norm(b)
    if not a or not b or numbers(a) != numbers(b):      # Postal 2 is not Postal
        return 0.0
    if a == b or a.replace(" ", "") == b.replace(" ", ""):
        return 1.0
    return difflib.SequenceMatcher(None, a, b).ratio()


def auto_cover(title):
    """The one-time lookup: only a confident title match counts. Returns (tmp_path, source,
    answered). answered is False when no service could be reached, so shelf tries again later."""
    answered = False
    try:
        hits = steam_search(title)
        answered = True
        best = max(hits, key=lambda h: similar(title, h[0]), default=None)
        if best and similar(title, best[0]) >= 0.88:
            for url in steam_art(best[1]):
                with contextlib.suppress(*NET_ERRORS, ValueError):
                    return download_image(url), "steam:%d %s" % (best[1], best[0]), True
    except (*NET_ERRORS, *DATA_ERRORS):
        pass
    try:
        pages = wiki_search(title)
        answered = True
        for name, url in pages:
            if similar(title, name) >= 0.85:
                with contextlib.suppress(*NET_ERRORS, ValueError):
                    return download_image(url), "wikipedia:" + name, True
    except (*NET_ERRORS, *DATA_ERRORS):
        pass
    return None, None, answered


ADULT_RE = re.compile(r"\b(adult|hentai|nsfw|18\+|porn|lewd|nude|erotic|sexy?)\b", re.I)


def cover_candidates(term, folder, emit, cancelled):
    """For the cover picker: every Steam and Wikipedia hit for TERM, one image each.
    emit(name, source, path) is called on the GTK thread as each one arrives."""
    errors = []
    try:
        for name, appid in [h for h in steam_search(term) if not ADULT_RE.search(h[0])][:10]:
            for url in steam_art(appid):
                if cancelled():
                    return errors
                try:
                    path = download_image(url, folder)
                except (*NET_ERRORS, ValueError):
                    continue
                GLib.idle_add(lambda n=name, p=path: emit(n, "Steam", p) and False)
                break
    except (*NET_ERRORS, *DATA_ERRORS) as e:
        errors.append("Steam: %s" % e)
    try:
        for name, url in wiki_search(term, 6):
            if cancelled():
                return errors
            try:
                path = download_image(url, folder)
            except (*NET_ERRORS, ValueError):
                continue
            GLib.idle_add(lambda n=name, p=path: emit(n, "Wikipedia", p) and False)
    except (*NET_ERRORS, *DATA_ERRORS) as e:
        errors.append("Wikipedia: %s" % e)
    return errors


class AutoCovers:
    """One background thread and one request at a time, to be polite to both services."""

    def __init__(self, done):
        self.done = done                # done(gid, tmp_path, source, answered) on the GTK thread
        self.jobs = queue.Queue()
        self.pending = set()
        threading.Thread(target=self._run, daemon=True).start()

    def want(self, gid, title):
        if gid not in self.pending:
            self.pending.add(gid)
            self.jobs.put((gid, title))

    def _run(self):
        while True:
            gid, title = self.jobs.get()
            try:
                res = auto_cover(title)
            except Exception:           # noqa: BLE001  the thread must survive anything
                res = (None, None, False)
            GLib.idle_add(self._finish, gid, res)

    def _finish(self, gid, res):
        self.pending.discard(gid)
        self.done(gid, *res)
        return False


def prune_covers(lib):
    """Delete covers no game uses and temp files from interrupted downloads (older than an
    hour, so a second shelf that is just importing a cover is left alone)."""
    used = {g.get("cover") for g in lib.games}
    old = time.time() - 3600
    with contextlib.suppress(OSError), os.scandir(COVERS) as it:
        for e in it:
            with contextlib.suppress(OSError):
                if e.stat(follow_symlinks=False).st_mtime > old or e.name in used:
                    continue
                if e.is_dir(follow_symlinks=False) and e.name.startswith(".search-"):
                    shutil.rmtree(e.path, ignore_errors=True)
                elif e.is_file(follow_symlinks=False):
                    os.unlink(e.path)


# ------------------------------------------------------------------ archive.org collection

ARCHIVE_COLLECTION = "native-linux-games-collection"
ARCHIVE_URL = "https://archive.org"
ARCHIVE_DIR = os.path.join(SHELF, "archive")
CATALOG = os.path.join(ARCHIVE_DIR, "catalog.json")
CATALOG_MAX_AGE = 86400
PAYLOAD_EXT = (".sh", ".run", ".tar.xz", ".txz", ".tar.gz", ".tgz", ".tar.zst", ".tar.bz2", ".tar",
               ".zip", ".7z")
IDENT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class Cancelled(Exception):
    pass


def ia_title(raw):
    """'Trine 2 (v2.01 build 425) [Linux, GOG, Archive]' -> ('Trine 2', 'v2.01 build 425', ['GOG', 'Archive'])"""
    tags = []
    for grp in re.findall(r"\[([^\]]*)\]", raw):
        tags += [t.strip() for t in grp.split(",") if t.strip() and t.strip().lower() != "linux"]
    m = re.match(r"\s*([^\[]*?)\s*(?:\(([^)]*)\))?\s*(?:\[|$)", raw)
    name = (m.group(1) if m else "") or raw
    version = (m.group(2) if m else "") or ""
    return name.strip(), version.strip(), tags


def fetch_catalog():
    q = urllib.parse.urlencode([("q", "collection:" + ARCHIVE_COLLECTION)] +
                               [("fl[]", f) for f in ("identifier", "title", "item_size", "downloads",
                                                      "publicdate")] +
                               [("rows", "10000"), ("output", "json")])
    data = json.loads(http_get(ARCHIVE_URL + "/advancedsearch.php?" + q, 32 << 20))
    items = []
    for d in data["response"]["docs"]:
        ident, raw = d.get("identifier"), d.get("title")
        if not isinstance(ident, str) or not IDENT_RE.match(ident):
            continue
        raw = raw if isinstance(raw, str) and raw.strip() else ident
        if raw.lstrip().startswith("["):         # "[How To] ..." guides, not games
            continue
        name, version, tags = ia_title(raw)
        items.append({"id": ident, "raw": raw, "title": name, "version": version, "tags": tags,
                      "size": int(d.get("item_size") or 0), "downloads": int(d.get("downloads") or 0),
                      "date": str(d.get("publicdate") or "")[:10]})
    return items


def load_catalog():
    try:
        with open(CATALOG, encoding="utf-8") as f:
            raw = json.load(f)
        return raw["items"], float(raw["fetched"])
    except (OSError, ValueError, KeyError, TypeError):
        return [], 0.0


def save_catalog(items):
    os.makedirs(ARCHIVE_DIR, mode=0o700, exist_ok=True)
    tmp = CATALOG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"fetched": time.time(), "items": items}, f)
    os.replace(tmp, CATALOG)


def ia_metadata(ident):
    return json.loads(http_get("%s/metadata/%s" % (ARCHIVE_URL, ident), 16 << 20))


def ia_file_url(ident, name):
    return "%s/download/%s/%s" % (ARCHIVE_URL, ident, urllib.parse.quote(name))


def payload_candidates(files):
    """Downloads that hold the game itself, biggest first. Screenshots, metadata and old
    versions (in old/ folders) are left out."""
    out = []
    for f in files:
        name = f.get("name") or ""
        low = name.lower()
        if f.get("source") != "original" or not low.endswith(PAYLOAD_EXT):
            continue
        if re.search(r"(^|/)(old|older|backup)/", low) or low.startswith("images/"):
            continue
        try:
            size = int(f.get("size") or 0)
        except ValueError:
            size = 0
        out.append({"name": name, "size": size, "md5": f.get("md5") or ""})
    out.sort(key=lambda f: -f["size"])
    return out


def pick_payload(cands):
    """The obvious main download, or None when the user should choose."""
    if len(cands) == 1 or (len(cands) > 1 and cands[0]["size"] > 5 * cands[1]["size"]):
        return cands[0]
    return None


def logo_file(files):
    for f in files:
        base = os.path.basename(f.get("name") or "").lower()
        if base.startswith("logo") and base.endswith((".jpg", ".jpeg", ".png", ".webp")):
            return f["name"]
    return None


def strip_html(text):
    text = re.sub(r"(?is)<(script|style)\b.*?</\1>", " ", text or "")
    text = re.sub(r"(?i)<br\s*/?>|</p>|</div>|</h\d>|</li>", "\n", text)
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    return re.sub(r"\n\s*\n+", "\n\n", text).strip()


def download(url, part, size, md5, progress, cancelled):
    """Fetch URL into PART, resuming a partial file, and check it against the md5 the archive
    publishes. progress(stage, done, total) is called from this thread."""
    lock = os.open(part + ".lock", os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock)
        raise ValueError("another shelf window is downloading this already") from None
    try:
        _download(url, part, size, md5, progress, cancelled)
    finally:
        os.close(lock)
        with contextlib.suppress(OSError):
            os.unlink(part + ".lock")


def _download(url, part, size, md5, progress, cancelled):
    h = hashlib.md5()
    have = os.path.getsize(part) if os.path.exists(part) else 0
    if size and have > size:
        os.unlink(part)
        have = 0
    if have:
        with open(part, "rb") as f:
            done = 0
            for buf in iter(lambda: f.read(4 << 20), b""):
                if cancelled():
                    raise Cancelled
                h.update(buf)
                done += len(buf)
                progress("checking", done, have)
    tries = 0
    while not size or have < size:
        headers = {"User-Agent": UA}
        if have:
            headers["Range"] = "bytes=%d-" % have
        progress("connect", have, size)
        try:
            # archive.org sends each download to one of its storage servers; one that stalls
            # gets 30 s of silence, then shelf reconnects and goes on where it stopped
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as r:
                if have and r.status != 206:        # the server ignored the range: start over
                    have, h = 0, hashlib.md5()
                with open(part, "ab" if have else "wb") as f:
                    while True:
                        if cancelled():
                            raise Cancelled
                        buf = r.read(1 << 20)
                        if not buf:
                            break
                        f.write(buf)
                        h.update(buf)
                        have += len(buf)
                        tries = 0
                        progress("download", have, size)
            if not size:
                break
        except urllib.error.HTTPError as e:
            if e.code < 500 and e.code != 429:
                raise ValueError("archive.org answered %d %s" % (e.code, e.reason)) from e
            tries += 1
            if tries > 5:
                raise
        except NET_ERRORS:
            tries += 1
            if tries > 5:
                raise
        if size and have >= size:
            break
        for _ in range(int(2 ** min(tries, 5) * 2)):  # 4 s, 8 s, ... between tries
            if cancelled():
                raise Cancelled
            time.sleep(0.5)
    if size and have != size:
        raise ValueError("the download stopped early (%s of %s); Install again to resume"
                         % (fmt_size(have), fmt_size(size)))
    if md5 and h.hexdigest() != md5.lower():
        os.unlink(part)
        raise ValueError("the download is damaged (md5 does not match) and was deleted; try again")


def yad_payload_size(path):
    """LinuxRuleZ! 'YAD Simple Installer' scripts end with a tar.zst of the game; its size is
    written near the top of the script. None if PATH is not one of them."""
    with open(path, "rb") as f:
        head = f.read(128 * 1024)
    if b"YAD Simple Installer" not in head:
        return None
    m = re.search(rb"\narcsz=(\d+)\s", head)
    return int(m.group(1)) if m else None


def extract_tar(stream, dest, cancelled):
    """Unpack a tar stream with Python's 'data' filter: no absolute paths, nothing outside
    DEST, no device files or setuid bits. Unsafe entries are skipped and counted."""
    skipped, real = 0, os.path.realpath(dest)
    with tarfile.open(fileobj=stream, mode="r|*") as t:
        for m in t:
            if cancelled():
                raise Cancelled
            if m.islnk():
                # a stream can't seek back to the linked file; copy the one already unpacked
                src = os.path.realpath(os.path.join(dest, m.linkname))
                dst = os.path.join(dest, m.name)
                if (src + os.sep).startswith(real + os.sep) and os.path.isfile(src) and \
                        (os.path.realpath(os.path.dirname(dst)) + os.sep).startswith(real + os.sep):
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(src, dst)
                else:
                    skipped += 1
                continue
            try:
                t.extract(m, dest, filter="data")
            except tarfile.FilterError:
                skipped += 1
    return skipped


def extract_zip(path, dest, prefixes, cancelled):
    """Unpack the files under the first of PREFIXES that exists ('' = everything). Works on
    GOG installers too: their zip is appended to a shell script."""
    skipped, count, links = 0, 0, []
    real = os.path.realpath(dest)
    with zipfile.ZipFile(path) as z:
        names = [i.filename for i in z.infolist() if not i.is_dir()]
        prefix = next((p for p in prefixes if any(n.startswith(p) for n in names)), None)
        if prefix is None:
            raise ValueError("no game folder in the archive (looked for %s)" % ", ".join(prefixes))
        for item in z.infolist():
            if cancelled():
                raise Cancelled
            if not item.filename.startswith(prefix) or item.filename == prefix:
                continue
            rel = item.filename[len(prefix):]
            parts = [p for p in rel.split("/") if p]
            if not parts or rel.startswith("/") or ".." in parts:
                skipped += 1
                continue
            target = os.path.join(dest, *parts)
            mode = item.external_attr >> 16
            if stat.S_ISLNK(mode):
                links.append((parts, z.read(item).decode("utf-8", "replace")))
                continue
            if item.is_dir():
                os.makedirs(target, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            if not os.path.realpath(os.path.dirname(target)).startswith(real):
                skipped += 1
                continue
            with z.open(item) as src, open(target, "wb") as dst:
                shutil.copyfileobj(src, dst, 1 << 20)
            os.chmod(target, 0o755 if mode & 0o111 else 0o644)
            count += 1
    for parts, to in links:                      # links last, and only ones that stay inside
        resolved = os.path.normpath(os.path.join(os.path.dirname(os.path.join(dest, *parts)), to))
        if os.path.isabs(to) or not (resolved + os.sep).startswith(real + os.sep):
            skipped += 1
            continue
        link = os.path.join(dest, *parts)
        os.makedirs(os.path.dirname(link), exist_ok=True)
        with contextlib.suppress(FileExistsError):
            os.symlink(to, link)
    if count == 0:
        raise ValueError("the archive held no files")
    return skipped


def extract_7z(path, dest, cancelled):
    exe = shutil.which("7z") or shutil.which("7za")
    if not exe:
        raise ValueError("7z is not installed (Void: p7zip)")
    listing = subprocess.run([exe, "l", "-slt", "-ba", path], capture_output=True, text=True,
                             errors="replace", check=False)
    if listing.returncode != 0:
        raise ValueError("7z cannot read the archive: %s" % listing.stderr.strip()[-200:])
    for ln in listing.stdout.splitlines():
        if ln.startswith("Path = "):
            p = ln[7:]
            if p.startswith("/") or ".." in p.replace("\\", "/").split("/"):
                raise ValueError("the archive contains an unsafe path: %s" % p)
    proc = subprocess.Popen([exe, "x", "-y", "-o" + dest, path], stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, text=True, errors="replace")
    while proc.poll() is None:
        if cancelled():
            proc.kill()
            proc.wait()
            raise Cancelled
        time.sleep(0.2)
    if proc.returncode != 0:
        raise ValueError("7z failed: %s" % proc.stderr.read().strip()[-200:])
    skipped, real = 0, os.path.realpath(dest)
    for root, dirs, files in os.walk(dest):
        for n in dirs + files:
            p = os.path.join(root, n)
            if os.path.islink(p) and not (os.path.realpath(p) + os.sep).startswith(real + os.sep):
                os.unlink(p)
                skipped += 1
    return skipped


def unpack(path, dest, cancelled):
    """Unpack a download into DEST without running anything from it. Returns (kind, skipped);
    kind 'installer' means it could not be unpacked and was kept as a script for gom."""
    low = path.lower()
    if low.endswith((".sh", ".run")):
        arcsz = yad_payload_size(path)
        if arcsz:
            with open(path, "rb", buffering=0) as f:     # unbuffered: zstd reads the fd's offset
                f.seek(os.path.getsize(path) - arcsz)
                magic = f.read(4)
                f.seek(os.path.getsize(path) - arcsz)
                if magic == b"\x28\xb5\x2f\xfd":     # zstd: Python's tarfile can't do it everywhere
                    if not shutil.which("zstd"):
                        raise ValueError("zstd is not installed")
                    z = subprocess.Popen(["zstd", "-dcq"], stdin=f, stdout=subprocess.PIPE)
                    try:
                        return "yad", extract_tar(z.stdout, dest, cancelled)
                    finally:
                        z.kill()
                        z.wait()
                return "yad", extract_tar(f, dest, cancelled)
        if zipfile.is_zipfile(path):
            return "gog", extract_zip(path, dest, ("data/noarch/game/", "data/noarch/"), cancelled)
        shutil.copy2(path, os.path.join(dest, os.path.basename(path)))
        os.chmod(os.path.join(dest, os.path.basename(path)), 0o755)
        return "installer", 0
    if low.endswith(".zip"):
        return "zip", extract_zip(path, dest, ("",), cancelled)
    if low.endswith(".7z"):
        return "7z", extract_7z(path, dest, cancelled)
    if low.endswith(".tar.zst"):
        with open(path, "rb") as f:
            z = subprocess.Popen(["zstd", "-dcq"], stdin=f, stdout=subprocess.PIPE)
            try:
                return "tar", extract_tar(z.stdout, dest, cancelled)
            finally:
                z.kill()
                z.wait()
    with open(path, "rb") as f:
        return "tar", extract_tar(f, dest, cancelled)


def flatten(dest):
    """An archive that holds one folder (ULTRAKILL/...) gets that folder's contents moved up."""
    entries = os.listdir(dest)
    if len(entries) == 1 and os.path.isdir(os.path.join(dest, entries[0])) \
            and not os.path.islink(os.path.join(dest, entries[0])):
        inner = os.path.join(dest, ".flatten-tmp")
        os.rename(os.path.join(dest, entries[0]), inner)
        for n in os.listdir(inner):
            os.rename(os.path.join(inner, n), os.path.join(dest, n))
        os.rmdir(inner)


def folder_name(title, games_dir):
    base = re.sub(r"[/\x00-\x1f]", " ", title).replace(":", " -")
    base = re.sub(r"\s+", " ", base).strip(" .-") or "game"
    name, n = base, 2
    while os.path.lexists(os.path.join(games_dir, name)) or \
            os.path.lexists(os.path.join(games_dir, "." + name + ".partial")):
        name = "%s (%d)" % (base, n)
        n += 1
    return name


def install_archive_item(item, payload, games_dir, gom, progress, cancelled):
    """Download PAYLOAD of archive ITEM and unpack it into GAMES_DIR/<title>. Runs on a worker
    thread; nothing from the download is executed. Returns (game path, kind, note)."""
    os.makedirs(games_dir, exist_ok=True)
    need = payload["size"] * (1 if payload["name"].lower().endswith((".sh", ".run")) else 2) + (64 << 20)
    free = shutil.disk_usage(games_dir).free
    downloads = os.path.join(games_dir, ".downloads", item["id"])
    os.makedirs(downloads, exist_ok=True)
    part = os.path.join(downloads, os.path.basename(payload["name"]))
    have = os.path.getsize(part) if os.path.exists(part) else 0
    if free + have < need:
        raise ValueError("not enough disk space in %s: %s free, about %s needed"
                         % (short_path(games_dir), fmt_size(free), fmt_size(need - have)))
    download(ia_file_url(item["id"], payload["name"]), part, payload["size"], payload["md5"],
             progress, cancelled)
    name = folder_name(item["title"], games_dir)
    stage = os.path.join(games_dir, "." + name + ".partial")
    os.makedirs(stage)
    try:
        progress("unpack", 0, 0)
        kind, skipped = unpack(part, stage, cancelled)
        flatten(stage)
        final = os.path.join(games_dir, name)
        os.rename(stage, final)
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    shutil.rmtree(downloads, ignore_errors=True)
    with contextlib.suppress(OSError):
        os.rmdir(os.path.join(games_dir, ".downloads"))
    note = "%d unsafe entr%s skipped" % (skipped, "y" if skipped == 1 else "ies") if skipped else ""
    if kind == "installer":
        return os.path.join(final, os.path.basename(part)), kind, note
    hit = find_game(gom, final)
    return (hit[0] if hit else final), kind, note


# ------------------------------------------------------------------ icon ("Held Light", see art/)

# The same algorithm as art/shelf-icon.html, with the same generator, so a seed picked there
# draws the identical icon here.
ICON = {"seed": 2611, "spines": 6, "heightVar": 0.2, "wave": 0.55, "lean": 0.5, "glow": 0.6}
ICON_RAMP = ((0x50, 0x50, 0x50), (0x68, 0x68, 0x68), (0x80, 0x80, 0x80), (0x90, 0x90, 0x90))
ICON_LEFT, ICON_RIGHT, ICON_BASE, ICON_GAP = 0.17, 0.83, 0.79, 0.022


def mulberry32(a):
    a &= 0xFFFFFFFF

    def rnd():
        nonlocal a
        a = (a + 0x6D2B79F5) & 0xFFFFFFFF
        t = ((a ^ (a >> 15)) * (1 | a)) & 0xFFFFFFFF
        t = ((t + (((t ^ (t >> 7)) * (61 | t)) & 0xFFFFFFFF)) & 0xFFFFFFFF) ^ t
        return ((t ^ (t >> 14)) & 0xFFFFFFFF) / 4294967296
    return rnd


def make_shelf(p):
    """The icon's geometry in unit coordinates: a list of spines (corner points, size, colour)."""
    import math
    rng = mulberry32(p["seed"])
    lattice = [rng() for _ in range(16)]

    def noise(x):
        i = math.floor(x)
        k = (1 - math.cos((x - i) * math.pi)) / 2
        return lattice[i % 16] * (1 - k) + lattice[(i + 1) % 16] * k
    n = p["spines"]
    raw = [0.7 + 0.6 * rng() for _ in range(n)]
    cidx = [math.floor(rng() * 4) for _ in range(n)]
    bright = math.floor(rng() * (n - 1))
    grain = [[rng(), rng(), rng()] for _ in range(n)]
    dfac = 0.35 + 0.9 * p["lean"]
    s = (ICON_RIGHT - ICON_LEFT - (n - 1) * ICON_GAP) / (sum(raw) + dfac * raw[n - 1])
    spines, x = [], ICON_LEFT
    for i in range(n - 1):
        w, h = raw[i] * s, 0.36 + p["heightVar"] * noise(i * p["wave"])
        spines.append({"pts": [(x, ICON_BASE), (x + w, ICON_BASE), (x + w, ICON_BASE - h), (x, ICON_BASE - h)],
                       "w": w, "h": h, "color": (0xE0,) * 3 if i == bright else ICON_RAMP[cidx[i]],
                       "grain": grain[i]})
        x += w + ICON_GAP
    # the leaner: its foot d right of the neighbour, tilted until its face meets the neighbour's top
    xn, hn = x - ICON_GAP, spines[n - 2]["h"]
    w = raw[n - 1] * s
    d = dfac * w
    px = xn + d
    th = math.atan(d / hn)
    h = max(0.36 + p["heightVar"] * noise((n - 1) * p["wave"]), hn / math.cos(th) * 1.04)
    u, r = (-math.sin(th), -math.cos(th)), (math.cos(th), -math.sin(th))
    pts = [(px, ICON_BASE), (px + r[0] * w, ICON_BASE + r[1] * w),
           (px + r[0] * w + u[0] * h, ICON_BASE + r[1] * w + u[1] * h), (px + u[0] * h, ICON_BASE + u[1] * h)]
    spines.append({"pts": pts, "w": w, "h": h, "color": (0xA0,) * 3, "grain": grain[n - 1], "th": th})
    return spines


def shelf_icon(size, p=ICON):
    """The icon as a GdkPixbuf of size x size pixels."""
    import cairo
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    c = cairo.Context(surf)
    S = float(size)
    c.set_source_rgb(0, 0, 0)
    c.paint()
    g = cairo.RadialGradient(S * 0.5, S * ICON_BASE, 0, S * 0.5, S * ICON_BASE, S * 0.48)
    g.add_color_stop_rgba(0, 1, 1, 1, 0.16 * p["glow"])
    g.add_color_stop_rgba(1, 1, 1, 1, 0)
    c.set_source(g)
    c.paint()
    for sp in make_shelf(p):
        q = [(x * S, y * S) for x, y in sp["pts"]]

        def poly(pts):
            c.move_to(*pts[0])
            for pt in pts[1:]:
                c.line_to(*pt)
            c.close_path()

        def at(fx, fy):
            return (q[0][0] + (q[1][0] - q[0][0]) * fx + (q[3][0] - q[0][0]) * fy,
                    q[0][1] + (q[1][1] - q[0][1]) * fx + (q[3][1] - q[0][1]) * fy)
        poly(q)
        c.set_source_rgb(*(v / 255 for v in sp["color"]))
        c.fill()
        c.save()
        poly(q)
        c.clip()

        def band(f0, f1, a):
            poly([at(0, f0), at(1, f0), at(1, f1), at(0, f1)])
            c.set_source_rgba(0, 0, 0, a)
            c.fill()
        band(0.76, 0.84, 0.38)
        if size >= 96:
            band(0.08, 0.10, 0.25)
            c.set_source_rgba(1, 1, 1, 0.06)
            c.set_line_width(max(1, S / 400))
            for gx in sp["grain"]:
                c.move_to(*at(0.15 + 0.7 * gx, 0.02))
                c.line_to(*at(0.15 + 0.7 * gx, 0.98))
                c.stroke()
        c.restore()
    c.set_source_rgb(0xC0 / 255, 0xC0 / 255, 0xC0 / 255)
    c.rectangle(S * (ICON_LEFT - 0.03), S * ICON_BASE, S * (ICON_RIGHT - ICON_LEFT + 0.06), max(1, S * 0.035))
    c.fill()
    surf.flush()
    return Gdk.pixbuf_get_from_surface(surf, 0, 0, size, size)


# ------------------------------------------------------------------ what a game needs from the system

def elf_needs(path):
    """(bits, needed sonames, rpath dirs) from an ELF file's headers, or None. Only reads the
    file; nothing in it runs."""
    import mmap
    try:
        with open(path, "rb") as f:
            if f.read(4) != b"\x7fELF":
                return None
            data = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)   # big .so files: no copy
    except (OSError, ValueError):
        return None
    try:
        return _elf_needs(data)
    finally:
        data.close()


def _elf_needs(data):
    import struct
    if data[4] not in (1, 2) or data[5] != 1:
        return None
    bits = 32 if data[4] == 1 else 64
    try:
        if bits == 64:
            phoff, phentsize, phnum = struct.unpack_from("<Q", data, 32)[0], *struct.unpack_from("<HH", data, 54)
            ph = lambda i: struct.unpack_from("<IIQQQQQQ", data, phoff + i * phentsize)   # noqa: E731
            dyn_fmt, dyn_size = "<qQ", 16
        else:
            phoff, phentsize, phnum = struct.unpack_from("<I", data, 28)[0], *struct.unpack_from("<HH", data, 42)
            ph = lambda i: struct.unpack_from("<IIIIIIII", data, phoff + i * phentsize)   # noqa: E731
            dyn_fmt, dyn_size = "<iI", 8
        loads, dyn = [], None
        for i in range(phnum):
            h = ph(i)
            if bits == 64:
                ptype, off, vaddr, filesz = h[0], h[2], h[3], h[5]
            else:
                ptype, off, vaddr, filesz = h[0], h[1], h[2], h[4]
            if ptype == 1:
                loads.append((vaddr, off, filesz))
            elif ptype == 2:
                dyn = (off, filesz)
        if dyn is None:
            return bits, [], [], None
        entries = []
        for o in range(dyn[0], dyn[0] + dyn[1], dyn_size):
            tag, val = struct.unpack_from(dyn_fmt, data, o)
            if tag == 0:
                break
            entries.append((tag, val))
        strtab = next((v for t, v in entries if t == 5), None)
        base = next((off + strtab - va for va, off, sz in loads if va <= strtab < va + sz), None)
        if base is None:
            return bits, [], [], None

        def string(i):
            end = data.find(b"\0", base + i)
            if end < 0:
                raise ValueError("unterminated string")
            return data[base + i:end].decode("utf-8", "replace")
        needed = [string(v) for t, v in entries if t == 1]
        rpath = [d for t, v in entries if t in (15, 29) for d in string(v).split(":") if d]
        soname = next((string(v) for t, v in entries if t == 14), None)
        return bits, needed, rpath, soname
    except (struct.error, ValueError, IndexError):
        return None


def host_libs():
    """soname -> set of word sizes the system's loader can find (from ldconfig's cache)."""
    out = {}
    try:
        r = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True, timeout=20, check=False)
    except (OSError, subprocess.TimeoutExpired):
        r = None
    for ln in (r.stdout.splitlines() if r else []):
        m = re.match(r"\s*(\S+) \(([^)]*)\)", ln)
        if m:
            out.setdefault(m.group(1), set()).add(64 if "64" in m.group(2) else 32)
    for d, bits in (("/usr/lib", 64), ("/usr/lib64", 64), ("/usr/lib32", 32)):
        with contextlib.suppress(OSError):
            for n in os.listdir(d):
                if ".so" in n:
                    out.setdefault(n, set()).add(bits)
    return out


# libraries the loader always finds, or that a game only asks for and copes without
ALWAYS_THERE = re.compile(r"^(libc|libm|libdl|libpthread|librt|libutil|ld-linux.*|linux-(gate|vdso))\.so")
VOID_PKG = {"libopenal.so.1": "libopenal", "libGLU.so.1": "glu", "libGL.so.1": "libGL", "libGLX.so.0": "libglvnd",
            "libEGL.so.1": "libEGL", "libvulkan.so.1": "vulkan-loader", "libasound.so.2": "alsa-lib",
            "libpulse.so.0": "libpulseaudio", "libSDL2-2.0.so.0": "SDL2", "libSDL-1.2.so.0": "SDL",
            "libcurl.so.4": "libcurl", "libgtk-x11-2.0.so.0": "gtk+", "libgdk-x11-2.0.so.0": "gtk+",
            "libgtk-3.so.0": "gtk+3", "libstdc++.so.6": "libstdc++", "libgcc_s.so.1": "libgcc",
            "libX11.so.6": "libX11", "libXext.so.6": "libXext", "libXrandr.so.2": "libXrandr",
            "libXcursor.so.1": "libXcursor", "libXi.so.6": "libXi", "libXinerama.so.1": "libXinerama",
            "libXxf86vm.so.1": "libXxf86vm", "libvorbisfile.so.3": "libvorbis", "libvorbis.so.0": "libvorbis",
            "libogg.so.0": "libogg", "libpng16.so.16": "libpng", "libz.so.1": "zlib",
            "libfreetype.so.6": "freetype", "libssl.so.3": "openssl", "libcrypto.so.3": "openssl",
            "libudev.so.1": "libudev", "libdbus-1.so.3": "dbus-libs", "libxcb.so.1": "libxcb"}


def elf_bits(path):
    try:
        with open(path, "rb") as f:
            head = f.read(5)
    except OSError:
        return None
    return {1: 32, 2: 64}.get(head[4]) if head[:4] == b"\x7fELF" and len(head) == 5 else None


def missing_libs(folder, limit=400):
    """Libraries the game's programs need that neither the game folder nor the system has.
    Follows what the loader would: from each program through the libraries it pulls in, matched
    by soname, so installer leftovers and optional plugins don't count. Runs nothing.
    Returns {(soname, bits): [program, ...]}."""
    bundled, programs, count = {}, [], 0
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if not d.startswith(".")]      # .mojosetup and friends
        for n in files:
            p = os.path.join(root, n)
            is_lib = ".so" in n
            if not (is_lib or os.access(p, os.X_OK)) or elf_bits(p) is None or count >= limit:
                continue
            count += 1
            info = elf_needs(p)
            if not info:
                continue
            if is_lib:
                for name in {n, info[3]} - {None}:
                    bundled.setdefault((name, info[0]), (p, info))
            else:
                programs.append((p, info))
    host, missing, seen = host_libs(), {}, set()
    todo = list(programs)
    while todo:
        p, (bits, needed, _rpath, _so) = todo.pop()
        if p in seen:
            continue
        seen.add(p)
        for lib in needed:
            if ALWAYS_THERE.match(lib):
                continue
            mine = bundled.get((lib, bits))
            if mine:
                todo.append(mine)
            elif bits not in host.get(lib, ()):
                missing.setdefault((lib, bits), []).append(os.path.relpath(p, folder))
    return missing


def os_release():
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(path, encoding="utf-8") as f:
                return {k: v.strip().strip('"') for k, _, v in (ln.partition("=") for ln in f) if v}
        except OSError:
            continue
    return {}


FAMILIES = {"void": "void", "debian": "debian", "ubuntu": "debian", "linuxmint": "debian", "pop": "debian",
            "arch": "arch", "manjaro": "arch", "endeavouros": "arch", "fedora": "fedora", "rhel": "fedora",
            "centos": "fedora", "rocky": "fedora", "almalinux": "fedora", "opensuse": "opensuse",
            "suse": "opensuse", "opensuse-tumbleweed": "opensuse", "opensuse-leap": "opensuse",
            "gentoo": "gentoo"}
FAMILY_TOOLS = (("xbps-install", "void"), ("apt-get", "debian"), ("pacman", "arch"), ("dnf", "fedora"),
                ("zypper", "opensuse"), ("emerge", "gentoo"))


def distro():
    """(family, pretty name): which package manager the install command is written for."""
    rel = os_release()
    for i in [rel.get("ID", "")] + rel.get("ID_LIKE", "").split():
        if i in FAMILIES:
            return FAMILIES[i], rel.get("PRETTY_NAME") or i
    for tool, fam in FAMILY_TOOLS:
        if shutil.which(tool):
            return fam, rel.get("PRETTY_NAME") or fam
    return None, rel.get("PRETTY_NAME") or "this system"


LIB64_DIRS = ("/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu", "/usr/lib64", "/usr/lib", "/lib64")
OWNER_CMDS = {"void": ["xbps-query", "-o"], "debian": ["dpkg", "-S"], "arch": ["pacman", "-Qqo"],
              "fedora": ["rpm", "-qf", "--qf", "%{NAME}\\n"], "opensuse": ["rpm", "-qf", "--qf", "%{NAME}\\n"],
              "gentoo": ["qfile", "-qC"]}


def lib_owner(family, lib):
    """The package that installed the 64-bit copy of LIB, asked from the package manager."""
    path = next((os.path.join(d, lib) for d in LIB64_DIRS
                 if os.path.exists(os.path.join(d, lib)) and elf_bits(os.path.join(d, lib)) == 64), None)
    if not path or family not in OWNER_CMDS:
        return None
    try:
        out = subprocess.run(OWNER_CMDS[family] + [path], capture_output=True, text=True, timeout=30,
                             check=False).stdout.strip().splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return None
    if not out:
        return None
    first = out[0]
    if family == "void":
        m = re.match(r"(\S+)-[^-\s]+_\d+:", first)
        return m.group(1) if m else None
    if family == "debian":
        return first.split(":")[0] or None
    return first.split()[0] or None


def package_for(family, name, bits):
    if bits == 64:
        return name
    return {"void": name + "-32bit", "debian": name + ":i386", "arch": "lib32-" + name,
            "fedora": name + ".i686", "opensuse": name + "-32bit",
            "gentoo": name + "[abi_x86_32]"}.get(family)


def install_hint(missing, family=None, owner=lib_owner, have=None):
    """The command that installs MISSING on this distribution, or None if shelf can't tell.
    32-bit games also get 32-bit libpulse: gom hands them sound through PulseAudio."""
    if family is None:
        family = distro()[0]
    if family is None:
        return None
    have = host_libs() if have is None else have
    wanted = sorted(missing)
    if any(bits == 32 for _lib, bits in wanted) and 32 not in have.get("libpulse.so.0", ()):
        wanted.append(("libpulse.so.0", 32))
    pkgs = []
    for lib, bits in wanted:
        base = owner(family, lib) or (VOID_PKG.get(lib) if family == "void" else None)
        name = package_for(family, base, bits) if base else None
        if name and name not in pkgs:
            pkgs.append(name)
    if not pkgs:
        return None
    root = "doas" if shutil.which("doas") else "sudo"
    words = " ".join(shlex.quote(p) for p in pkgs)
    if family == "debian" and any(p.endswith(":i386") for p in pkgs):
        return "%s dpkg --add-architecture i386 && %s apt update && %s apt install %s" % (root, root, root, words)
    return {"void": "%s xbps-install -S %s", "debian": "%s apt install %s",
            "arch": "%s pacman -S --needed %s", "fedora": "%s dnf install %s",
            "opensuse": "%s zypper install %s", "gentoo": "%s emerge --ask %s"}[family] % (root, words)


def describe_missing(missing):
    libs = ", ".join("%s (%d-bit)" % (lib, bits) for lib, bits in sorted(missing))
    return libs, install_hint(missing)


def diagnose_game_log(text):
    """A plain reason for the usual ways a game dies right after it starts, or None."""
    m = re.search(r"error while loading shared libraries: (\S+?):", text)
    if m:
        return "it needs %s, which is not installed on your system" % m.group(1)
    m = re.search(r"(?:^|: )(\S+): (?:command )?not found", text, re.M)
    if m:
        return "its start script runs '%s', which the sandbox does not have" % m.group(1)
    if re.search(r"No such file or directory", text) and re.search(r"ld-linux\.so\.2|ld-linux-x86-64", text):
        return "it is a %s program and the system lacks that loader" % ("32-bit" if "so.2" in text else "64-bit")
    if re.search(r"(cannot open display|Failed to open display|Can't open display)", text, re.I):
        return "it could not open the game window"
    if re.search(r"(GLX|OpenGL).*(not (found|supported)|failed)|Couldn't find matching GLX visual", text, re.I):
        return "OpenGL did not start; for a 32-bit game install mesa-dri-32bit"
    return None


# ------------------------------------------------------------------ widgets

def label(text="", cls=None, wrap=False, mono=False, selectable=False):
    w = Gtk.Label(label=text, xalign=0)
    if cls:
        for c in cls.split():
            w.get_style_context().add_class(c)
    if wrap:
        w.set_line_wrap(True)
        w.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if mono:
        w.get_style_context().add_class("d-mono")
    if selectable:
        w.set_selectable(True)
        w.set_can_focus(False)
    return w


def options_text(g):
    parts = ["windowed" if g.get("windowed") else "fullscreen"]
    if g.get("res"):
        parts.append(g["res"])
    if g.get("grab"):
        parts.append("mouse locked")
    if g.get("mute"):
        parts.append("no sound")
    if g.get("gamescope"):
        parts.append("gamescope " + g["gamescope"])
    return " · ".join(parts)


class Card(Gtk.FlowBoxChild):
    """One game in the grid. The cover is loaded later, in small batches (see Shelf.load_covers)."""

    def __init__(self, gid, width):
        super().__init__()
        self.gid = gid
        self.data = {}
        self.key = []
        self.cover_file = None              # None: nothing loaded yet; "": showing the title card
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER)
        self.art = Gtk.Stack()
        self.art.get_style_context().add_class("art")
        self.image = Gtk.Image()
        self.blank = Gtk.Box()
        self.blank.get_style_context().add_class("blank")
        ph = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12, valign=Gtk.Align.CENTER)
        self.ph_title = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.ph_title.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.ph_title.get_style_context().add_class("ph-title")
        self.ph_note = label("", "ph-note")
        self.ph_note.set_xalign(0.5)
        ph.pack_start(self.ph_title, False, False, 0)
        ph.pack_start(self.ph_note, False, False, 0)
        self.blank.set_center_widget(ph)
        self.loading = Gtk.Box()
        self.loading.get_style_context().add_class("blank")
        for name, w in (("image", self.image), ("blank", self.blank), ("loading", self.loading)):
            self.art.add_named(w, name)
        self.label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1,
                               hexpand=True, margin_top=9)
        self.label.get_style_context().add_class("title")
        self.meta = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1,
                              margin_top=2)
        self.meta.get_style_context().add_class("meta")
        box.pack_start(self.art, False, False, 0)
        box.pack_start(self.label, False, False, 0)
        box.pack_start(self.meta, False, False, 0)
        self.add(box)
        self.show_all()                     # a Stack only switches to children that are visible
        self.art.set_visible_child_name("loading")
        self.set_width(width)

    def set_width(self, w):
        self.w, self.h = w, int(w * 1.5)
        for c in (self.image, self.blank, self.loading):
            c.set_size_request(self.w, self.h)
        self.ph_title.set_max_width_chars(max(6, w // 15))
        if self.cover_file:
            self.cover_file = None          # reload at the new size

    def show_text(self, g, meta, meta_cls=None, note=""):
        self.data = g
        self.key = sort_key(g["title"])
        self.label.set_text(("★ " if g.get("favorite") else "") + g["title"])
        self.set_tooltip_text(short_path(g["path"]))
        self.meta.set_text(meta or " ")
        ctx = self.meta.get_style_context()
        for c in ("running", "bad"):
            (ctx.add_class if c == meta_cls else ctx.remove_class)(c)
        self.ph_title.set_text(g["title"])
        self.ph_note.set_text(note)

    def needs_cover(self):
        return self.cover_file != (self.data.get("cover") or "")

    def load_cover(self):
        name = self.data.get("cover") or ""
        surf = None
        if name:
            scale = self.get_scale_factor()
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    os.path.join(COVERS, name), self.w * scale, self.h * scale, False)
                surf = Gdk.cairo_surface_create_from_pixbuf(pb, scale, None)
            except GLib.Error:
                surf = None
        if surf:
            self.image.set_from_surface(surf)
            self.art.set_visible_child_name("image")
        else:
            self.art.set_visible_child_name("blank")
        self.cover_file = name


class DetailsPane(Gtk.ScrolledWindow):
    """Right-hand panel for the selected game: cover, play time, paths, saves, notes."""

    WIDTH = 330

    def __init__(self, actions):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.actions = actions              # name -> fn(gid, widget)
        self.gid = None
        self.set_size_request(self.WIDTH + 48, -1)
        self.set_propagate_natural_width(False)     # long paths wrap instead of widening the panel
        self.set_hexpand(False)                     # the Play button's hexpand must not leak up here
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("details")
        self.add(box)

        self.cover = Gtk.Image(halign=Gtk.Align.START)
        self.cover_file = None
        self.title = label("", "d-title", wrap=True)
        self.title.set_margin_top(14)
        btns = Gtk.Box(spacing=6, margin_top=12, margin_bottom=4)
        self.play = Gtk.Button(label="Play", hexpand=True)
        self.play.get_style_context().add_class("primary")
        self.play.connect("clicked", lambda b: self.act("stop" if b.get_label() == "Stop" else "play", b))
        edit = Gtk.Button(label="Edit")
        edit.connect("clicked", lambda b: self.act("edit", b))
        more = Gtk.Button(label="More")
        more.connect("clicked", lambda b: self.act("more", b))
        for b in (self.play, edit, more):
            btns.pack_start(b, b is self.play, b is self.play, 0)

        self.error = label("", "d-error", wrap=True, selectable=True)
        self.error.set_margin_top(10)
        self.error.set_no_show_all(True)
        self.state = label("", "d-line", wrap=True)

        self.played = label("", "d-line", wrap=True)
        self.last = label("", "d-line")
        self.added = label("", "d-dim")
        self.path = label("", "d-mono", wrap=True, selectable=True)
        self.size = label("", "d-dim")
        self.opts = label("", "d-dim", wrap=True)
        self.profile = label("", "d-line", wrap=True)
        self.tags = label("", "d-line", wrap=True)
        self.notes = label("", "d-line", wrap=True, selectable=True)
        self.tags_head = label("TAGS", "d-head")
        self.notes_head = label("NOTES", "d-head")
        for w in (self.tags_head, self.tags, self.notes_head, self.notes):
            w.set_no_show_all(True)

        saves = Gtk.Button(label="Open saves", halign=Gtk.Align.START, margin_top=4)
        saves.get_style_context().add_class("flat")
        saves.connect("clicked", lambda b: self.act("saves", b))
        log = Gtk.Button(label="Show log", halign=Gtk.Align.START, margin_top=4)
        log.get_style_context().add_class("flat")
        log.connect("clicked", lambda b: self.act("log", b))

        for w in (self.cover, self.title, btns, self.error, self.state,
                  label("PLAY TIME", "d-head"), self.played, self.last, self.added,
                  label("GAME", "d-head"), self.path, self.size, self.opts, log,
                  label("SAVES", "d-head"), self.profile, saves,
                  self.tags_head, self.tags, self.notes_head, self.notes):
            box.pack_start(w, False, False, 0)
        self.blank = label("Select a game to see its details.", "d-dim", wrap=True)
        self.blank.set_no_show_all(True)
        box.pack_start(self.blank, False, False, 0)
        self.inner = [c for c in box.get_children() if c is not self.blank]
        self.show_all()

    def act(self, name, widget):
        if self.gid:
            self.actions[name](self.gid, widget)

    def show_game(self, g, run, sizes):
        """run: None, ("ours", seconds), ("elsewhere", None); sizes: (game, profile) bytes or None."""
        if g is None:
            self.gid = None
            for w in self.inner:
                w.hide()
            self.blank.show()
            return
        self.blank.hide()
        for w in self.inner:
            if w not in (self.error, self.tags_head, self.tags, self.notes_head, self.notes):
                w.show()
        self.gid = g["id"]
        if self.cover_file != (g.get("cover") or ""):
            self.cover_file = g.get("cover") or ""
            scale = self.get_scale_factor()
            pb = None
            if self.cover_file:
                with contextlib.suppress(GLib.Error):
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                        os.path.join(COVERS, self.cover_file), self.WIDTH * scale, int(self.WIDTH * 1.5) * scale, True)
            if pb:
                self.cover.set_from_surface(Gdk.cairo_surface_create_from_pixbuf(pb, scale, None))
                self.cover.show()
            else:
                self.cover.clear()
                self.cover.hide()
        self.title.set_text(("★ " if g.get("favorite") else "") + g["title"])
        self.play.set_label("Stop" if run and run[0] == "ours" else "Play")
        self.play.set_sensitive(not (run and run[0] == "elsewhere"))
        if run and run[0] == "ours":
            self.state.set_text("Running for %s." % fmt_long_duration(run[1]))
        elif run:
            self.state.set_text("Running, started outside this window.")
        elif not os.path.exists(g["path"]):
            self.state.set_text("The game is not where shelf expects it. Edit it to point at the new place.")
        else:
            self.state.set_text("")
        self.state.set_visible(bool(self.state.get_text()))
        err = g.get("last_error")
        self.error.set_text("Last run: %s" % err if err else "")
        self.error.set_visible(bool(err))
        pt, n = int(g.get("playtime") or 0), int(g.get("sessions") or 0)
        self.played.set_text("%s in %d session%s" % (fmt_long_duration(pt), n, "" if n == 1 else "s")
                             if n else "No play time counted yet" if g.get("last_played") else "Not played yet")
        self.last.set_text("Last played %s" % fmt_when(g["last_played"]) if g.get("last_played") else "")
        self.last.set_visible(bool(g.get("last_played")))
        self.added.set_text("Added %s" % fmt_date(g["added"]) if g.get("added") else "")
        self.added.set_visible(bool(g.get("added")))
        self.path.set_text(short_path(g["path"]))
        game_size, prof_size = sizes
        self.size.set_text("Size %s" % fmt_size(game_size) if game_size is not None else "Size …")
        self.opts.set_text(options_text(g) + ("\nArguments: " + g["args"] if g.get("args") else "")
                           + ("\nEnvironment: " + " ".join(g["env"]) if g.get("env") else ""))
        prof = g.get("profile") or "?"
        self.profile.set_text("Profile %s · %s" % (prof, fmt_size(prof_size) if prof_size is not None else "…"))
        tags = ", ".join(g.get("tags") or [])
        notes = g.get("notes") or ""
        self.tags.set_text(tags)
        self.notes.set_text(notes)
        for w, on in ((self.tags_head, tags), (self.tags, tags), (self.notes_head, notes), (self.notes, notes)):
            w.set_visible(bool(on))


# ------------------------------------------------------------------ archive widgets

def webp_native():
    return any(f.get_name() == "webp" for f in GdkPixbuf.Pixbuf.get_formats())


def webp_to_png(data, max_pixels):
    """Many archive screenshots are WebP, which GdkPixbuf reads only with an extra loader.
    Pillow converts them in memory instead; None if it is missing or the picture is too big."""
    try:
        import io
        from PIL import Image
        Image.MAX_IMAGE_PIXELS = max_pixels
        with Image.open(io.BytesIO(data)) as im:
            if im.format != "WEBP" or im.width * im.height > max_pixels:
                return None
            out = io.BytesIO()
            im.convert("RGB").save(out, "PNG")
            return out.getvalue()
    except Exception:           # noqa: BLE001  ImportError, bombs, broken files: just no picture
        return None


def pixbuf_from_bytes(data, max_pixels=MAX_PIXELS):
    """Decode image bytes from the internet, refusing huge ones before any pixel is decoded."""
    if not data or (data[:3] != b"\xff\xd8\xff" and data[:8] != b"\x89PNG\r\n\x1a\n"
                    and not (data[:4] == b"RIFF" and data[8:12] == b"WEBP")):
        return None
    if data[:4] == b"RIFF" and not webp_native():
        data = webp_to_png(data, max_pixels)
        if data is None:
            return None
    loader = GdkPixbuf.PixbufLoader()
    too_big = []

    def prepared(_l, w, h):
        if w * h > max_pixels:
            too_big.append(True)
            loader.set_size(1, 1)
    loader.connect("size-prepared", prepared)
    try:
        loader.write(data)
        loader.close()
    except GLib.Error:
        return None
    return None if too_big else loader.get_pixbuf()


class ThumbLoader:
    """Archive pictures straight from the internet into memory, never to disk. The cards on
    screen go first; two downloads at a time."""

    def __init__(self, done):
        self.done = done                # done(ident, pixbuf or None) on the GTK thread
        self.todo = []
        self.cond = threading.Condition()
        self.asked = set()
        for _ in range(2):
            threading.Thread(target=self._run, daemon=True).start()

    def want(self, idents):
        """Put IDENTS (most wanted first) at the front of the line."""
        with self.cond:
            fresh = [i for i in idents if i not in self.asked]
            self.todo = fresh + [i for i in self.todo if i not in fresh]
            self.cond.notify_all()

    def _run(self):
        while True:
            with self.cond:
                while not self.todo:
                    self.cond.wait()
                ident = self.todo.pop(0)
                if ident in self.asked:
                    continue
                self.asked.add(ident)
            try:
                data = http_get("%s/services/img/%s" % (ARCHIVE_URL, ident), 2 << 20, want_image=True)
            except Exception:           # noqa: BLE001  one missing picture must not stop the rest
                data = None
            GLib.idle_add(self._finish, ident, data)

    def _finish(self, ident, data):
        self.done(ident, pixbuf_from_bytes(data))
        return False


class ArchiveCard(Card):
    """A game in the archive.org collection. Its picture lives only in memory."""

    def __init__(self, item, width):
        super().__init__(item["id"], width)
        self.item = item
        self.pixbuf = None

    def show_item(self, item, meta, meta_cls=None):
        self.item = item
        self.data = {"title": item["title"], "path": item["raw"]}
        self.key = sort_key(item["title"])
        self.label.set_text(item["title"])
        self.set_tooltip_text(item["raw"])
        self.meta.set_text(meta or " ")
        ctx = self.meta.get_style_context()
        for c in ("running", "bad"):
            (ctx.add_class if c == meta_cls else ctx.remove_class)(c)
        self.ph_title.set_text(item["title"])
        if self.art.get_visible_child_name() == "loading" and self.pixbuf is None:
            self.art.set_visible_child_name("blank")

    def needs_cover(self):
        return False

    def set_pixbuf(self, pb):
        self.pixbuf = pb
        self.redraw()

    def set_width(self, w):
        super().set_width(w)
        if getattr(self, "pixbuf", None) is not None:
            self.redraw()

    def redraw(self):
        if self.pixbuf is None:
            self.art.set_visible_child_name("blank")
            return
        scale = self.get_scale_factor()
        pb = fit_cover(self.pixbuf, self.w * scale, self.h * scale)
        self.image.set_from_surface(Gdk.cairo_surface_create_from_pixbuf(pb, scale, None))
        self.art.set_visible_child_name("image")


class ArchivePane(Gtk.ScrolledWindow):
    """Right-hand panel for an archive game: picture, size, what gets downloaded, Install."""

    WIDTH = DetailsPane.WIDTH

    def __init__(self, actions):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.actions = actions          # install(ident, payload), cancel(ident), library(ident), web(ident)
        self.item, self.payloads, self.logo_for = None, [], None
        self.set_size_request(self.WIDTH + 48, -1)
        self.set_propagate_natural_width(False)
        self.set_hexpand(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("details")
        self.add(box)
        self.cover = Gtk.Image(halign=Gtk.Align.START)
        self.title = label("", "d-title", wrap=True)
        self.title.set_margin_top(14)
        self.version = label("", "d-dim", wrap=True)
        self.facts = label("", "d-line", wrap=True)
        btns = Gtk.Box(spacing=6, margin_top=12, margin_bottom=4)
        self.go = Gtk.Button(label="Install", hexpand=True)
        self.go.get_style_context().add_class("primary")
        self.go.connect("clicked", lambda *_: self.on_go())
        web = Gtk.Button(label="archive.org")
        web.connect("clicked", lambda *_: self.item and self.actions["web"](self.item["id"]))
        btns.pack_start(self.go, True, True, 0)
        btns.pack_start(web, False, False, 0)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.progress.set_no_show_all(True)
        self.state = label("", "d-line", wrap=True, selectable=True)
        self.files_head = label("DOWNLOAD", "d-head")
        self.files = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.where = label("", "d-dim", wrap=True)
        self.desc_head = label("ABOUT", "d-head")
        self.desc = label("", "d-dim", wrap=True, selectable=True)
        self.shots_head = label("SCREENSHOTS", "d-head")
        self.shots = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for w in (self.cover, self.title, self.version, self.facts, btns, self.progress, self.state,
                  self.files_head, self.files, self.where, self.shots_head, self.shots,
                  self.desc_head, self.desc):
            box.pack_start(w, False, False, 0)
        self.blank = label("Select a game to see what it is and to install it.", "d-dim", wrap=True)
        box.pack_start(self.blank, False, False, 0)
        self.box = box
        self.show_all()
        self.show_none()

    def show_none(self):
        self.item = None
        for w in self.box.get_children():
            w.set_visible(w is self.blank)

    def on_go(self):
        if not self.item:
            return
        label_ = self.go.get_label()
        if label_ == "Cancel":
            self.actions["cancel"](self.item["id"])
        elif label_ == "Open in library":
            self.actions["library"](self.item["id"])
        else:
            chosen = next((p for rb, p in self.payloads if rb.get_active()), None)
            self.actions["install"](self.item["id"], chosen)

    def payload_toggled(self):
        chosen = next((p for rb, p in self.payloads if rb.get_active()), None)
        if chosen and self.go.get_label().startswith("Install"):
            self.go.set_label("Install · %s" % fmt_size(chosen["size"]))

    def clear_shots(self):
        self.shot_gen = getattr(self, "shot_gen", 0) + 1
        for c in self.shots.get_children():
            self.shots.remove(c)
        self.shots_head.hide()
        return self.shot_gen

    def add_shot(self, ident, pb, gen):
        if not self.item or ident != self.item["id"] or pb is None or gen != self.shot_gen:
            return
        scale = self.get_scale_factor()
        w = self.WIDTH * scale
        h = max(1, round(pb.get_height() * w / pb.get_width()))
        img = Gtk.Image.new_from_surface(Gdk.cairo_surface_create_from_pixbuf(
            pb.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR), scale, None))
        img.set_halign(Gtk.Align.START)
        self.shots.pack_start(img, False, False, 0)
        img.show()
        self.shots_head.show()

    def set_logo(self, ident, pb):
        if not self.item or ident != self.item["id"]:
            return
        self.logo_for = ident
        if pb is None:
            self.cover.hide()
            return
        scale = self.get_scale_factor()
        w = self.WIDTH * scale
        h = max(1, round(pb.get_height() * w / pb.get_width()))
        if h > w * 1.6:
            h = int(w * 1.6)
            w = max(1, round(pb.get_width() * h / pb.get_height()))
        small = pb.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
        self.cover.set_from_surface(Gdk.cairo_surface_create_from_pixbuf(small, scale, None))
        self.cover.show()

    def show_item(self, item, meta, job, installed, games_dir):
        """meta: None while loading, else {"payloads": [...], "description": str, "error": str}."""
        new = self.item is None or item["id"] != self.item["id"]
        if self.item is None:
            for w in self.box.get_children():
                w.set_visible(w not in (self.blank, self.cover, self.progress))
        self.item = item
        if new:
            self.cover.clear()
            self.cover.hide()
            self.logo_for = None
            self.clear_shots()
        self.shots_head.set_visible(bool(self.shots.get_children()))
        self.title.set_text(item["title"])
        self.version.set_text(" · ".join(filter(None, [item["version"], ", ".join(item["tags"])])))
        self.facts.set_text("%s · downloaded %s times · added %s"
                            % (fmt_size(item["size"]), "{:,}".format(item["downloads"]), item["date"]))
        if new or not meta or len(self.payloads) != len(meta.get("payloads") or []):
            for c in self.files.get_children():
                self.files.remove(c)
            self.payloads = []
            group = None
            cands = (meta or {}).get("payloads") or []
            default = pick_payload(cands) or (cands[0] if cands else None)
            for p in cands:
                rb = Gtk.RadioButton.new_with_label_from_widget(
                    group, "%s  (%s)" % (os.path.basename(p["name"]), fmt_size(p["size"])))
                rb.get_child().set_line_wrap(True)
                rb.get_child().set_line_wrap_mode(Pango.WrapMode.CHAR)
                rb.set_active(p is default)
                rb.connect("toggled", lambda *_: self.payload_toggled())
                group = group or rb
                self.payloads.append((rb, p))
                self.files.pack_start(rb, False, False, 0)
            self.files.show_all()
        many = len(self.payloads) > 1
        self.files_head.set_visible(bool(self.payloads))
        self.files.set_visible(many)
        if self.payloads and not many:
            self.where.set_text("%s (%s), unpacked into %s/ without running anything from it."
                                % (os.path.basename(self.payloads[0][1]["name"]),
                                   fmt_size(self.payloads[0][1]["size"]), short_path(games_dir)))
        elif many:
            self.where.set_text("Pick one. It is unpacked into %s/ without running anything from it."
                                % short_path(games_dir))
        else:
            self.where.set_text("")
        desc = (meta or {}).get("description") or ""
        self.desc.set_text(desc[:1500] + ("…" if len(desc) > 1500 else ""))
        self.desc_head.set_visible(bool(desc))
        self.desc.set_visible(bool(desc))

        self.progress.hide()
        self.go.set_sensitive(True)
        if installed:
            self.go.set_label("Open in library")
            self.state.set_text("Installed.")
        elif job and job["stage"] in ("queued", "checking", "connect", "download", "unpack", "library"):
            self.go.set_label("Cancel")
            self.progress.show()
            if job["stage"] == "download" and job["total"]:
                frac = job["done"] / job["total"]
                self.progress.set_fraction(frac)
                eta = (job["total"] - job["done"]) / job["speed"] if job["speed"] > 0 else 0
                self.progress.set_text("%d%% · %s/s · %s left" % (frac * 100, fmt_size(job["speed"]),
                                                                  fmt_long_duration(eta)))
            elif job["stage"] == "checking" and job["total"]:
                self.progress.set_fraction(job["done"] / job["total"])
                self.progress.set_text("checking the part already downloaded")
            else:
                self.progress.pulse()
                self.progress.set_text({"queued": "waiting for the other downloads",
                                        "connect": "connecting to archive.org",
                                        "unpack": "unpacking", "library": "adding to the library",
                                        }.get(job["stage"], job["stage"]))
            self.state.set_text("")
        else:
            chosen = next((p for rb, p in self.payloads if rb.get_active()), None)
            self.go.set_label("Install · %s" % fmt_size(chosen["size"]) if chosen else "Install")
            self.go.set_sensitive(meta is not None and not meta.get("error") and bool(self.payloads))
            if meta is None:
                self.state.set_text("Reading the file list…")
            elif meta.get("error"):
                self.state.set_text("Could not read the file list: %s" % meta["error"])
            elif not self.payloads:
                self.state.set_text("This item has no game download shelf knows how to unpack.")
            elif job and job["stage"] == "failed":
                self.state.set_text("Last try failed: %s" % job["error"])
            elif job and job["stage"] == "cancelled":
                self.state.set_text("Stopped. Install again to continue where it stopped.")
            else:
                self.state.set_text("")
        self.state.set_visible(bool(self.state.get_text()))


# ------------------------------------------------------------------ dialogs

def dialog_buttons(d, ok_label, cancel_label="Cancel"):
    d.add_button(cancel_label, Gtk.ResponseType.CANCEL)
    ok = d.add_button(ok_label, Gtk.ResponseType.OK)
    ok.get_style_context().add_class("primary")
    ok.set_can_default(True)
    ok.grab_default()
    ok.get_parent().set_property("margin", 16)
    return ok


def message(parent, text, secondary=None, kind=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK):
    m = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=kind, buttons=buttons,
                          text=text, secondary_text=secondary)
    r = m.run()
    m.destroy()
    return r


def ask(parent, text, secondary=None):
    return message(parent, text, secondary, Gtk.MessageType.QUESTION,
                   Gtk.ButtonsType.YES_NO) == Gtk.ResponseType.YES


def pick_one(parent, title, note, options, ok_label="Use this one"):
    """Radio-button choice; returns the chosen option or None."""
    d = Gtk.Dialog(title=title, transient_for=parent, modal=True)
    dialog_buttons(d, ok_label)
    box = d.get_content_area()
    box.set_spacing(8)
    box.set_property("margin", 22)
    box.pack_start(label(title, "d-section"), False, False, 0)
    n = label(note, "hint", wrap=True)
    n.set_max_width_chars(64)
    box.pack_start(n, False, False, 6)
    group, buttons = None, []
    for o in options:
        rb = Gtk.RadioButton.new_with_label_from_widget(group, o)
        group = group or rb
        buttons.append((rb, o))
        box.pack_start(rb, False, False, 0)
    d.show_all()
    r = d.run()
    choice = next((o for rb, o in buttons if rb.get_active()), None)
    d.destroy()
    return choice if r == Gtk.ResponseType.OK else None


def choose_file(parent, title, action, start=None, images=False):
    d = Gtk.FileChooserDialog(title=title, transient_for=parent, action=action)
    d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.ACCEPT)
    if start:
        start = os.path.expanduser(start)
        d.set_current_folder(start if os.path.isdir(start) else os.path.dirname(start))
    if images:
        f = Gtk.FileFilter()
        f.set_name("Images")
        f.add_pixbuf_formats()
        d.add_filter(f)
    path = d.get_filename() if d.run() == Gtk.ResponseType.ACCEPT else None
    d.destroy()
    return path


def uri_to_path(uri):
    with contextlib.suppress(GLib.Error, TypeError):
        return GLib.filename_from_uri(uri)[0]
    return None


class CoverDialog(Gtk.Dialog):
    """Pick a cover from every Steam and Wikipedia hit, or from a file."""

    def __init__(self, parent, term, online):
        super().__init__(title="Choose a cover", transient_for=parent, modal=True)
        self.set_default_size(900, 680)
        self.ok = dialog_buttons(self, "Use this cover")
        self.ok.set_sensitive(False)
        self.add_button("From file…", 1)
        self.tmp = tempfile.mkdtemp(prefix=".search-", dir=COVERS)
        self.gen, self.closed, self.chosen = 0, False, None
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_property("margin", 18)
        row = Gtk.Box(spacing=8)
        self.term = Gtk.Entry(text=term, hexpand=True, activates_default=False)
        self.term.connect("activate", lambda *_: self.search())
        go = Gtk.Button(label="Search")
        go.connect("clicked", lambda *_: self.search())
        row.pack_start(self.term, True, True, 0)
        row.pack_start(go, False, False, 0)
        self.status = label("", "hint", wrap=True)
        self.flow = Gtk.FlowBox(valign=Gtk.Align.START, homogeneous=True, max_children_per_line=10,
                                selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False,
                                column_spacing=6, row_spacing=10)
        self.flow.connect("selected-children-changed",
                          lambda f: self.ok.set_sensitive(bool(f.get_selected_children())))
        self.flow.connect("child-activated", lambda *_: self.response(Gtk.ResponseType.OK))
        self.flow.set_sort_func(lambda a, b: (b.score > a.score) - (b.score < a.score))
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        sc.add(self.flow)
        box.pack_start(row, False, False, 0)
        box.pack_start(self.status, False, False, 0)
        box.pack_start(sc, True, True, 0)
        self.show_all()
        if online:
            self.search()
        else:
            self.status.set_text("Online lookups are turned off in the menu. Use “From file…”.")

    def search(self):
        term = self.term.get_text().strip()
        if not term:
            return
        self.gen += 1
        gen = self.gen
        for c in self.flow.get_children():
            self.flow.remove(c)
        self.status.set_text("Searching Steam and Wikipedia for “%s”…" % term)
        spawn(cover_candidates, lambda errs, exc: self.search_done(gen, errs, exc), term, self.tmp,
              lambda n, s, p: self.add_result(gen, n, s, p), lambda: gen != self.gen or self.closed)

    def search_done(self, gen, errors, exc):
        if gen != self.gen or self.closed:
            return
        n = len(self.flow.get_children())
        msg = "%d cover%s found. Double-click one to use it." % (n, "" if n == 1 else "s") if n else \
            "Nothing found. Try a shorter or different name, or pick a file."
        problems = list(errors or []) + ([str(exc)] if exc else [])
        self.status.set_text(msg + ("  (%s)" % "; ".join(problems) if problems else ""))

    def add_result(self, gen, name, source, path):
        pb = None if gen != self.gen or self.closed else load_thumb(path, 150, 225, untrusted=True)
        if pb is None:
            with contextlib.suppress(OSError):
                os.unlink(path)
            return
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=4)
        img = Gtk.Image.new_from_pixbuf(pb)
        img.set_size_request(150, 225)
        v.pack_start(img, False, False, 0)
        t = Gtk.Label(label=name, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, xalign=0)
        t.get_style_context().add_class("title")
        v.pack_start(t, False, False, 0)
        v.pack_start(label("%s · %dx%d" % ((source,) + (image_size(path) or (0, 0))), "meta"), False, False, 0)
        child = Gtk.FlowBoxChild()
        child.add(v)
        child.path = path
        child.score = similar(self.term.get_text(), name)
        self.flow.add(child)
        child.show_all()
        n = len(self.flow.get_children())
        self.status.set_text("%d found so far…" % n)

    def choose(self):
        """Returns (path, is_temp): a file to import (delete it afterwards if is_temp), or (None, False)."""
        result = (None, False)
        while True:
            r = self.run()
            if r == 1:
                p = choose_file(self, "Cover image", Gtk.FileChooserAction.OPEN, images=True)
                if p:
                    result = (p, False)
                    break
                continue
            if r == Gtk.ResponseType.OK:
                sel = self.flow.get_selected_children()
                if sel:
                    fd, keep = tempfile.mkstemp(prefix=".dl-", dir=COVERS)
                    os.close(fd)
                    shutil.copyfile(sel[0].path, keep)
                    result = (keep, True)
            break
        self.closed = True
        self.destroy()
        shutil.rmtree(self.tmp, ignore_errors=True)
        return result


class GameDialog(Gtk.Dialog):
    """Add or edit one game. After OK, self.game holds the fields and self.cover the image
    to import ((path, is_temp) or None); self.drop_cover asks to remove the current cover."""

    def __init__(self, parent, gom, online, game=None, path=None, taken=None):
        super().__init__(title="Edit game" if game else "Add game", transient_for=parent, modal=True)
        self.set_default_size(720, -1)
        dialog_buttons(self, "Save" if game else "Add")
        self.gom, self.online, self.taken = gom, online, taken or {}
        self.game = dict(game or {})
        self.cover, self.drop_cover = None, False
        self.check_id = 0

        grid = Gtk.Grid(column_spacing=14, row_spacing=10, margin=22)
        self.get_content_area().add(grid)
        e = lambda **kw: Gtk.Entry(activates_default=True, **kw)   # noqa: E731
        self.title = e(hexpand=True)
        self.path = e(hexpand=True, placeholder_text="game folder, program or .sh script")
        self.path.get_style_context().add_class("mono")
        self.path_hint = label("", "hint", wrap=True)
        self.profile = e()
        self.profile.get_style_context().add_class("mono")
        self.profile_hint = label("", "hint", wrap=True)
        self.res = e(placeholder_text="screen size", width_chars=11)
        self.windowed = Gtk.CheckButton(label="Windowed")
        self.grab = Gtk.CheckButton(label="Lock mouse")
        self.mute = Gtk.CheckButton(label="No sound")
        self.tags = e(placeholder_text="comma separated, e.g. fps, 2000s, co-op")
        self.notes = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=8, right_margin=8,
                                  top_margin=6, bottom_margin=6)
        self.notes.set_size_request(-1, 64)
        self.args = e(placeholder_text="passed to the game, e.g. -nosound -windowed")
        self.env = e(placeholder_text="NAME=VALUE ..., e.g. SDL_AUDIODRIVER=pulse")
        self.scope = e(placeholder_text="extra gamescope flags, e.g. -F fsr")
        for w in (self.args, self.env, self.scope):
            w.get_style_context().add_class("mono")

        comp = Gtk.EntryCompletion(inline_completion=True, popup_completion=True)
        store = Gtk.ListStore(str)
        for p in gom_profiles():
            store.append([p])
        comp.set_model(store)
        comp.set_text_column(0)
        self.profile.set_completion(comp)

        def lab(text, top=False):
            w = Gtk.Label(label=text, xalign=1, valign=Gtk.Align.START if top else Gtk.Align.CENTER)
            w.get_style_context().add_class("dlg-label")
            if top:
                w.set_margin_top(7)
            return w

        def btn(text, fn):
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda *_: fn())
            return b

        pathrow = Gtk.Box(spacing=6)
        pathrow.pack_start(self.path, True, True, 0)
        pathrow.pack_start(btn("File…", lambda: self.pick_path(Gtk.FileChooserAction.OPEN)), False, False, 0)
        pathrow.pack_start(btn("Folder…", lambda: self.pick_path(Gtk.FileChooserAction.SELECT_FOLDER)),
                           False, False, 0)
        opts = Gtk.Box(spacing=20)
        for w in (self.windowed, self.grab, self.mute):
            opts.pack_start(w, False, False, 0)
        resbox = Gtk.Box(spacing=8)
        resbox.pack_start(lab("Resolution"), False, False, 0)
        resbox.pack_start(self.res, False, False, 0)
        opts.pack_end(resbox, False, False, 0)
        notes_frame = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        notes_frame.add(self.notes)
        notes_frame.set_size_request(-1, 70)

        adv = Gtk.Grid(column_spacing=14, row_spacing=10, margin_top=10)
        for i, (t, w) in enumerate((("Arguments", self.args), ("Environment", self.env),
                                    ("Gamescope", self.scope))):
            adv.attach(lab(t), 0, i, 1, 1)
            adv.attach(w, 1, i, 1, 1)
            w.set_hexpand(True)
        self.advanced = Gtk.Expander(label="Advanced")
        self.advanced.add(adv)

        self.preview = Gtk.Image()
        pv = Gtk.EventBox()
        pv.get_style_context().add_class("blank")
        pv.add(self.preview)
        pv.set_size_request(120, 180)
        pv.drag_dest_set(Gtk.DestDefaults.ALL, [Gtk.TargetEntry.new("text/uri-list", 0, 0)],
                         Gdk.DragAction.COPY)
        pv.connect("drag-data-received", self.on_cover_drop)
        cb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, valign=Gtk.Align.END)
        cb.pack_start(label("Drop an image on the cover, or let\nshelf look one up online.", "hint"),
                      False, False, 0)
        for text, fn in (("Find online…", self.find_online), ("Choose file…", self.pick_cover),
                         ("Remove cover", self.clear_cover)):
            cb.pack_start(btn(text, fn), False, False, 0)
        crow = Gtk.Box(spacing=18)
        crow.pack_start(pv, False, False, 0)
        crow.pack_start(cb, False, False, 0)

        rows = (("Title", self.title, False), ("Game", pathrow, False), ("", self.path_hint, False),
                ("Profile", self.profile, False), ("", self.profile_hint, False),
                ("Options", opts, False), ("Tags", self.tags, False), ("Notes", notes_frame, True),
                ("", self.advanced, False), ("Cover", crow, True))
        for i, (t, w, top) in enumerate(rows):
            if t:
                grid.attach(lab(t, top), 0, i, 1, 1)
            grid.attach(w, 1, i, 1, 1)

        g = self.game
        self.title_touched = bool(g.get("title"))
        self.profile_touched = bool(g.get("profile"))
        self.path.set_text(g.get("path") or path or "")
        self.title.set_text(g.get("title") or (title_from_path(path) if path else ""))
        self.profile.set_text(g.get("profile") or (derive_profile(path) if path else ""))
        self.windowed.set_active(bool(g.get("windowed")))
        self.grab.set_active(bool(g.get("grab")))
        self.mute.set_active(bool(g.get("mute")))
        self.res.set_text(g.get("res") or "")
        self.tags.set_text(", ".join(g.get("tags") or []))
        self.notes.get_buffer().set_text(g.get("notes") or "")
        self.args.set_text(g.get("args") or "")
        self.env.set_text(" ".join(shlex.quote(kv) for kv in g.get("env") or []))
        self.scope.set_text(g.get("gamescope") or "")
        self.advanced.set_expanded(bool(g.get("args") or g.get("env") or g.get("gamescope")))
        self.path.connect("changed", self.on_path_changed)
        self.tid = self.title.connect("changed", lambda *_: setattr(self, "title_touched", True))
        self.pid = self.profile.connect("changed", self.on_profile_changed)
        self.connect("response", self.on_response)
        self.connect("destroy", lambda *_: self.forget_temp())
        self.show_cover()
        self.show_all()
        self.on_profile_changed(None)
        self.check_path()

    # -------------------------------------------------- live hints

    def on_path_changed(self, entry):
        p = entry.get_text().strip()
        if p:
            if not self.title_touched:
                with self.title.handler_block(self.tid):
                    self.title.set_text(title_from_path(p))
            if not self.profile_touched:
                with self.profile.handler_block(self.pid):
                    self.profile.set_text(derive_profile(p))
                self.on_profile_changed(None)
        if self.check_id:
            GLib.source_remove(self.check_id)
        self.check_id = GLib.timeout_add(350, self.check_path)

    def check_path(self):
        self.check_id = 0
        p = os.path.expanduser(self.path.get_text().strip())
        if not p:
            text = "A folder works when it holds one program or script; otherwise pick the file."
        elif not os.path.exists(p):
            text = "Nothing at this path."
        elif os.path.isfile(p):
            text = "Runs this file. An installer installs into the profile; shelf then offers the installed game."
        else:
            state, names = gom_launchers(self.gom, p)
            text = {"ok": "gom will start %s." % (names[0] if names else "?"),
                    "choose": "Several programs here (%s). shelf asks which one when you save."
                              % ", ".join(names[:4]),
                    "none": "gom finds nothing to start in this folder. Use File… to pick the program.",
                    }.get(state, "Could not ask gom about this folder.")
        self.path_hint.set_text(text)
        return False

    def on_profile_changed(self, _entry):
        if _entry is not None:
            self.profile_touched = True
        p = self.profile.get_text().strip()
        if p and not PROFILE_RE.match(p):
            text = "Use letters, digits and . _ - only."
        elif p:
            known = os.path.isdir(os.path.join(GOM_DATA, p))
            text = "Saves go to %s%s" % (short_path(os.path.join(GOM_DATA, p, "home")),
                                         " (this profile already exists)." if known else ".")
        else:
            text = "Leave empty to let gom name it after the folder."
        self.profile_hint.set_text(text)

    # -------------------------------------------------- cover

    def forget_temp(self):
        if self.cover and self.cover[1]:
            with contextlib.suppress(OSError):
                os.unlink(self.cover[0])
        self.cover = None

    def set_cover(self, path, is_temp):
        try:
            checked_image(path, untrusted=is_temp)
        except (ValueError, GLib.Error) as err:
            message(self, "That image can't be used.", str(err), Gtk.MessageType.ERROR)
            if is_temp:
                with contextlib.suppress(OSError):
                    os.unlink(path)
            return
        self.forget_temp()
        self.cover, self.drop_cover = (path, is_temp), False
        self.show_cover()

    def show_cover(self):
        src = self.cover[0] if self.cover else None
        if not src and not self.drop_cover and self.game.get("cover"):
            src = os.path.join(COVERS, self.game["cover"])
        pb = load_thumb(src, 120, 180) if src else None
        if pb:
            self.preview.set_from_pixbuf(pb)
        else:
            self.preview.clear()

    def find_online(self):
        term = self.title.get_text().strip() or title_from_path(self.path.get_text().strip() or "game")
        path, is_temp = CoverDialog(self, term, self.online).choose()
        if path:
            self.set_cover(path, is_temp)

    def pick_cover(self):
        p = choose_file(self, "Cover image", Gtk.FileChooserAction.OPEN, images=True)
        if p:
            self.set_cover(p, False)

    def clear_cover(self):
        self.forget_temp()
        self.drop_cover = True
        self.show_cover()

    def on_cover_drop(self, _w, _ctx, _x, _y, data, _info, _time):
        uris = data.get_uris() or []
        p = uri_to_path(uris[0]) if uris else None
        if p and os.path.isfile(p):
            self.set_cover(p, False)

    def pick_path(self, action):
        p = choose_file(self, "Game", action, start=self.path.get_text().strip() or HOME)
        if p:
            self.path.set_text(p)

    # -------------------------------------------------- save

    def fail(self, text):
        message(self, text, kind=Gtk.MessageType.ERROR)
        self.stop_emission_by_name("response")

    def on_response(self, _d, resp):
        if resp != Gtk.ResponseType.OK:
            return
        path = os.path.abspath(os.path.expanduser(self.path.get_text().strip())) \
            if self.path.get_text().strip() else ""
        profile = self.profile.get_text().strip()
        res = self.res.get_text().strip()
        if not path or not os.path.exists(path):
            return self.fail("Game not found: %s" % (path or "(empty)"))
        if profile and not PROFILE_RE.match(profile):
            return self.fail("Profile names use letters, digits and . _ - (64 at most).")
        if res and not RES_RE.match(res):
            return self.fail("Resolution must look like 1280x720.")
        try:
            shlex.split(self.args.get_text())
            env = parse_env(self.env.get_text())
        except ValueError as err:
            return self.fail("Advanced options: %s" % err)
        if os.path.isdir(path):
            state, names = gom_launchers(self.gom, path)
            if state == "none":
                return self.fail("gom finds nothing to start in this folder. "
                                 "Use File… and pick the game's program or .sh script.")
            if state == "choose":
                chosen = pick_one(self, "Which program starts the game?",
                                  "gom found several in %s. shelf remembers your choice." % short_path(path),
                                  names)
                if not chosen:
                    return self.stop_emission_by_name("response")
                path = os.path.join(path, chosen)
                self.path.set_text(path)
        dup = self.taken.get(game_dir(path))
        if dup and not self.game.get("id") and not ask(
                self, "This game is already on the shelf as “%s”." % dup, "Add it a second time?"):
            return self.stop_emission_by_name("response")
        buf = self.notes.get_buffer()
        self.game.update(
            title=self.title.get_text().strip() or title_from_path(path),
            path=path, profile=profile or derive_profile(path),
            windowed=self.windowed.get_active(), grab=self.grab.get_active(),
            mute=self.mute.get_active(), res=res, args=self.args.get_text().strip(), env=env,
            gamescope=self.scope.get_text().strip(), tags=parse_tags(self.tags.get_text()),
            notes=buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip())


def is_installer(path):
    """Launch scripts are small; self-extracting installers (GOG, makeself) are megabytes."""
    try:
        return path.lower().endswith((".sh", ".run")) and os.path.getsize(path) > 1 << 20
    except OSError:
        return False


def arch_rank(name):
    """64-bit builds before unmarked ones before 32-bit ones (drmfree.x86_64 over drmfree.i386)."""
    n = name.lower()
    if re.search(r"x86_64|amd64|x64|64", n):
        return 0
    return 2 if re.search(r"i[3-6]86|x86|32", n) else 1


def find_game(gom, folder, budget=20):
    """What to start for the game in FOLDER, looking deeper when it sits in a subfolder such
    as Dusk/game/. An installed game wins over the installer next to it. Returns (path, note)
    or None. budget caps the number of gom calls."""
    todo, fallback = [(folder, 0)], None
    while todo and budget > 0:
        cur, depth = todo.pop(0)
        budget -= 1
        state, names = gom_launchers(gom, cur)
        if state in ("ok", "choose") and all(is_installer(os.path.join(cur, n)) for n in names):
            if fallback is None:
                fallback = (os.path.join(cur, names[0]),
                            "installer; shelf offers the installed game after it ran")
            state = "none"
        if state == "ok":
            return cur, "starts %s" % names[0]
        if state == "choose":
            return cur, "several programs (%s); shelf asks on the first start" % ", ".join(names[:3])
        if depth < 2:
            try:
                subs = sorted((e for e in os.scandir(cur)
                               if not e.name.startswith(".") and e.is_dir(follow_symlinks=False)),
                              key=lambda e: (e.name.lower() not in GENERIC_DIRS, arch_rank(e.name), e.name.lower()))
            except OSError:
                subs = []
            todo += [(e.path, depth + 1) for e in subs[:12]]
    return fallback


def scan_games(gom, folder, taken, paths=None):
    """Candidates for the import dialog: one per subfolder (or loose .sh/.run installer) of
    FOLDER, plus games gom profiles remember that are not on the shelf yet. With PATHS
    (dropped on the window) only those are looked at."""
    found, seen, skipped, loose = [], set(taken), 0, 0

    def add(path, note, profile=None, title=None):
        nonlocal skipped
        key = game_dir(path)
        if key in seen:
            skipped += 1
            return
        seen.add(key)
        found.append({"title": title or title_from_path(path), "path": path,
                      "profile": profile or derive_profile(path), "note": note})

    if paths:
        entries = [os.path.abspath(p) for p in paths]
    elif folder and os.path.isdir(folder):
        try:
            entries = sorted((e.path for e in os.scandir(folder) if not e.name.startswith(".")),
                             key=lambda p: os.path.basename(p).lower())
        except OSError:
            entries = []
    else:
        entries = []
    for path in entries:
        if any(t == path or t.startswith(path + os.sep) for t in taken):
            skipped += 1
            continue
        if os.path.isdir(path) and not os.path.islink(path):
            hit = find_game(gom, path)
            if hit:
                add(hit[0], hit[1])
        elif os.path.isfile(path) and paths:
            add(path, "script or installer" if path.endswith((".sh", ".run")) else "program")
        elif os.path.isfile(path) and re.search(r"\.(sh|run)$", path, re.I):
            loose += 1      # gom would show it every file next to it, so it needs its own folder
    for p in ([] if paths else gom_profiles()):
        if p == "selftest":
            continue
        try:
            with open(os.path.join(GOM_DATA, p, "game.path"), encoding="utf-8") as f:
                remembered = f.readline().strip()
        except OSError:
            remembered = ""
        if remembered and os.path.exists(remembered):
            add(remembered, "from gom profile %s" % p, profile=p, title=clean_title(p))
        for d in sorted(profile_dirs(p)):
            home_game = os.path.join(GOM_DATA, p, "home", d)
            if gom_launchers(gom, home_game)[0] in ("ok", "choose"):
                add(home_game, "installed into gom profile %s" % p, profile=p)
    return found, skipped, loose


class ImportDialog(Gtk.Dialog):
    def __init__(self, parent, gom, taken, folder, paths=None):
        super().__init__(title="Import games", transient_for=parent, modal=True)
        self.paths = paths
        self.set_default_size(780, 640)
        self.ok = dialog_buttons(self, "Import")
        self.ok.set_sensitive(False)
        self.gom, self.taken, self.gen = gom, taken, 0
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_property("margin", 20)
        box.pack_start(label("Import games", "d-section"), False, False, 0)
        box.pack_start(label("Every subfolder of the folder below that gom can start becomes a game, "
                             "and so do games your gom profiles remember. Nothing is copied or moved.",
                             "hint", wrap=True), False, False, 0)
        row = Gtk.Box(spacing=8)
        self.folder = label("", "d-mono")
        self.folder.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        change = Gtk.Button(label="Change folder…")
        change.connect("clicked", lambda *_: self.change_folder())
        row.pack_start(self.folder, True, True, 0)
        row.pack_start(change, False, False, 0)
        box.pack_start(row, False, False, 0)
        sel = Gtk.Box(spacing=4)
        self.status = label("", "hint")
        sel.pack_start(self.status, True, True, 0)
        for text, on in (("Select all", True), ("Select none", False)):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("flat")
            b.connect("clicked", lambda _b, v=on: self.select_all(v))
            sel.pack_start(b, False, False, 0)
        box.pack_start(sel, False, False, 0)
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        sc.add(self.list)
        box.pack_start(sc, True, True, 0)
        self.rows = []
        self.show_all()
        self.scan(folder)

    def change_folder(self):
        p = choose_file(self, "Folder with games", Gtk.FileChooserAction.SELECT_FOLDER,
                        start=self.folder.get_text() or HOME)
        if p:
            self.paths = None
            self.scan(p)

    def scan(self, folder):
        self.gen += 1
        gen = self.gen
        self.folder.set_text("%d dropped item%s" % (len(self.paths), "" if len(self.paths) == 1 else "s")
                             if self.paths else short_path(folder) if folder else "(no folder chosen)")
        self.folder_path = folder
        for r in self.list.get_children():
            self.list.remove(r)
        self.rows = []
        self.update_ok()
        self.status.set_text("Looking for games…")
        spawn(scan_games, lambda res, err: self.show_results(gen, res, err), self.gom, folder,
              self.taken, self.paths)

    def show_results(self, gen, res, err):
        if gen != self.gen:
            return
        if err:
            self.status.set_text("Scanning failed: %s" % err)
            return
        found, skipped, loose = res
        for c in found:
            check = Gtk.CheckButton(label=c["title"], active=True)
            check.connect("toggled", lambda *_: self.update_ok())
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin=6)
            v.pack_start(check, False, False, 0)
            hint = label("%s · %s" % (short_path(c["path"]), c["note"]), "hint")
            hint.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            hint.set_margin_start(30)
            v.pack_start(hint, False, False, 0)
            self.list.add(v)
            self.rows.append((check, c))
        self.list.show_all()
        msg = "%d new game%s found." % (len(found), "" if len(found) == 1 else "s")
        if skipped:
            msg += " %d already on the shelf." % skipped
        if loose:
            msg += (" %d loose installer%s left out: move each into a folder of its own first, because "
                    "a game sees every file next to it." % (loose, "" if loose == 1 else "s"))
        self.status.set_text(msg)
        self.update_ok()

    def select_all(self, on):
        for check, _c in self.rows:
            check.set_active(on)

    def update_ok(self):
        n = sum(1 for check, _c in self.rows if check.get_active())
        self.ok.set_label("Import %d game%s" % (n, "" if n == 1 else "s") if n else "Import")
        self.ok.set_sensitive(n > 0)

    def chosen(self):
        return [dict(title=c["title"], path=c["path"], profile=c["profile"])
                for check, c in self.rows if check.get_active()]


class LogDialog(Gtk.Dialog):
    def __init__(self, parent, title, sources):
        super().__init__(title="Logs: %s" % title, transient_for=parent, modal=True)
        self.set_default_size(1000, 660)
        self.add_button("Refresh", 1)
        self.add_button("Copy", 2)
        self.add_button("Close", Gtk.ResponseType.CLOSE).get_parent().set_property("margin", 12)
        self.sources = sources
        self.nb = Gtk.Notebook()
        self.views = []
        for name, path, hint in sources:
            tv = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                              left_margin=10, right_margin=10, top_margin=8, bottom_margin=8)
            tv.get_style_context().add_class("mono")
            sc = Gtk.ScrolledWindow(vexpand=True)
            sc.add(tv)
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            page.pack_start(label("%s · %s" % (short_path(path), hint), "hint"), False, False, 6)
            page.pack_start(sc, True, True, 0)
            self.nb.append_page(page, Gtk.Label(label=name))
            self.views.append((tv, path))
        self.get_content_area().pack_start(self.nb, True, True, 0)
        self.load()
        self.show_all()

    def load(self):
        for tv, path in self.views:
            text = read_tail(path)
            tv.get_buffer().set_text(text if text else "(nothing logged yet)")
            GLib.idle_add(lambda t=tv: t.scroll_to_iter(t.get_buffer().get_end_iter(), 0, False, 0, 1) and False)

    def run_loop(self):
        while True:
            r = self.run()
            if r == 1:
                self.load()
            elif r == 2:
                tv = self.views[self.nb.get_current_page()][0]
                b = tv.get_buffer()
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(
                    b.get_text(b.get_start_iter(), b.get_end_iter(), False), -1)
            else:
                break
        self.destroy()


def confirm_remove(parent, g, shared, files_root=None):
    d = Gtk.Dialog(title="Remove game", transient_for=parent, modal=True)
    dialog_buttons(d, "Remove")
    box = d.get_content_area()
    box.set_spacing(8)
    box.set_property("margin", 22)
    box.pack_start(label("Remove “%s” from the shelf?" % g["title"], "d-section"), False, False, 0)
    if not files_root:
        box.pack_start(label("The game files stay where they are.", "hint"), False, False, 0)
    files = Gtk.CheckButton(label="Also delete the game files shelf installed in %s" % short_path(files_root or ""))
    files.get_child().set_line_wrap(True)
    if files_root:
        box.pack_start(files, False, False, 8)
    prof = g.get("profile") or ""
    check = Gtk.CheckButton(label="Also delete its gom profile “%s”: saves, settings and every "
                                  "change the game made to its files" % prof)
    check.get_child().set_line_wrap(True)
    has_profile = bool(prof) and os.path.isdir(os.path.join(GOM_DATA, prof))
    if has_profile:
        box.pack_start(check, False, False, 8)
        if shared:
            check.set_sensitive(False)
            box.pack_start(label("Another game on the shelf uses this profile, so it stays.", "hint"),
                           False, False, 0)
    d.show_all()
    ok = d.run() == Gtk.ResponseType.OK
    delete = ok and has_profile and not shared and check.get_active()
    wipe_files = ok and bool(files_root) and files.get_active()
    d.destroy()
    return ok, delete, wipe_files


KEYS = (("Enter, double-click", "play the selected game"), ("Menu key, right-click", "more actions"),
        ("F2", "edit"), ("Delete", "remove from the shelf"), ("Ctrl+D", "favorite on/off"),
        ("Ctrl+H", "hide or show again"), ("Ctrl+L", "logs"), ("Ctrl+N", "add a game"),
        ("Ctrl+O", "import games from a folder"), ("Ctrl+F, or just type", "search"),
        ("Escape", "clear the search"), ("Ctrl+R", "pick a random game"),
        ("Ctrl+1 … Ctrl+5", "All, Favorites, Recent, Not played, Hidden"),
        ("Ctrl+Tab", "switch between Library and Archive"), ("Ctrl+I", "details panel on/off"), ("Ctrl+plus, Ctrl+minus, Ctrl+wheel", "bigger or smaller covers"),
        ("F11", "full screen"), ("F1", "this list"), ("Ctrl+Q", "quit"))


def show_keys(parent):
    d = Gtk.Dialog(title="Keyboard shortcuts", transient_for=parent, modal=True)
    d.add_button("Close", Gtk.ResponseType.CLOSE).get_parent().set_property("margin", 12)
    grid = Gtk.Grid(column_spacing=24, row_spacing=6, margin=22)
    for i, (k, what) in enumerate(KEYS):
        grid.attach(label(k, "title"), 0, i, 1, 1)
        grid.attach(label(what, "d-line"), 1, i, 1, 1)
    d.get_content_area().add(grid)
    d.show_all()
    d.run()
    d.destroy()


# ------------------------------------------------------------------ main window

class Shelf(Gtk.Window):
    def __init__(self):
        super().__init__(title="shelf")
        self.settings = Settings()
        self.lib = Library()
        self.gom = find_gom()
        self.procs = {}                 # gid -> run started by this window
        self.elsewhere = set()          # gids whose gom profile is busy outside this window
        self.adopted = {}               # gid -> start of a run a closed shelf left behind
        self.cards, self.sizes = {}, {}
        self.cover_todo, self.cover_job = [], 0
        self.toast_id = self.view_job = self.monitor_job = 0
        self.covers = AutoCovers(self.on_auto_cover)
        self.net_warned = False
        self._installed_cache = {}
        self.build_archive()

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.set_default_size(self.settings["width"], self.settings["height"])
        with contextlib.suppress(Exception):           # an icon is never worth failing to start
            self.set_icon_list([shelf_icon(n) for n in (16, 24, 32, 48, 64, 128, 256)])
        if self.settings["maximized"]:
            self.maximize()
        self.fullscreen_on = False
        self.connect("window-state-event", self.on_window_state)
        self.connect("delete-event", self.on_delete)
        self.connect("destroy", self.on_destroy)
        self.connect("key-press-event", self.on_key)

        header = Gtk.Box(spacing=12)
        header.get_style_context().add_class("header")
        brand = label("shelf", "brand")
        self.count = label("", "count")
        brand.set_valign(Gtk.Align.BASELINE)
        self.count.set_valign(Gtk.Align.BASELINE)
        self.search = Gtk.SearchEntry(placeholder_text="Search titles, tags, notes", width_chars=30)
        self.search.connect("search-changed", lambda *_: self.queue_view())
        self.search.connect("key-press-event", self.on_search_key)
        add = Gtk.Button(label="Add game")
        add.get_style_context().add_class("primary")
        add.connect("clicked", lambda *_: self.add_game())
        self.menu_btn = Gtk.MenuButton(label="Menu")
        self.menu_btn.set_popup(self.build_app_menu())
        logo = Gtk.Image(valign=Gtk.Align.CENTER, margin_end=2)
        with contextlib.suppress(Exception):
            scale = self.get_scale_factor()
            px = 32 * scale                             # zoomed onto the shelf: no black margin
            big = shelf_icon(round(px * 1.45))
            n = big.get_width()
            y = max(0, min(n - px, round(n * 0.85) - px))
            crop = big.new_subpixbuf((n - px) // 2, y, px, px)
            logo.set_from_surface(Gdk.cairo_surface_create_from_pixbuf(crop, scale, None))
        header.pack_start(logo, False, False, 0)
        header.pack_start(brand, False, False, 0)
        self.view_buttons = {}
        for key, text in (("library", "Library"), ("archive", "Archive")):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("tab")
            b.get_style_context().add_class("view")
            b.set_valign(Gtk.Align.BASELINE)
            b.connect("clicked", lambda _b, k=key: self.set_view(k))
            header.pack_start(b, False, False, 0)
            self.view_buttons[key] = b
        header.pack_start(self.count, False, False, 0)
        header.pack_end(self.menu_btn, False, False, 0)
        header.pack_end(add, False, False, 0)
        header.pack_end(self.search, False, False, 0)

        bar = Gtk.Box()
        bar.get_style_context().add_class("bar")
        self.tab_buttons, self.sort_buttons = {}, {}
        for key, text in TABS:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("tab")
            b.connect("clicked", lambda _b, k=key: self.set_tab(k))
            bar.pack_start(b, False, False, 0)
            self.tab_buttons[key] = b
        for key, text in reversed(SORTS):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("tab")
            b.connect("clicked", lambda _b, k=key: self.set_sort(k))
            bar.pack_end(b, False, False, 0)
            self.sort_buttons[key] = b
        bar.pack_end(label("Sort", "bar-label"), False, False, 0)

        self.flow = Gtk.FlowBox(valign=Gtk.Align.START, homogeneous=True, max_children_per_line=60,
                                selection_mode=Gtk.SelectionMode.SINGLE, column_spacing=6,
                                row_spacing=12, activate_on_single_click=False)
        self.flow.set_sort_func(self.sort_cards)
        self.flow.set_filter_func(self.filter_card)
        self.flow.connect("child-activated", lambda _f, c: self.play(c.gid))
        self.flow.connect("selected-children-changed", lambda *_: self.on_selection())
        self.flow.connect("button-press-event", self.on_button)
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True)
        self.scroll.add(self.flow)
        self.flow.set_focus_vadjustment(self.scroll.get_vadjustment())
        self.scroll.connect("scroll-event", self.on_scroll)
        targets = [Gtk.TargetEntry.new("text/uri-list", 0, 0), Gtk.TargetEntry.new("text/plain", 0, 1)]
        self.scroll.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
        self.scroll.connect("drag-data-received", self.on_drop)

        self.empty_title = label("", "empty-title")
        self.empty_hint = label("", "hint", wrap=True)
        for w in (self.empty_title, self.empty_hint):
            w.set_xalign(0.5)
            w.set_justify(Gtk.Justification.CENTER)
        self.empty_btns = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=14)
        for text, fn in (("Browse the archive", lambda: self.set_view("archive")),
                         ("Import games…", self.import_games), ("Add a game…", self.add_game)):
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, f=fn: f())
            self.empty_btns.pack_start(b, False, False, 0)
        empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.CENTER)
        for w in (self.empty_title, self.empty_hint, self.empty_btns):
            empty.pack_start(w, False, False, 0)
        empty.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
        empty.connect("drag-data-received", self.on_drop)
        self.body = Gtk.Stack(hexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE,
                              transition_duration=120)
        self.body.add_named(self.scroll, "grid")
        self.body.add_named(empty, "empty")
        self.body.add_named(self.archive_body, "archive")
        self.bars = Gtk.Stack(vhomogeneous=False)
        self.bars.add_named(bar, "library")
        self.bars.add_named(self.archive_bar, "archive")

        self.details = DetailsPane({
            "play": lambda gid, w: self.play(gid), "stop": lambda gid, w: self.stop(gid),
            "edit": lambda gid, w: self.edit(gid), "log": lambda gid, w: self.show_log(gid),
            "saves": lambda gid, w: self.open_path(self.profile_home(gid)),
            "more": lambda gid, w: self.game_menu(gid).popup_at_widget(
                w, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)})
        self.side = Gtk.Stack(hexpand=False)
        self.side.add_named(self.details, "library")
        self.side.add_named(self.apane, "archive")
        self.side.set_no_show_all(True)
        main = Gtk.Box()
        main.pack_start(self.body, True, True, 0)
        main.pack_start(self.side, False, False, 0)

        self.toast = label("", "toast", wrap=True, selectable=True)
        self.toast.set_no_show_all(True)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for w, grow in ((header, False), (self.bars, False), (main, True), (self.toast, False)):
            vbox.pack_start(w, grow, grow, 0)
        self.add(vbox)

        for g in self.lib.games:
            self.add_card(g)
        self.mark_tabs()
        self.show_all()
        self.set_details(self.settings["details"])
        self.refresh_all()
        self.select_first()
        self.set_view(self.settings["view"])

        self.monitor = Gio.File.new_for_path(LIBRARY).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", lambda *_: self.on_library_changed())
        GLib.timeout_add_seconds(3, self.poll)
        GLib.timeout_add_seconds(30, lambda: self.refresh_running() or True)
        self.poll()
        if self.lib.warning:
            self.say(self.lib.warning, 30, error=True)
        spawn(prune_covers, lambda *_: None, self.lib)
        self.queue_auto_covers()

    # -------------------------------------------------- building blocks

    def build_app_menu(self):
        m = Gtk.Menu()
        self.online_item = Gtk.CheckMenuItem(label="Look up covers online")
        self.online_item.set_active(self.settings["online"] and not ENV_OFFLINE)
        self.online_item.set_sensitive(not ENV_OFFLINE)
        self.online_item.connect("toggled", self.on_online_toggled)
        self.details_item = Gtk.CheckMenuItem(label="Details panel")
        self.details_item.set_active(self.settings["details"])
        self.details_item.connect("toggled", lambda i: self.set_details(i.get_active()))
        items = [("Import games…", self.import_games), ("Add a game…", self.add_game),
                 ("Where archive games go…", lambda: self.choose_games_dir()), None,
                 self.online_item, self.details_item, None,
                 ("Keyboard shortcuts", lambda: show_keys(self)),
                 ("Open the shelf folder", lambda: self.open_path(SHELF))]
        for it in items:
            if it is None:
                m.append(Gtk.SeparatorMenuItem())
            elif isinstance(it, Gtk.MenuItem):
                m.append(it)
            else:
                mi = Gtk.MenuItem(label=it[0])
                mi.connect("activate", lambda _w, fn=it[1]: fn())
                m.append(mi)
        m.show_all()
        return m

    def online(self):
        return self.settings["online"] and not ENV_OFFLINE

    def on_online_toggled(self, item):
        self.settings["online"] = item.get_active()
        self.settings.save()
        if item.get_active():
            self.queue_auto_covers()

    def set_details(self, on):
        self.settings["details"] = on
        self.side.set_visible(on)
        if self.details_item.get_active() != on:
            self.details_item.set_active(on)
        self.update_details()
        if hasattr(self, "view_buttons"):
            self.update_archive_pane()

    def save_settings(self):
        if not (self.settings["maximized"] or self.fullscreen_on):
            w, h = self.get_size()
            self.settings["width"], self.settings["height"] = w, h
        self.settings.save()

    def on_window_state(self, _w, ev):
        st = ev.new_window_state
        self.fullscreen_on = bool(st & Gdk.WindowState.FULLSCREEN)
        if not self.fullscreen_on:
            self.settings["maximized"] = bool(st & Gdk.WindowState.MAXIMIZED)

    def say(self, text, seconds=7, error=False):
        ctx = self.toast.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("error")
        self.toast.set_text(text)
        self.toast.show()
        self.toast_id += 1
        tid = self.toast_id
        GLib.timeout_add_seconds(seconds, lambda: tid == self.toast_id and self.toast.hide())

    # -------------------------------------------------- cards and view

    def add_card(self, g):
        c = Card(g["id"], self.settings["zoom"])
        self.cards[g["id"]] = c
        self.flow.add(c)
        c.show_text(g, *self.meta_for(g))
        return c

    def meta_for(self, g):
        """(meta text, style, placeholder note) for a card."""
        gid = g["id"]
        note = "looking for a cover…" if gid in self.covers.pending else ""
        if gid in self.procs:
            return "running · %s" % fmt_duration(time.time() - self.procs[gid]["start"]), "running", note
        if gid in self.elsewhere or gid in self.adopted:
            return "running", "running", note
        if not os.path.exists(g["path"]):
            return "missing", "bad", note
        if g.get("last_error"):
            return "last run failed", "bad", note
        parts = [fmt_duration(g["playtime"])] if g.get("playtime") else []
        if g.get("last_played"):
            parts.append(fmt_when(g["last_played"]))
        return " · ".join(parts), None, note

    def refresh(self, gid):
        g, c = self.lib.get(gid), self.cards.get(gid)
        if g and c:
            c.show_text(g, *self.meta_for(g))
            if c.needs_cover():
                self.queue_cover(c)
        if gid == self.details.gid or gid is None:
            self.update_details()
        self.queue_view()

    def refresh_all(self):
        for gid in list(self.cards):
            self.refresh(gid)

    def refresh_running(self):
        for gid in list(self.procs) + list(self.elsewhere) + list(self.adopted):
            self.refresh(gid)

    def sync_cards(self):
        """After another process changed the library: add, drop and update cards."""
        for gid in [gid for gid in self.cards if gid not in self.lib.by_id]:
            self.flow.remove(self.cards.pop(gid))
        for g in self.lib.games:
            if g["id"] not in self.cards:
                self.add_card(g)
        self.refresh_all()
        self.refresh_archive()

    def queue_cover(self, card):
        if card.gid not in self.cover_todo:
            self.cover_todo.append(card.gid)
        if not self.cover_job:
            self.cover_job = GLib.idle_add(self.load_covers, priority=GLib.PRIORITY_LOW)

    def load_covers(self):
        for _ in range(10):
            if not self.cover_todo:
                break
            c = self.cards.get(self.cover_todo.pop(0))
            if c and c.needs_cover():
                c.load_cover()
        if self.cover_todo:
            return True
        self.cover_job = 0
        return False

    def queue_view(self):
        if not self.view_job:
            self.view_job = GLib.idle_add(self.apply_view)

    def apply_view(self):
        self.view_job = 0
        if self.settings["view"] == "archive":
            self.body.set_visible_child_name("archive")
            self.apply_archive_view()
            return False
        self.flow.invalidate_filter()
        self.flow.invalidate_sort()
        shown = [c for c in self.cards.values() if self.filter_card(c)]
        total = sum(1 for g in self.lib.games if not g.get("hidden"))
        filtered = self.settings["tab"] != "all" or self.search.get_text().strip()
        self.count.set_text(("%d of %d" % (len(shown), total) if filtered else
                             "%d game%s" % (total, "" if total == 1 else "s")) if self.lib.games else "")
        if shown:
            self.body.set_visible_child_name("grid")
        else:
            self.body.set_visible_child_name("empty")
            if not self.lib.games:
                self.empty_title.set_text("No games yet")
                self.empty_hint.set_text("Install games from the archive, import a folder of games, "
                                         "add one by hand, or drop a game folder here.")
                self.empty_btns.show()
            else:
                self.empty_title.set_text("Nothing here")
                self.empty_hint.set_text("No game matches the search or this tab.")
                self.empty_btns.hide()
        sel = self.flow.get_selected_children()
        if sel and not self.filter_card(sel[0]):
            self.flow.unselect_all()
        return False

    def filter_card(self, card):
        g = card.data
        if not g:
            return False
        tab = self.settings["tab"]
        if tab == "hidden":
            if not g.get("hidden"):
                return False
        elif g.get("hidden"):
            return False
        elif tab == "favorites" and not g.get("favorite"):
            return False
        elif tab == "recent" and not (g.get("last_played") and time.time() - g["last_played"] < 30 * 86400):
            return False
        elif tab == "unplayed" and (g.get("sessions") or g.get("last_played")):
            return False
        q = self.search.get_text().strip().casefold()
        if not q:
            return True
        hay = " ".join([g["title"], g.get("profile") or "", " ".join(g.get("tags") or []),
                        g.get("notes") or ""]).casefold()
        return all(w in hay for w in q.split())

    def sort_value(self, card):
        g, s = card.data, self.settings["sort"]
        if s == "played":
            return (-(g.get("last_played") or 0), card.key)
        if s == "playtime":
            return (-(g.get("playtime") or 0), card.key)
        if s == "added":
            return (-(g.get("added") or 0), card.key)
        return (0, card.key)

    def sort_cards(self, a, b):
        ka, kb = self.sort_value(a), self.sort_value(b)
        return (ka > kb) - (ka < kb)

    def mark_tabs(self):
        for key, b in self.tab_buttons.items():
            (b.get_style_context().add_class if key == self.settings["tab"]
             else b.get_style_context().remove_class)("active")
        for key, b in self.sort_buttons.items():
            (b.get_style_context().add_class if key == self.settings["sort"]
             else b.get_style_context().remove_class)("active")

    def set_tab(self, key):
        self.settings["tab"] = key
        self.settings.save()
        self.mark_tabs()
        self.apply_view()
        self.select_first()

    def set_sort(self, key):
        self.settings["sort"] = key
        self.settings.save()
        self.mark_tabs()
        self.apply_view()

    def set_zoom(self, step):
        i = ZOOMS.index(self.settings["zoom"]) + step
        if not 0 <= i < len(ZOOMS):
            return
        self.settings["zoom"] = ZOOMS[i]
        self.settings.save()
        for c in self.acards.values():
            c.set_width(ZOOMS[i])
        self.queue_visible_thumbs()
        for c in self.cards.values():
            c.set_width(ZOOMS[i])
            if c.needs_cover():
                self.queue_cover(c)

    def visible_cards(self):
        cards, i = [], 0
        while True:
            c = self.flow.get_child_at_index(i)
            if c is None:
                return cards
            if self.filter_card(c):
                cards.append(c)
            i += 1

    def select_first(self):
        cards = self.visible_cards()
        if cards:
            self.select(cards[0].gid)

    def select(self, gid):
        c = self.cards.get(gid)
        if c and self.filter_card(c):
            self.flow.select_child(c)
            GLib.idle_add(lambda: c.grab_focus() and False)

    def selected(self):
        sel = self.flow.get_selected_children()
        return sel[0].gid if sel else None

    def on_selection(self):
        self.update_details()

    def update_details(self):
        if not self.settings["details"]:
            return
        gid = self.selected()
        g = self.lib.get(gid) if gid else None
        if g is None:
            self.details.show_game(None, None, (None, None))
            return
        if gid in self.procs:
            run = ("ours", time.time() - self.procs[gid]["start"])
        elif gid in self.elsewhere or gid in self.adopted:
            run = ("elsewhere", None)
        else:
            run = None
        if gid not in self.sizes:
            self.sizes[gid] = (None, None)
            prof = os.path.join(GOM_DATA, g.get("profile") or "")
            spawn(lambda: (dir_size(game_dir(g["path"])), dir_size(prof) if g.get("profile") else 0),
                  lambda res, err, k=gid: self.got_sizes(k, res))
        self.details.show_game(g, run, self.sizes[gid])

    def got_sizes(self, gid, res):
        if res:
            self.sizes[gid] = res
            if gid == self.details.gid:
                self.update_details()



    # -------------------------------------------------- archive view

    ARCHIVE_TABS = (("all", "All"), ("new", "Not installed"), ("installed", "Installed"),
                    ("history", "History"), ("downloads", "Downloads"))
    ARCHIVE_SORTS = (("popular", "Popular"), ("name", "Name"), ("newest", "Newest"),
                     ("smallest", "Smallest"))

    def build_archive(self):
        """Archive state, its bar, grid and side panel. Called once from __init__."""
        self.catalog, self.catalog_by_id, self.catalog_time = [], {}, 0.0
        self.catalog_loading = False
        self.acards, self.ia_meta, self.ia_logo = {}, {}, {}
        self.jobs, self.job_queue, self.job_thread = {}, queue.Queue(), None
        self.thumbs = ThumbLoader(self.on_thumb)
        self.visible_job = 0

        bar = Gtk.Box()
        bar.get_style_context().add_class("bar")
        self.atab_buttons, self.asort_buttons = {}, {}
        for key, text in self.ARCHIVE_TABS:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("tab")
            b.connect("clicked", lambda _b, k=key: self.set_archive_opt("archive_tab", k))
            bar.pack_start(b, False, False, 0)
            self.atab_buttons[key] = b
        for key, text in reversed(self.ARCHIVE_SORTS):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("tab")
            b.connect("clicked", lambda _b, k=key: self.set_archive_opt("archive_sort", k))
            bar.pack_end(b, False, False, 0)
            self.asort_buttons[key] = b
        bar.pack_end(label("Sort", "bar-label"), False, False, 0)
        self.archive_bar = bar

        self.aflow = Gtk.FlowBox(valign=Gtk.Align.START, homogeneous=True, max_children_per_line=60,
                                 selection_mode=Gtk.SelectionMode.SINGLE, column_spacing=6,
                                 row_spacing=12, activate_on_single_click=False)
        self.aflow.set_sort_func(self.archive_sort_cards)
        self.aflow.set_filter_func(self.archive_filter)
        self.aflow.connect("selected-children-changed", lambda *_: self.on_archive_selection())
        self.aflow.connect("child-activated", lambda _f, c: self.archive_activate(c.gid))
        self.ascroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True)
        self.ascroll.add(self.aflow)
        self.aflow.set_focus_vadjustment(self.ascroll.get_vadjustment())
        self.ascroll.get_vadjustment().connect("value-changed", lambda *_: self.queue_visible_thumbs())
        self.ascroll.connect("size-allocate", lambda *_: self.queue_visible_thumbs())
        self.ascroll.connect("scroll-event", self.on_scroll)
        self.amsg = label("", "empty-title", wrap=True)
        self.amsg.set_xalign(0.5)
        self.amsg.set_justify(Gtk.Justification.CENTER)
        self.astatus = label("", "hint", wrap=True)
        self.astatus.set_xalign(0.5)
        self.astatus.set_justify(Gtk.Justification.CENTER)
        refresh = Gtk.Button(label="Refresh the list", halign=Gtk.Align.CENTER)
        refresh.connect("clicked", lambda *_: self.ensure_catalog(force=True))
        msg = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, valign=Gtk.Align.CENTER)
        for w in (self.amsg, self.astatus, refresh):
            msg.pack_start(w, False, False, 0)
        self.archive_body = Gtk.Stack()
        self.archive_body.add_named(self.ascroll, "grid")
        self.archive_body.add_named(msg, "msg")
        self.apane = ArchivePane({
            "install": self.start_install, "cancel": self.cancel_install,
            "library": lambda ident: self.show_in_library(ident),
            "web": lambda ident: self.open_uri("%s/details/%s" % (ARCHIVE_URL, ident))})

    def set_view(self, view):
        self.settings["view"] = view
        self.settings.save()
        for key, b in self.view_buttons.items():
            (b.get_style_context().add_class if key == view else b.get_style_context().remove_class)("active")
        self.bars.set_visible_child_name(view)
        self.side.set_visible_child_name(view)
        self.search.set_placeholder_text("Search the archive" if view == "archive"
                                         else "Search titles, tags, notes")
        if view == "archive":
            self.ensure_catalog()
        self.apply_view()
        if view == "archive":
            self.update_archive_pane()
        else:
            self.update_details()

    def set_archive_opt(self, key, value):
        self.settings[key] = value
        self.settings.save()
        self.apply_view()

    def mark_archive_tabs(self):
        for group, key in ((self.atab_buttons, "archive_tab"), (self.asort_buttons, "archive_sort")):
            for k, b in group.items():
                (b.get_style_context().add_class if k == self.settings[key]
                 else b.get_style_context().remove_class)("active")

    def ensure_catalog(self, force=False):
        if not self.catalog:
            items, t = load_catalog()
            if items:
                self.set_catalog(items, t)
        if self.catalog_loading or not (force or not self.catalog
                                        or time.time() - self.catalog_time > CATALOG_MAX_AGE):
            return
        self.catalog_loading = True
        if not self.catalog:
            self.archive_message("Reading the game list from archive.org…", "")
        spawn(fetch_catalog, self.got_catalog)

    def got_catalog(self, items, err):
        self.catalog_loading = False
        if err or not items:
            why = "Could not read the game list from archive.org: %s" % (err or "it came back empty")
            if self.catalog:
                self.say(why, 12, error=True)
            else:
                self.archive_message("The archive is out of reach.", why)
            return
        with contextlib.suppress(OSError):
            save_catalog(items)
        self.set_catalog(items, time.time())

    def archive_message(self, title, hint):
        self.amsg.set_text(title)
        self.astatus.set_text(hint)
        self.archive_body.set_visible_child_name("msg")

    def set_catalog(self, items, fetched):
        self.catalog, self.catalog_time = items, fetched
        self.catalog_by_id = {i["id"]: i for i in items}
        for ident in [i for i in self.acards if i not in self.catalog_by_id]:
            self.aflow.remove(self.acards.pop(ident))
        for item in items:
            c = self.acards.get(item["id"])
            if c is None:
                c = self.acards[item["id"]] = ArchiveCard(item, self.settings["zoom"])
                self.aflow.add(c)
            self.refresh_archive_card(item["id"])
        self.archive_body.set_visible_child_name("grid")
        self.apply_view()

    def installed_map(self):
        return {g["archive"]: g["id"] for g in self.lib.games if g.get("archive")}

    def archive_meta(self, item, installed):
        job = self.jobs.get(item["id"])
        base = fmt_size(item["size"]) + (" · " + item["tags"][0] if item["tags"] else "")
        if item["id"] in installed:
            g = self.lib.get(installed[item["id"]])
            played = g and g.get("playtime")
            return ("installed · played %s" % fmt_duration(played) if played else "installed · " + base), None
        old = self.lib.history.get("archive:" + item["id"])
        if job:
            st = job["stage"]
            if st == "download" and job["total"]:
                return "downloading %d%%" % (100 * job["done"] / job["total"]), "running"
            if st in ("queued", "checking", "connect", "unpack", "library"):
                return {"queued": "waiting to download", "checking": "checking the download",
                        "connect": "connecting", "unpack": "unpacking", "library": "unpacking"}[st], "running"
            if st == "failed":
                return "install failed", "bad"
        if old:
            return ("played %s before" % fmt_duration(old["playtime"]) if old.get("playtime")
                    else "installed before"), None
        return base, None

    def refresh_archive_card(self, ident, installed=None):
        c, item = self.acards.get(ident), self.catalog_by_id.get(ident)
        if not c or not item:
            return
        installed = self.installed_map() if installed is None else installed
        c.show_item(item, *self.archive_meta(item, installed))
        gid = installed.get(ident)
        g = self.lib.get(gid) if gid else None
        if g and g.get("cover") and c.pixbuf is None:      # installed: the library's own cover
            with contextlib.suppress(GLib.Error):
                c.set_pixbuf(GdkPixbuf.Pixbuf.new_from_file(os.path.join(COVERS, g["cover"])))

    def refresh_archive(self):
        installed = self.installed_map()
        for ident in self.acards:
            self.refresh_archive_card(ident, installed)

    def archive_filter(self, card):
        item, tab = card.item, self.settings["archive_tab"]
        installed = self._installed_cache
        if tab == "new" and item["id"] in installed:
            return False
        if tab == "installed" and item["id"] not in installed:
            return False
        if tab == "downloads" and item["id"] not in self.jobs:
            return False
        if tab == "history" and item["id"] not in installed and \
                "archive:" + item["id"] not in self.lib.history:
            return False
        q = self.search.get_text().strip().casefold()
        if q:
            hay = (item["raw"] + " " + item["id"]).casefold()
            return all(w in hay for w in q.split())
        return True

    def archive_sort_value(self, card):
        item, s = card.item, self.settings["archive_sort"]
        if s == "popular":
            return (-item["downloads"], card.key)
        if s == "newest":
            return (tuple(-ord(ch) for ch in item["date"]), card.key)
        if s == "smallest":
            return (item["size"], card.key)
        return (0, card.key)

    def archive_sort_cards(self, a, b):
        ka, kb = self.archive_sort_value(a), self.archive_sort_value(b)
        return (ka > kb) - (ka < kb)

    def apply_archive_view(self):
        self.mark_archive_tabs()
        busy = len(self.busy_downloads())
        self.atab_buttons["downloads"].set_label("Downloads · %d" % busy if busy else "Downloads")
        self._installed_cache = self.installed_map()
        self.aflow.invalidate_filter()
        self.aflow.invalidate_sort()
        if not self.catalog:
            self.count.set_text("")
            return
        shown = sum(1 for c in self.acards.values() if self.archive_filter(c))
        total = len(self.catalog)
        if shown == total:
            self.count.set_text("%d games · %s" % (total, fmt_size(sum(i["size"] for i in self.catalog))))
        else:
            self.count.set_text("%d of %d" % (shown, total))
        if shown:
            self.archive_body.set_visible_child_name("grid")
        else:
            self.archive_message("Nothing here", "No archive game matches the search or this tab.")
        self.queue_visible_thumbs()

    def queue_visible_thumbs(self):
        if not self.visible_job:
            self.visible_job = GLib.timeout_add(150, self.want_visible_thumbs)

    def want_visible_thumbs(self):
        """Ask for the pictures of the cards on screen (and one screen below), nothing else."""
        self.visible_job = 0
        if self.settings["view"] != "archive" or not self.catalog:
            return False
        adj = self.ascroll.get_vadjustment()
        top, bottom = adj.get_value() - 100, adj.get_value() + 2 * adj.get_page_size()
        want = []
        for c in self.acards.values():
            if c.pixbuf is not None or not c.get_child_visible():
                continue
            a = c.get_allocation()
            if a.height > 1 and a.y + a.height >= top and a.y <= bottom:
                want.append((a.y, a.x, c.gid))
        self.thumbs.want([gid for _y, _x, gid in sorted(want)])
        return False

    def on_thumb(self, ident, pb):
        c = self.acards.get(ident)
        if c and pb is not None and c.pixbuf is None:
            c.set_pixbuf(pb)
        if self.apane.item and self.apane.item["id"] == ident and ident not in self.ia_logo:
            self.apane.set_logo(ident, pb)

    def archive_selected(self):
        sel = self.aflow.get_selected_children()
        return sel[0].gid if sel else None

    def on_archive_selection(self):
        ident = self.archive_selected()
        if not ident:
            return
        if ident not in self.ia_meta:
            self.ia_meta[ident] = None
            spawn(ia_metadata, lambda res, err, i=ident: self.got_metadata(i, res, err), ident)
            self.update_archive_pane()
        else:
            self.update_archive_pane()
            self.load_shots(ident)

    def got_metadata(self, ident, res, err):
        if err or not isinstance(res, dict) or not res.get("files"):
            self.ia_meta[ident] = {"error": str(err or "the item is empty or dark"), "payloads": []}
        else:
            md = res.get("metadata") or {}
            desc = md.get("description") or md.get("summary") or ""
            if isinstance(desc, list):
                desc = "\n".join(map(str, desc))
            shots = sorted(f["name"] for f in res["files"]
                           if f.get("source") == "original" and "screenshot" in (f.get("name") or "").lower()
                           and (f.get("name") or "").lower().endswith((".jpg", ".jpeg", ".png", ".webp")))
            self.ia_meta[ident] = {"payloads": payload_candidates(res["files"]),
                                   "description": strip_html(str(desc)), "logo": logo_file(res["files"]),
                                   "shots": shots[:3]}
            logo = self.ia_meta[ident]["logo"]
            if logo and ident not in self.ia_logo:
                spawn(lambda: pixbuf_from_bytes(http_get(ia_file_url(ident, logo), MAX_DOWNLOAD, True)),
                      lambda pb, e, i=ident: self.got_logo(i, pb))
        if self.archive_selected() == ident:
            self.update_archive_pane()
            self.load_shots(ident)

    def load_shots(self, ident):
        """Screenshots go straight into the panel; nothing is kept once another game is picked."""
        gen = self.apane.clear_shots()
        for name in (self.ia_meta.get(ident) or {}).get("shots") or []:
            spawn(lambda n=name: pixbuf_from_bytes(http_get(ia_file_url(ident, n), MAX_DOWNLOAD, True)),
                  lambda pb, e, i=ident, g=gen: self.apane.add_shot(i, pb, g))

    def got_logo(self, ident, pb):
        if pb is None:
            return
        self.ia_logo[ident] = pb
        while len(self.ia_logo) > 12:               # big pictures: keep only the last few in memory
            self.ia_logo.pop(next(iter(self.ia_logo)))
        self.apane.set_logo(ident, pb)

    def update_archive_pane(self):
        if self.settings["view"] != "archive" or not self.settings["details"]:
            return
        ident = self.archive_selected()
        item = self.catalog_by_id.get(ident)
        if not item:
            self.apane.show_none()
            return
        installed = ident in self.installed_map()
        self.apane.show_item(item, self.ia_meta.get(ident), self.jobs.get(ident), installed, self.games_dir())
        old = self.lib.history.get("archive:" + ident)
        if old and not installed and not self.apane.state.get_text():
            self.apane.state.set_text(
                "You had this installed%s%s. Installing it again brings that back." % (
                    " until %s" % fmt_date(old["removed"]) if old.get("removed") else "",
                    " and played it for %s" % fmt_long_duration(old["playtime"]) if old.get("playtime") else ""))
            self.apane.state.show()
        if self.apane.logo_for != ident:
            pb = self.ia_logo.get(ident) or self.acards[ident].pixbuf
            if pb is not None:
                self.apane.set_logo(ident, pb)

    def archive_activate(self, ident):
        gid = self.installed_map().get(ident)
        if gid:
            self.show_in_library(ident)

    def show_in_library(self, ident):
        gid = self.installed_map().get(ident)
        self.set_view("library")
        if gid:
            self.set_tab("all")
            self.select(gid)

    def games_dir(self):
        return os.path.expanduser(self.settings["games_dir"])

    def choose_games_dir(self):
        p = choose_file(self, "Where archive games are installed", Gtk.FileChooserAction.SELECT_FOLDER,
                        start=self.games_dir())
        if p:
            self.settings["games_dir"] = short_path(p)
            self.settings.save()
            self.say("Archive games are installed into %s from now on." % short_path(p))

    def open_uri(self, uri):
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error as e:
            self.say("Could not open %s: %s" % (uri, e.message), 12, error=True)

    # -------------------------------------------------- installing from the archive

    def start_install(self, ident, payload):
        item = self.catalog_by_id.get(ident)
        if not item or not payload:
            return
        job = self.jobs.get(ident)
        if job and job["stage"] not in ("failed", "cancelled", "done"):
            return
        self.jobs[ident] = {"item": item, "payload": payload, "stage": "queued", "done": 0,
                            "total": payload["size"], "speed": 0.0, "error": "", "cancel": False,
                            "mark": (0, time.time()), "shown": 0.0}
        self.job_queue.put(ident)
        if self.job_thread is None:
            self.job_thread = threading.Thread(target=self.job_worker, daemon=True)
            self.job_thread.start()
        self.say("%s: downloading %s into %s." % (item["title"], fmt_size(payload["size"]),
                                                  short_path(self.games_dir())))
        self.job_changed(ident)

    def cancel_install(self, ident):
        job = self.jobs.get(ident)
        if job:
            job["cancel"] = True
            if job["stage"] == "queued":
                job["stage"] = "cancelled"
            self.job_changed(ident)

    def job_worker(self):
        while True:
            ident = self.job_queue.get()
            job = self.jobs.get(ident)
            if not job or job["cancel"] or job["stage"] != "queued":
                continue

            def progress(stage, done, total, job=job, ident=ident):
                now = time.time()
                if stage != job["stage"]:
                    job["mark"] = (done, now)
                job["stage"], job["done"], job["total"] = stage, done, total
                d0, t0 = job["mark"]
                if now - t0 >= 2:
                    job["speed"] = (done - d0) / (now - t0)
                    job["mark"] = (done, now)
                if now - job["shown"] >= 0.3:
                    job["shown"] = now
                    GLib.idle_add(self.job_changed, ident)
            try:
                res = install_archive_item(job["item"], job["payload"], self.games_dir(), self.gom,
                                           progress, lambda job=job: job["cancel"])
                job["stage"] = "library"
                GLib.idle_add(self.job_done, ident, res)
            except Cancelled:
                job["stage"] = "cancelled"
                GLib.idle_add(self.job_changed, ident)
            except Exception as e:      # noqa: BLE001  report every failure, keep the worker alive
                job["stage"], job["error"] = "failed", str(e) or e.__class__.__name__
                GLib.idle_add(self.job_failed, ident)

    def job_changed(self, ident):
        self.refresh_archive_card(ident)
        busy = len(self.busy_downloads())
        self.atab_buttons["downloads"].set_label("Downloads · %d" % busy if busy else "Downloads")
        if self.archive_selected() == ident:
            self.update_archive_pane()
        return False

    def job_failed(self, ident):
        job = self.jobs[ident]
        self.say("%s was not installed: %s" % (job["item"]["title"], job["error"]), 30, error=True)
        return self.job_changed(ident)

    def job_done(self, ident, res):
        path, kind, note = res
        job = self.jobs.pop(ident)
        item = job["item"]
        meta = self.ia_meta.get(ident) or {}
        root = os.path.join(self.games_dir(), os.path.relpath(path, self.games_dir()).split(os.sep)[0])
        game = {"title": item["title"], "path": path, "profile": derive_profile(root),
                "archive": ident, "tags": list(item["tags"]),
                "notes": "From archive.org: %s\n%s/details/%s" % (item["raw"], ARCHIVE_URL, ident)}
        if meta.get("logo"):
            game["archive_logo"] = ia_file_url(ident, meta["logo"])
        with self.lib.edit():
            g = self.lib.add(game)
        self.add_card(g)
        self.refresh(g["id"])
        if self.online():
            self.covers.want(g["id"], g["title"])
        elif g.get("archive_logo"):
            self.cover_from_url(g["id"], g["archive_logo"])
        self.refresh_archive_card(ident)
        if self.archive_selected() == ident:
            self.update_archive_pane()
        if kind == "installer":
            self.say("%s is in your library. Its download is an installer shelf cannot unpack, so "
                     "starting it runs the installer in the sandbox first." % item["title"], 20)
        else:
            self.say("%s is installed in %s and waiting in your library.%s"
                     % (item["title"], short_path(os.path.dirname(path) if os.path.isfile(path) else path),
                        " (%s)" % note if note else ""), 15)
        return False

    def busy_downloads(self):
        return [j for j in self.jobs.values()
                if j["stage"] in ("queued", "checking", "connect", "download", "unpack")]

    def on_destroy(self, *_):
        with contextlib.suppress(Exception):    # leaving must never fail
            self.clean_logs()
        Gtk.main_quit()

    def clean_logs(self):
        """Logs are only for looking at the run that just happened, so they go when shelf
        closes and never pile up. Games still running keep theirs: the next shelf reads the
        game log's time to count a run that ended while no shelf was open."""
        held = held_locks()
        busy = {g.get("profile") for g in self.lib.games
                if g["id"] in self.procs or profile_running(g.get("profile"), held)}
        busy_ids = set(self.procs) | {g["id"] for g in self.lib.games if g.get("profile") in busy}
        with contextlib.suppress(OSError):
            for n in os.listdir(LOGS):
                if n.endswith(".log") and n[:-4] not in busy_ids:
                    with contextlib.suppress(OSError):
                        os.unlink(os.path.join(LOGS, n))
        for prof in {g.get("profile") for g in self.lib.games} - busy - {None, ""}:
            for n in ("last.log", "display.log", "audio.log"):
                with contextlib.suppress(OSError):
                    os.unlink(os.path.join(GOM_DATA, prof, n))

    def on_delete(self, *_):
        busy = self.busy_downloads()
        if busy and not ask(self, "%d download%s still running." % (len(busy), "" if len(busy) == 1 else "s"),
                            "Quit anyway? Installing the same game again later continues the download "
                            "where it stopped."):
            return True
        self.save_settings()
        return False

    # -------------------------------------------------- playing

    def profile_home(self, gid):
        g = self.lib.get(gid) or {}
        return os.path.join(GOM_DATA, g.get("profile") or "", "home")

    def play(self, gid, path=None, checked=False):
        g = self.lib.get(gid)
        if not g:
            return
        if gid in self.procs:
            self.say("%s is already running." % g["title"])
            return
        if gid in self.elsewhere or gid in self.adopted or profile_running(g.get("profile"), held_locks()):
            self.say("%s is already running: its gom profile “%s” is in use."
                     % (g["title"], g.get("profile")), 10, error=True)
            return
        target = path or g["path"]
        if not os.path.exists(target):
            self.say("%s is not at %s any more. Edit the game and point it at the new place."
                     % (g["title"], short_path(target)), 20, error=True)
            return
        if path is None and os.path.isdir(target):
            target = self.resolve_launcher(g)
            if not target:
                return
            g = self.lib.get(gid)
        if not checked and not self.deps_known_ok(g, target):
            self.say("Checking what %s needs…" % g["title"])
            folder = game_dir(target)

            def check():
                missing = missing_libs(folder)
                return missing, (describe_missing(missing) if missing else None)
            spawn(check, lambda res, err: self.after_deps(gid, path, target, res, err))
            return
        cmd = gom_command(self.gom, g, path=target)
        try:
            with open(os.path.join(LOGS, gid + ".log"), "w", encoding="utf-8") as log:
                log.write("$ %s\n" % shlex.join(cmd))
                log.flush()
                p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True, env=gom_environ(g))
        except OSError as e:
            self.say("Could not start gom (%s): %s" % (self.gom, e), 20, error=True)
            return
        start = time.time()
        self.procs[gid] = {"p": p, "start": start, "stopping": False}
        self.lib.update(gid, last_played=int(start), session={"start": start, "owner": os.getpid()})
        self.sizes.pop(gid, None)
        self.refresh(gid)
        self.say("Starting %s…" % g["title"])
        threading.Thread(target=lambda: (p.wait(), GLib.idle_add(self.on_proc_exit, gid)),
                         daemon=True).start()

    def deps_known_ok(self, g, target):
        try:
            return g.get("deps_ok") == os.stat(game_dir(target)).st_mtime_ns
        except OSError:
            return True

    def after_deps(self, gid, path, target, res, err):
        """The library check is back: start the game, or say what is missing first."""
        g = self.lib.get(gid)
        if g is None:
            return
        if err or not res or not res[0]:
            with contextlib.suppress(OSError):
                self.lib.update(gid, deps_ok=os.stat(game_dir(target)).st_mtime_ns)
            self.play(gid, path, checked=True)
            return
        libs, hint = res[1]
        if self.ask_missing(g, libs, hint):
            self.play(gid, path, checked=True)

    def ask_missing(self, g, libs, hint):
        text = "%s needs libraries your system does not have: %s." % (g["title"], libs)
        if hint:
            text += "\n\nOn %s, install them with:\n%s" % (distro()[1], hint)
        else:
            text += "\n\nshelf could not tell which packages have them on %s." % distro()[1]
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE, text="Missing libraries",
                              secondary_text=text)
        if hint:
            d.add_button("Copy the command", 2)
        d.add_button("Start anyway", 1)
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        for lab_ in d.get_message_area().get_children():
            if isinstance(lab_, Gtk.Label):
                lab_.set_selectable(True)
        r = d.run()
        d.destroy()
        if r == 2:
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(hint, -1)
            self.say("Copied: %s. Run it in a terminal, then start the game again." % hint, 15)
        return r == 1

    def resolve_launcher(self, g):
        """Path to hand gom for a game folder, asking when gom can't decide. None: don't start."""
        state, names = gom_launchers(self.gom, g["path"])
        if state == "none":
            self.say("gom finds nothing to start in %s. Edit “%s” and pick its program."
                     % (short_path(g["path"]), g["title"]), 20, error=True)
            return None
        if state == "choose":
            chosen = pick_one(self, "Which program starts %s?" % g["title"],
                              "gom found several in %s. shelf remembers your choice; "
                              "Edit changes it later." % short_path(g["path"]), names)
            if not chosen:
                return None
            path = os.path.join(g["path"], chosen)
            self.lib.update(g["id"], path=path)
            self.refresh(g["id"])
            return path
        return g["path"]

    def on_proc_exit(self, gid):
        run = self.procs.pop(gid, None)
        if run is None:
            return False
        end, rc = time.time(), run["p"].returncode
        info = parse_run_log(read_tail(os.path.join(LOGS, gid + ".log"), 256 * 1024) or "")
        g = self.lib.get(gid)
        if g is None:
            return False
        if (not info["started"] and not run["stopping"] and os.path.isdir(g["path"])
                and any("several launchers" in e for e in info["errors"])):
            self.lib.update(gid, session=None)     # the folder changed since: ask, then start
            self.refresh(gid)
            self.play(gid)
            return False
        error = info["errors"][-1] if info["errors"] else None
        g = self.lib.change(gid, lambda x: book_run(x, run["start"], end, info["started"], rc, error))
        self.sizes.pop(gid, None)
        self.refresh(gid)
        if g is None:
            return False
        if not info["started"]:
            self.say("%s did not start: %s" % (g["title"], error or "gom exited with code %s. "
                                               "Ctrl+L shows the log." % rc), 30, error=True)
        elif g.get("last_error"):
            why = diagnose_game_log(read_tail(os.path.join(GOM_DATA, g.get("profile") or "", "last.log"),
                                              64 * 1024) or "")
            if why:
                self.lib.update(gid, last_error="The game quit right away: %s." % why, deps_ok=None)
                self.refresh(gid)
            self.say("%s quit right away: %s." % (g["title"], why) if why else
                     "%s quit right away (exit code %s). Ctrl+L shows the log." % (g["title"], rc),
                     30, error=True)
        else:
            self.say("%s closed after %s." % (g["title"], fmt_long_duration(end - run["start"])))
            self.offer_installed(gid, info["installed"])
        return False

    def offer_installed(self, gid, reported):
        """After an installer ran: offer to start what it installed from now on."""
        g = self.lib.get(gid)
        if not g or not g.get("profile"):
            return
        home = os.path.join(GOM_DATA, g["profile"], "home")
        if g["path"].startswith(home + os.sep):
            return
        # gom lists only new folders that hold something runnable, so a save folder the game
        # made in its home never counts as "installed"
        new = [p for p in reported if os.path.isdir(p)]
        if not new:
            return
        if len(new) == 1:
            target = new[0] if ask(self, "%s installed a game into its profile." % g["title"],
                                   "Start %s from now on?" % short_path(new[0])) else None
        else:
            labels = [short_path(p) for p in new]
            pick = pick_one(self, "Which folder is the game?",
                            "The installer made several folders in the profile's private home.",
                            labels, ok_label="Start this one from now on")
            target = new[labels.index(pick)] if pick else None
        if target:
            self.lib.update(gid, path=target, last_error=None)
            self.refresh(gid)
            self.say("%s now starts the installed game." % g["title"])

    def stop(self, gid):
        run = self.procs.get(gid)
        if not run:
            self.say("Only games started from this window can be stopped here.")
            return
        run["stopping"] = True
        p = run["p"]
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.killpg(p.pid, signal.SIGTERM)       # gom traps TERM and takes the cages down
        title = self.lib.get(gid)["title"]
        self.say("Stopping %s…" % title)

        def force():
            if self.procs.get(gid, {}).get("p") is p:
                with contextlib.suppress(ProcessLookupError, PermissionError):
                    os.killpg(p.pid, signal.SIGKILL)
                self.say("%s did not stop within 10 seconds, so shelf killed it." % title, 12, error=True)
            return False
        GLib.timeout_add_seconds(10, force)

    def poll(self):
        """Every few seconds: which gom profiles are busy, and runs a closed shelf left behind."""
        held, now = held_locks(), time.time()
        for g in list(self.lib.games):
            gid = g["id"]
            if gid in self.procs:
                continue
            busy = profile_running(g.get("profile"), held)
            if gid in self.adopted:
                if not busy:
                    start = self.adopted.pop(gid)
                    self.lib.change(gid, lambda x, s=start: book_run(x, s, now, True, None))
                    self.sizes.pop(gid, None)
                    self.refresh(gid)
                continue
            sess = g.get("session")
            if isinstance(sess, dict) and not shelf_alive(sess.get("owner")):
                if busy and self.adopt(gid, sess):
                    self.elsewhere.discard(gid)
                    self.refresh(gid)
                    continue
                if not busy:
                    end = self.guess_end(g, sess.get("start") or now)
                    self.lib.change(gid, lambda x, s=sess, e=end: book_run(
                        x, s.get("start") or e, e, True, None, approx=True)
                        if x.get("session") == s else None)
                    self.refresh(gid)
                    continue
            if busy != (gid in self.elsewhere):
                (self.elsewhere.add if busy else self.elsewhere.discard)(gid)
                self.refresh(gid)
        return True

    def adopt(self, gid, sess):
        """Take over counting a run whose shelf is gone. The check and the takeover happen under
        the library lock, so two windows never both count it."""
        mine = os.getpid()

        def take(x):
            cur = x.get("session")
            if isinstance(cur, dict) and cur.get("start") == sess.get("start") \
                    and not shelf_alive(cur.get("owner")):
                cur["owner"] = mine
        g = self.lib.change(gid, take)
        if g and (g.get("session") or {}).get("owner") == mine:
            self.adopted[gid] = sess.get("start") or time.time()
            return True
        return False

    def guess_end(self, g, start):
        """A run that ended while no shelf watched: its game log was written last near the end."""
        try:
            m = os.stat(os.path.join(GOM_DATA, g.get("profile") or "", "last.log")).st_mtime
        except OSError:
            m = start
        return min(time.time(), max(start, m))

    def on_library_changed(self):
        if self.monitor_job:
            GLib.source_remove(self.monitor_job)
        self.monitor_job = GLib.timeout_add(300, self.reload_library)

    def reload_library(self):
        self.monitor_job = 0
        if self.lib.reload():
            self.sync_cards()
        return False

    # -------------------------------------------------- covers

    def queue_auto_covers(self):
        if not self.online():
            return
        for g in self.lib.games:
            if not g.get("cover") and not g.get("cover_lookup") and g["id"] not in self.covers.pending:
                self.covers.want(g["id"], g["title"])
                self.refresh(g["id"])

    def on_auto_cover(self, gid, path, source, answered):
        try:
            g = self.lib.get(gid)
            if g is None:
                return
            if path and not g.get("cover"):
                self.set_cover(gid, path, untrusted=True, quiet=True)
            if answered:
                self.lib.update(gid, cover_lookup="%s, %s" % (source or "nothing found", date.today()))
                if not path and g.get("archive_logo") and not g.get("cover"):
                    self.cover_from_url(gid, g["archive_logo"])
            elif not self.net_warned:
                self.net_warned = True
                self.say("Steam and Wikipedia could not be reached. shelf looks for the covers again "
                         "next time.")
        finally:
            if path:
                with contextlib.suppress(OSError):
                    os.unlink(path)
            self.refresh(gid)

    def set_cover(self, gid, src, untrusted=False, quiet=False):
        try:
            name = import_cover(src, gid, untrusted)
        except (GLib.Error, ValueError, OSError) as e:
            if not quiet:
                self.say("That image can't be used: %s" % getattr(e, "message", e), 12, error=True)
            return False
        old = []

        def put(x):
            old.append(x.get("cover"))
            x["cover"] = name
        g = self.lib.change(gid, put)
        drop = name if g is None else (old[0] if old and old[0] != name else None)
        if drop:                                   # the replaced cover, or ours if the game is gone
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(COVERS, drop))
        self.refresh(gid)
        return g is not None

    def choose_cover(self, gid):
        g = self.lib.get(gid)
        path, is_temp = CoverDialog(self, g["title"], self.online()).choose()
        if path:
            if self.set_cover(gid, path, untrusted=is_temp):
                self.say("New cover for %s." % g["title"])
            if is_temp:
                with contextlib.suppress(OSError):
                    os.unlink(path)

    def cover_from_url(self, gid, url):
        g = self.lib.get(gid)
        self.say("Downloading a cover for %s…" % g["title"])

        def done(path, err):
            if err or not path:
                self.say("That picture could not be used: %s" % err, 12, error=True)
                return
            if self.set_cover(gid, path, untrusted=True):
                self.say("New cover for %s." % g["title"])
            with contextlib.suppress(OSError):
                os.unlink(path)
        spawn(download_image, done, url)


    # -------------------------------------------------- library actions

    EDIT_KEYS = ("title", "path", "profile", "windowed", "grab", "mute", "res", "args", "env",
                 "gamescope", "tags", "notes")

    def taken(self):
        return {game_dir(g["path"]): g["title"] for g in self.lib.games}

    def add_game(self, path=None):
        d = GameDialog(self, self.gom, self.online(), path=path, taken=self.taken())
        if d.run() == Gtk.ResponseType.OK:
            with self.lib.edit():
                g = self.lib.add({k: d.game[k] for k in self.EDIT_KEYS})
            self.add_card(g)
            if d.cover:
                self.set_cover(g["id"], d.cover[0], untrusted=d.cover[1])
            elif self.online():
                self.covers.want(g["id"], g["title"])
            self.refresh(g["id"])
            self.apply_view()
            self.select(g["id"])
            self.say("Added %s." % g["title"])
        d.destroy()

    def add_many(self, paths):
        self.import_games(paths=paths)

    def edit(self, gid):
        g = self.lib.get(gid)
        if not g:
            return
        d = GameDialog(self, self.gom, self.online(), game=g)
        if d.run() == Gtk.ResponseType.OK:
            new = {k: d.game[k] for k in self.EDIT_KEYS}

            def apply(x):
                if new["path"] != x["path"]:
                    x["last_error"] = None
                if new["title"] != x["title"] and not x.get("cover"):
                    x.pop("cover_lookup", None)        # a new title deserves a new lookup
                x.update(new)
            self.lib.change(gid, apply)
            if d.cover:
                self.set_cover(gid, d.cover[0], untrusted=d.cover[1])
            elif d.drop_cover and g.get("cover"):
                old = g["cover"]
                self.lib.update(gid, cover=None, cover_lookup="removed by hand, %s" % date.today())
                with contextlib.suppress(OSError):
                    os.unlink(os.path.join(COVERS, old))
            self.sizes.pop(gid, None)
            self.queue_auto_covers()
            self.refresh(gid)
        d.destroy()

    def remove(self, gid):
        g = self.lib.get(gid)
        if not g:
            return
        if gid in self.procs or gid in self.elsewhere or gid in self.adopted:
            self.say("%s is running. Stop it first." % g["title"])
            return
        shared = any(x["id"] != gid and x.get("profile") == g.get("profile") for x in self.lib.games)
        root = self.installed_root(g)
        ok, wipe, wipe_files = confirm_remove(self, g, shared, root)
        if not ok:
            return
        if wipe:
            r = subprocess.run([self.gom, "--reset", g["profile"]], stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, check=False)
            if r.returncode != 0:
                self.say("The profile was not deleted: %s" % (r.stderr.strip() or r.returncode),
                         20, error=True)
                return
        if wipe_files and root:                     # big games take a while: not on the UI thread
            spawn(lambda: shutil.rmtree(root, ignore_errors=True), lambda *_: None)
        with self.lib.edit():
            self.lib.delete(gid)
        for f in ([os.path.join(COVERS, g["cover"])] if g.get("cover") else []) + \
                [os.path.join(LOGS, gid + ".log")]:
            with contextlib.suppress(OSError):
                os.unlink(f)
        self.flow.remove(self.cards.pop(gid))
        self.sizes.pop(gid, None)
        self.apply_view()
        self.update_details()
        self.refresh_archive()
        self.say("Removed %s%s%s." % (g["title"], " and its gom profile" if wipe else "",
                                      " and its files" if wipe_files and root else ""))

    def installed_root(self, g):
        """The folder shelf unpacked an archive game into, if it is safe to delete: a real
        folder directly inside the games folder that no other game on the shelf uses."""
        if not g.get("archive"):
            return None
        games = os.path.realpath(self.games_dir())
        rel = os.path.relpath(os.path.realpath(g["path"]), games)
        if rel.startswith("..") or rel == ".":
            return None
        root = os.path.join(games, rel.split(os.sep)[0])
        if os.path.islink(root) or not os.path.isdir(root) or os.path.realpath(root) == games:
            return None
        if any(x["id"] != g["id"] and (os.path.realpath(x["path"]) + os.sep).startswith(root + os.sep)
               for x in self.lib.games):
            return None
        return root

    def toggle(self, gid, key):
        g = self.lib.change(gid, lambda x: x.__setitem__(key, not x.get(key)))
        if not g:
            return
        self.refresh(gid)
        if key == "hidden":
            self.say("%s is hidden now; the Hidden tab shows it." % g["title"] if g["hidden"]
                     else "%s is back in the library." % g["title"])

    def import_games(self, paths=None):
        folder = None
        if not paths:
            folder = next((p for p in (os.path.join(HOME, "Games"), os.path.join(HOME, "games"))
                           if os.path.isdir(p)), None)
        d = ImportDialog(self, self.gom, self.taken(), folder, paths)
        if d.run() == Gtk.ResponseType.OK:
            chosen = d.chosen()
            with self.lib.edit():
                added = [self.lib.add(c) for c in chosen]
            for g in added:
                self.add_card(g)
            self.queue_auto_covers()
            self.refresh_all()
            self.apply_view()
            if added:
                self.select(added[0]["id"])
            self.say("Imported %d game%s.%s" % (len(added), "" if len(added) == 1 else "s",
                                                " Covers are being looked up." if self.online() else ""))
        d.destroy()

    def show_log(self, gid):
        g = self.lib.get(gid)
        if not g:
            return
        prof = os.path.join(GOM_DATA, g.get("profile") or "")
        LogDialog(self, g["title"], [
            ("gom", os.path.join(LOGS, gid + ".log"), "what gom said the last time shelf started it"),
            ("game", os.path.join(prof, "last.log"), "the game's own output from its last run"),
            ("display", os.path.join(prof, "display.log"), "gamescope"),
            ("audio", os.path.join(prof, "audio.log"), "the private sound server")]).run_loop()

    def check_deps(self, gid):
        g = self.lib.get(gid)
        self.say("Checking what %s needs…" % g["title"])
        folder = game_dir(g["path"])

        def check():
            missing = missing_libs(folder)
            return missing, (describe_missing(missing) if missing else None)

        def done(res, err):
            if err or not res or not res[0]:
                self.say("%s: every library its programs need is there." % g["title"])
                return
            self.lib.update(gid, deps_ok=None)
            self.ask_missing(g, *res[1])
        spawn(check, done)

    def sandbox_shell(self, gid):
        g = self.lib.get(gid)
        term = find_terminal()
        if not term:
            self.say("No terminal found. Set $TERMINAL, or run: gom --shell %s" % shlex.quote(g["path"]))
            return
        cmd = gom_command(self.gom, dict(g, args=""))
        cmd.insert(1, "--shell")
        try:
            subprocess.Popen(term + cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True, env=gom_environ(g))
        except OSError as e:
            self.say("Could not open a terminal: %s" % e, 12, error=True)

    def random_game(self):
        if self.settings["view"] == "archive":
            kids = [c for c in self.aflow.get_children() if c.get_child_visible()]
            if kids:
                c = random.choice(kids)
                self.aflow.select_child(c)
                GLib.idle_add(lambda: c.grab_focus() and False)
            return
        cards = self.visible_cards()
        if cards:
            self.select(random.choice(cards).gid)

    def open_path(self, path):
        if not os.path.exists(path):
            self.say("Not there yet: %s" % short_path(path))
            return
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(path), None)
        except GLib.Error as e:
            self.say("Could not open %s: %s" % (short_path(path), e.message), 12, error=True)

    def game_menu(self, gid):
        g = self.lib.get(gid)
        running = gid in self.procs
        folder = g["path"] if os.path.isdir(g["path"]) else os.path.dirname(g["path"])
        m = Gtk.Menu()

        def item(text, fn, sensitive=True, menu=m):
            mi = Gtk.MenuItem(label=text)
            mi.set_sensitive(sensitive)
            mi.connect("activate", lambda _w: fn())
            menu.append(mi)
            return mi

        busy = gid in self.elsewhere or gid in self.adopted
        if running:
            item("Stop", lambda: self.stop(gid))
        else:
            item("Play", lambda: self.play(gid), not busy)
        _state, names = gom_launchers(self.gom, folder) if os.path.isdir(folder) else ("none", [])
        current = None if os.path.isdir(g["path"]) else os.path.basename(g["path"])
        others = [n for n in names if n != current] if len(names) > 1 else []
        if others:
            sub = Gtk.Menu()
            for n in others:
                item(n, lambda n=n: self.play(gid, os.path.join(folder, n)), not (running or busy), sub)
            mi = Gtk.MenuItem(label="Start another program")
            mi.set_submenu(sub)
            m.append(mi)
        m.append(Gtk.SeparatorMenuItem())
        item("Edit…", lambda: self.edit(gid))
        item("Choose a cover…", lambda: self.choose_cover(gid))
        item("Remove from favorites" if g.get("favorite") else "Add to favorites",
             lambda: self.toggle(gid, "favorite"))
        item("Show in the library again" if g.get("hidden") else "Hide", lambda: self.toggle(gid, "hidden"))
        m.append(Gtk.SeparatorMenuItem())
        item("Open saves", lambda: self.open_path(self.profile_home(gid)))
        item("Open game folder", lambda: self.open_path(folder))
        item("Show logs", lambda: self.show_log(gid))
        item("Check what it needs", lambda: self.check_deps(gid))
        item("Open a shell in the sandbox", lambda: self.sandbox_shell(gid), not (running or busy))
        m.append(Gtk.SeparatorMenuItem())
        item("Remove from shelf…", lambda: self.remove(gid))
        m.attach_to_widget(self, None)
        m.show_all()
        return m

    # -------------------------------------------------- input

    def on_button(self, flow, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS or ev.button != 3:
            return False
        card = flow.get_child_at_pos(int(ev.x), int(ev.y))
        if not card:
            return False
        flow.select_child(card)
        self.game_menu(card.gid).popup_at_pointer(ev)
        return True

    def on_scroll(self, _w, ev):
        if not ev.state & Gdk.ModifierType.CONTROL_MASK:
            return False
        ok, _dx, dy = ev.get_scroll_deltas()
        up = ev.direction == Gdk.ScrollDirection.UP or (ok and dy < 0)
        down = ev.direction == Gdk.ScrollDirection.DOWN or (ok and dy > 0)
        if up or down:
            self.set_zoom(1 if up else -1)
        return True

    def on_drop(self, w, _ctx, x, y, data, _info, _time):
        items = data.get_uris() or [ln.strip() for ln in (data.get_text() or "").splitlines()]
        paths, urls = [], []
        for it in filter(None, items):
            if it.startswith("file://"):
                p = uri_to_path(it)
                if p:
                    paths.append(p)
            elif it.startswith(("http://", "https://")):
                urls.append(it)
            elif it.startswith("/"):
                paths.append(it)
        card = None
        if w is self.scroll:
            xy = w.translate_coordinates(self.flow, x, y)
            card = self.flow.get_child_at_pos(*xy) if xy else None
        if card:
            img = next((p for p in paths if os.path.isfile(p) and image_size(p)), None)
            if img:
                if self.set_cover(card.gid, img):
                    self.say("New cover for %s." % self.lib.get(card.gid)["title"])
                return
            if urls and not paths:
                self.cover_from_url(card.gid, urls[0])
                return
        games = [p for p in paths if os.path.exists(p) and not (os.path.isfile(p) and image_size(p))]
        if len(games) == 1:
            self.add_game(games[0])
        elif games:
            self.add_many(games)
        elif urls or paths:
            self.say("Drop a picture on a game to make it the cover, or drop game folders to add them.")

    def on_search_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.search.set_text("")
            self.focus_grid()
            return True
        if ev.keyval in (Gdk.KEY_Down, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.focus_grid()
            return True
        return False

    def focus_grid(self):
        if self.settings["view"] == "archive":
            kids = [c for c in self.aflow.get_children() if c.get_child_visible()]
            if kids:
                sel = self.aflow.get_selected_children()
                target = sel[0] if sel and sel[0] in kids else min(
                    kids, key=lambda c: (c.get_allocation().y, c.get_allocation().x))
                self.aflow.select_child(target)
                target.grab_focus()
            return
        cards = self.visible_cards()
        if not cards:
            return
        sel = self.flow.get_selected_children()
        target = sel[0] if sel and sel[0] in cards else cards[0]
        self.flow.select_child(target)
        target.grab_focus()

    def on_key(self, _w, ev):
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        k = Gdk.keyval_to_lower(ev.keyval)
        gid = self.selected()
        tabs = {Gdk.KEY_1: 0, Gdk.KEY_2: 1, Gdk.KEY_3: 2, Gdk.KEY_4: 3, Gdk.KEY_5: 4}
        archive = self.settings["view"] == "archive"
        if archive:
            gid = None
        if ctrl and archive and k in tabs and tabs[k] < len(self.ARCHIVE_TABS):
            self.set_archive_opt("archive_tab", self.ARCHIVE_TABS[tabs[k]][0])
            return True
        if ctrl and k == Gdk.KEY_Tab:
            self.set_view("library" if archive else "archive")
            return True
        if ctrl:
            simple = {Gdk.KEY_q: lambda: (self.save_settings(), self.destroy()),
                      Gdk.KEY_n: self.add_game, Gdk.KEY_o: self.import_games,
                      Gdk.KEY_f: self.search.grab_focus, Gdk.KEY_r: self.random_game,
                      Gdk.KEY_i: lambda: self.set_details(not self.settings["details"]),
                      Gdk.KEY_plus: lambda: self.set_zoom(1), Gdk.KEY_equal: lambda: self.set_zoom(1),
                      Gdk.KEY_KP_Add: lambda: self.set_zoom(1), Gdk.KEY_minus: lambda: self.set_zoom(-1),
                      Gdk.KEY_KP_Subtract: lambda: self.set_zoom(-1)}
            per_game = {Gdk.KEY_d: lambda: self.toggle(gid, "favorite"),
                        Gdk.KEY_h: lambda: self.toggle(gid, "hidden"),
                        Gdk.KEY_l: lambda: self.show_log(gid)}
            if k in simple:
                simple[k]()
                return True
            if k in per_game and gid:
                per_game[k]()
                return True
            if k in tabs:
                self.set_tab(TABS[tabs[k]][0])
                return True
            return False
        if k == Gdk.KEY_F1:
            show_keys(self)
        elif k == Gdk.KEY_F11:
            (self.unfullscreen if self.fullscreen_on else self.fullscreen)()
        elif self.search.has_focus():
            return False
        elif k == Gdk.KEY_F2 and gid:
            self.edit(gid)
        elif k == Gdk.KEY_Delete and gid:
            self.remove(gid)
        elif k == Gdk.KEY_Menu and gid:
            self.game_menu(gid).popup_at_widget(self.cards[gid], Gdk.Gravity.CENTER,
                                                Gdk.Gravity.NORTH_WEST, ev)
        elif Gdk.keyval_to_unicode(ev.keyval) > 32 and not ev.state & Gdk.ModifierType.MOD1_MASK:
            self.search.grab_focus_without_selecting()
            return self.search.handle_event(ev)
        else:
            return False
        return True


# ------------------------------------------------------------------ command line

USAGE = """usage: shelf [--list | --run TITLE]

  shelf               open the library window
  shelf --list        print the titles, most recently played first
  shelf --run TITLE   start a game through gom and count its play time; TITLE may be
                      the start of a title or any unique part of it

With dmenu:  shelf --run "$(shelf --list | dmenu -i -p play)"

Library, covers and logs live in %s.
Covers are looked up online once per game (Steam, then Wikipedia; only the title is sent).
SHELF_OFFLINE=1 turns that off. GOM=/path/to/gom picks the gom to use.
""" % short_path(SHELF)


def cli_list():
    lib = Library()
    for g in sorted((g for g in lib.games if not g.get("hidden")),
                    key=lambda g: (-(g.get("last_played") or 0), sort_key(g["title"]))):
        print(g["title"])
    return 0


def cli_run(name):
    lib = Library()
    hits = lib.find(name)
    if len(hits) != 1:
        print("shelf: %s" % ("no game matches “%s”" % name if not hits else "“%s” matches %d games: %s"
                             % (name, len(hits), ", ".join(g["title"] for g in hits[:8]))), file=sys.stderr)
        return 2
    g, gom = hits[0], find_gom()
    gid = g["id"]
    if profile_running(g.get("profile"), held_locks()):
        print("shelf: %s is already running" % g["title"], file=sys.stderr)
        return 1
    if not os.path.exists(g["path"]):
        print("shelf: %s is not at %s any more" % (g["title"], g["path"]), file=sys.stderr)
        return 1
    if os.path.isdir(g["path"]):
        state, names = gom_launchers(gom, g["path"])
        if state == "none":
            print("shelf: gom finds nothing to start in %s" % g["path"], file=sys.stderr)
            return 4
        if state == "choose":
            print("shelf: several programs in %s (%s); pick one in the shelf window"
                  % (g["path"], ", ".join(names)), file=sys.stderr)
            return 3
    missing = missing_libs(game_dir(g["path"]))
    if missing:
        libs, hint = describe_missing(missing)
        print("shelf: warning: %s needs libraries your system does not have: %s%s"
              % (g["title"], libs, "\n       install them with: " + hint if hint else ""), file=sys.stderr)
    cmd = gom_command(gom, g)
    start = time.time()
    lib.update(gid, last_played=int(start), session={"start": start, "owner": os.getpid()})
    lines, rc = [], None
    with open(os.path.join(LOGS, gid + ".log"), "w", encoding="utf-8") as log:
        log.write("$ %s\n" % shlex.join(cmd))
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                                 errors="replace", env=gom_environ(g))
        except OSError as e:
            why = str(e)
            lib.change(gid, lambda x: book_run(x, start, time.time(), False, None, why))
            print("shelf: could not start gom: %s" % why, file=sys.stderr)
            return 1
        signal.signal(signal.SIGINT, signal.SIG_IGN)    # Ctrl+C is for gom; we wait and book the run
        for line in p.stderr:
            sys.stderr.write(line)
            log.write(line)
            lines.append(line)
        rc = p.wait()
    info = parse_run_log("".join(lines))
    error = info["errors"][-1] if info["errors"] else None
    end = time.time()
    lib.change(gid, lambda x: book_run(x, start, end, info["started"], rc, error))
    if info["started"]:
        print("shelf: %s ran for %s" % (g["title"], fmt_long_duration(end - start)), file=sys.stderr)
    for made in info["installed"]:
        print("shelf: the installer made %s; open shelf to start it from now on" % made, file=sys.stderr)
    return rc


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        return 0
    if argv and argv[0] in ("-l", "--list"):
        return cli_list()
    if argv and argv[0] == "--icon":
        if len(argv) < 2:
            print("usage: shelf --icon FILE.png [SIZE]", file=sys.stderr)
            return 2
        shelf_icon(int(argv[2]) if len(argv) > 2 else 256).savev(argv[1], "png", [], [])
        return 0
    if argv and argv[0] in ("-r", "--run"):
        if len(argv) < 2 or not " ".join(argv[1:]).strip():
            print(USAGE, end="", file=sys.stderr)
            return 2
        return cli_run(" ".join(argv[1:]))
    if argv:
        print(USAGE, end="", file=sys.stderr)
        return 2
    GLib.set_prgname("shelf")
    GLib.set_application_name("shelf")
    Shelf()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
