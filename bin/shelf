LOGS = os.path.join(SHELF, "logs")
GOM_DATA = os.path.join(DATA_HOME, "gom")
ENV_OFFLINE = os.environ.get("SHELF_OFFLINE") == "1"

COVER_W, COVER_H = 600, 900                  # stored covers: 2:3 like box art, JPEG
ZOOMS = (140, 170, 200, 240, 280, 320)       # card widths; height is 1.5x
PROFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
ENV_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
RES_RE = re.compile(r"^[0-9]{3,5}x[0-9]{3,5}$")
GENERIC_DIRS = {"game", "games", "bin", "data", "linux", "linux64", "x86_64", "x64", "files", "app"}
UA = "shelf/1.0 (game library for the gom sandbox)"
MAX_DOWNLOAD = 12 * 1024 * 1024
MAX_PIXELS = 40_000_000                      # refuse decompression bombs before decoding
QUICK_EXIT = 10                              # seconds; a game that dies faster "quit right away"

TABS = (("all", "All"), ("favorites", "Favorites"), ("recent", "Recent"),
        ("unplayed", "Not played"), ("hidden", "Hidden"))
SORTS = (("name", "Name"), ("played", "Last played"), ("playtime", "Play time"),
         ("added", "Recently added"))

