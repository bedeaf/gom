#!/usr/bin/env bash
# gom: run untrusted native Linux games at full speed inside a layered sandbox.
#
# One run = three separate bubblewrap cages, none of which can see your home directory:
#   display cage : gamescope + its private Xwayland. The only process that talks to the host X server.
#   audio cage   : private PulseAudio. Playback-only tunnel to the host server; no sound card,
#                  no microphone, module loading disabled.
#   game cage    : the game. Sees only the Xwayland socket, the private audio socket, a read-only
#                  view of the game (changes go to an overlay) and its own private home directory.
#                  No network, no host X, no D-Bus, seccomp + Landlock + no_new_privs on top.
set -euo pipefail
shopt -s nullglob

GOM_ROOT=$(dirname -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")")
LOCK_BIN=$GOM_ROOT/build/gom-lock
DATA=${XDG_DATA_HOME:-$HOME/.local/share}/gom
MY_UID=$(id -u)
MY_GID=$(id -g)
GUEST_HOME=/home/player
GAME_MNT=/game
LOCK_MNT=/opt/gom/lock

NAME='' AUDIO=1 WINDOWED=0 GAME_RES='' GRAB=0 DIRECT_X=0 SHELL_MODE=0 VERBOSE=0 DRYRUN=0
BACKEND=sdl SELFTEST=0 RESET='' LIST=0
RUN='' DISPLAY_PID='' AUDIO_PID='' PACAT_PID='' GAME_PID='' XNUM='' SHELL_RC=0
declare -a GAME_ARGS=()

die()  { printf 'gom: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'gom: warning: %s\n' "$*" >&2; }
info() { printf 'gom: %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
usage: gom [options] GAME [-- GAME_ARGS...]

GAME is a game directory (launcher auto-detected) or the launcher itself
(ELF binary or .sh script). The whole directory containing it is visible to the game.

options:
  -n, --name NAME      profile name (default: derived from the game directory)
  -m, --mute           no audio at all
  -w, --windowed       windowed instead of fullscreen
  -r, --res WxH        game resolution (default: your screen resolution)
  -g, --grab           always use relative mouse mode (FPS games)
      --shell          open a shell inside the game cage instead of the game (debugging)
      --direct-x       UNSAFE: skip gamescope, give the game your real X server
                       (it could then log keystrokes and read other windows)
  -v, --verbose        show game output live (always saved to the profile's last.log)
      --dry-run        print the cage command lines and exit
      --list           list profiles
      --reset NAME     delete a profile (saves, settings, overlay changes)
      --selftest       run the attack simulation and verify every barrier
  -h, --help           this help

Profiles live in ${XDG_DATA_HOME:-~/.local/share}/gom/NAME/
  home/   the game's private $HOME (saves and settings usually land here)
  layer/  files the game wrote into its own directory (the original is never touched)

Gamescope keys: Super+F fullscreen, Super+G keyboard grab.
EOF
}

# ------------------------------------------------------------------ arguments

parse_args() {
    while (( $# )); do
        case $1 in
            -n|--name) NAME=${2:?--name needs a value}; shift ;;
            -m|--mute) AUDIO=0 ;;
            -w|--windowed) WINDOWED=1 ;;
            -r|--res) GAME_RES=${2:?--res needs WxH}; shift ;;
            -g|--grab) GRAB=1 ;;
            --shell) SHELL_MODE=1 ;;
            --direct-x) DIRECT_X=1 ;;
            -v|--verbose) VERBOSE=1 ;;
            --dry-run) DRYRUN=1 ;;
            --list) LIST=1 ;;
            --reset) RESET=${2:?--reset needs a profile name}; shift ;;
            --selftest) SELFTEST=1 ;;
            -h|--help) usage; exit 0 ;;
            --) shift; GAME_ARGS+=("$@"); break ;;
            -*) die "unknown option: $1 (see gom --help)" ;;
            *) if [[ -z ${TARGET-} ]]; then TARGET=$1; else GAME_ARGS+=("$1"); fi ;;
        esac
        shift
    done
    if [[ -n $GAME_RES && ! $GAME_RES =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]]; then die "--res must look like 1920x1080"; fi
    if [[ -n $NAME && ! $NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then die "invalid profile name: $NAME"; fi
}

# ------------------------------------------------------------------ setup

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found (install: $2)"; }

ensure_built() {
    local src
    for src in "$GOM_ROOT/src/lock.c" "$GOM_ROOT/src/denied-syscalls.txt" "$GOM_ROOT/src/gen-syscalls.sh"; do
        if [[ ! -x $LOCK_BIN || $src -nt $LOCK_BIN ]]; then
            info "building gom-lock..."
            make -s -C "$GOM_ROOT" build/gom-lock >&2 || die "build failed"
            return
        fi
    done
}

check_host() {
    need bwrap bubblewrap
    [[ -n ${XDG_RUNTIME_DIR-} && -d $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR is not set"
    if (( ! DIRECT_X )); then need gamescope gamescope; fi
    if (( AUDIO )); then
        if ! command -v pulseaudio >/dev/null 2>&1 || ! command -v pacat >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
            warn "pulseaudio/pacat/python3 missing, audio disabled"; AUDIO=0
        elif [[ ! -S $XDG_RUNTIME_DIR/pulse/native ]]; then warn "no host PulseAudio socket, audio disabled"; AUDIO=0
        fi
    fi
    bwrap --unshare-all --unshare-user --disable-userns --ro-bind / / true 2>/dev/null \
        || die "bubblewrap cannot create user namespaces on this system"
}

host_display_number() {
    local d=${DISPLAY-}
    [[ $d =~ ^(unix)?:([0-9]+)(\.[0-9]+)?$ ]] || die "DISPLAY='$d' is not a local X display"
    [[ -S /tmp/.X11-unix/X${BASH_REMATCH[2]} ]] || die "X socket /tmp/.X11-unix/X${BASH_REMATCH[2]} missing"
    printf '%s' "${BASH_REMATCH[2]}"
}

screen_res() {
    local r=''
    if command -v xrandr >/dev/null 2>&1; then
        r=$(xrandr --current 2>/dev/null | awk '/ connected primary/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, a, "+"); print a[1]; exit } }')
    fi
    if [[ -z $r ]] && command -v xdpyinfo >/dev/null 2>&1; then
        r=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print $2; exit }')
    fi
    printf '%s' "${r:-1920x1080}"
}

# ------------------------------------------------------------------ game resolution

is_elf() { [[ -f $1 ]] && [[ $(head -c 4 -- "$1" | od -An -tx1 | tr -d ' \n') == 7f454c46 ]]; }

detect_launcher() {
    local dir=$1 f
    local -a cands=()
    [[ -f $dir/start.sh ]] && { printf 'start.sh'; return; }           # GOG convention
    for f in "$dir"/*.sh; do [[ -f $f ]] && cands+=("${f##*/}"); done
    (( ${#cands[@]} == 1 )) && { printf '%s' "${cands[0]}"; return; }
    if (( ${#cands[@]} == 0 )); then
        for f in "$dir"/*; do is_elf "$f" && [[ -x $f ]] && cands+=("${f##*/}"); done
        (( ${#cands[@]} == 1 )) && { printf '%s' "${cands[0]}"; return; }
    fi
    if (( ${#cands[@]} == 0 )); then die "no launcher found in $dir; pass the binary or script explicitly"; fi
    die "several launchers in $dir: ${cands[*]}; pass one explicitly, e.g. gom '$dir/${cands[0]}'"
}

guard_dir() {
    local d=$1 h; h=$(readlink -f -- "$HOME")
    [[ $d != *$'\n'* ]] || die "path contains a newline"
    [[ $d != / ]] || die "refusing to expose /"
    [[ "$h/" != "$d/"* ]] || die "refusing to expose $d: it contains your home directory"
    case $d in
        "$h"/.ssh*|"$h"/.gnupg*|"$h"/.config|"$h"/.local|"$h"/.local/share|"$DATA"*)
            die "refusing to expose $d" ;;
        "$h"/Downloads|"$h"/Documents|"$h"/Desktop|"$h"/İndirilenler|"$h"/Belgeler|"$h"/Masaüstü)
            die "refusing to expose all of $d; put the game in its own folder" ;;
    esac
    local s
    for s in .ssh .gnupg .mozilla .librewolf .config/chromium; do
        [[ ! -e $d/$s ]] || die "refusing to expose $d: it looks like a home directory (has $s)"
    done
}

resolve_game() {
    local t; t=$(readlink -f -- "$1") || die "not found: $1"
    [[ -e $t ]] || die "not found: $1"
    if [[ -d $t ]]; then GAME_DIR=$t; LAUNCHER=$(detect_launcher "$t")
    else GAME_DIR=$(dirname -- "$t"); LAUNCHER=${t##*/}
    fi
    guard_dir "$GAME_DIR"
    if [[ -z $NAME ]]; then
        local base=${GAME_DIR##*/} parent
        parent=$(basename -- "$(dirname -- "$GAME_DIR")")
        case ${base,,} in game|games|bin|data|linux|linux64|x86_64|x64|files|app) base=$parent ;; esac
        NAME=$(printf '%s' "$base" | tr -c 'A-Za-z0-9._-' '_' | sed 's/^[._-]*//' | cut -c1-64)
        [[ -n $NAME ]] || NAME=game
    fi
}

# ------------------------------------------------------------------ cage building blocks

# Read-only system view shared by all cages: /usr plus the handful of /etc files programs need.
sys_fs() {
    local -n _a=$1
    local l f
    _a+=(--ro-bind /usr /usr)
    for l in /lib /lib64 /lib32 /bin /sbin; do
        if [[ -L $l ]]; then _a+=(--symlink "$(readlink -- "$l")" "$l")
        elif [[ -d $l ]]; then _a+=(--ro-bind "$l" "$l")
        fi
    done
    for f in /etc/ld.so.cache /etc/ld.so.conf /etc/ld.so.conf.d /etc/fonts /etc/localtime \
             /etc/os-release /etc/asound.conf /etc/alsa /etc/vdpau_wrapper.cfg /etc/vulkan /etc/drirc \
             /etc/nsswitch.conf /etc/locale.conf /etc/mime.types; do
        _a+=(--ro-bind-try "$f" "$f")
    done
    _a+=(--proc /proc --dev /dev --tmpfs /tmp --tmpfs /run --dir /var --tmpfs /var/tmp
         --ro-bind-data 3 /etc/passwd --ro-bind-data 4 /etc/group --ro-bind-data 5 /etc/machine-id
         --ro-bind "$LOCK_BIN" "$LOCK_MNT")
}

cage_base() {
    local -n _b=$1
    _b=(bwrap --die-with-parent --new-session --unshare-all --unshare-user --disable-userns --cap-drop ALL --hostname gom)
}

launch() {  # launch LOGFILE CMD... ; runs a cage in the background with the synthetic /etc files
    local log=$1; shift
    if (( DRYRUN )); then printf '%q ' "$@"; printf '\n\n'; return; fi
    "$@" 3<<<"player:x:$MY_UID:$MY_GID:player:$GUEST_HOME:/bin/sh" \
         4<<<"player:x:$MY_GID:" 5<<<"$MACHINE_ID" >"$log" 2>&1 &
}

# X cookies are bound to the hostname, which differs inside the cage. Write a copy of the
# cookie for this one display only, with the address family rewritten to "any host" (FamilyWild).
wild_xauth() {
    local src=${XAUTHORITY:-$HOME/.Xauthority}
    [[ -r $src ]] || return 1
    command -v xauth >/dev/null 2>&1 || { warn "xauth not found; X authorization may fail"; return 1; }
    : > "$RUN/xauth"; chmod 0600 -- "$RUN/xauth"
    xauth -f "$src" nlist ":$1" 2>/dev/null | sed -e 's/^..../ffff/' | xauth -f "$RUN/xauth" nmerge - 2>/dev/null
    [[ -s $RUN/xauth ]]
}

# ------------------------------------------------------------------ the three cages

start_display() {
    local hostnum res_out gw gh ow oh
    local -a c fs
    hostnum=$(host_display_number)
    res_out=$(screen_res); ow=${res_out%x*}; oh=${res_out#*x}
    local gr=${GAME_RES:-$res_out}; gw=${gr%x*}; gh=${gr#*x}
    install -d -m 0700 "$RUN/x11"
    cage_base c; fs=(); sys_fs fs
    # gamescope schedules its own compositor/frame-timing thread and warns without this;
    # scoped to the display cage only, the game and audio cages stay fully capless.
    c+=(--cap-add CAP_SYS_NICE)
    c+=("${fs[@]}" --ro-bind /sys /sys --dev-bind /dev/dri /dev/dri
        --bind "$RUN/x11" /tmp/.X11-unix
        --ro-bind "/tmp/.X11-unix/X$hostnum" "/tmp/.X11-unix/X$hostnum"
        --perms 0700 --dir "/run/user/$MY_UID")
    wild_xauth "$hostnum" && c+=(--ro-bind "$RUN/xauth" /run/xauth)
    c+=(--clearenv --setenv DISPLAY ":$hostnum" --setenv XAUTHORITY /run/xauth
        --setenv XDG_RUNTIME_DIR "/run/user/$MY_UID" --setenv HOME /tmp --setenv PATH /usr/bin
        --setenv LANG C.UTF-8
        -- "$LOCK_MNT" --quiet --nproc 1024 --write /tmp --write /run --write /dev --dev /dev --exec /usr
        -- gamescope --backend "$BACKEND" -W "$ow" -H "$oh" -w "$gw" -h "$gh" --xwayland-count 1)
    (( WINDOWED || SELFTEST )) || c+=(-f)
    (( GRAB )) && c+=(--force-grab-cursor)
    if [[ -n ${GOM_GAMESCOPE_ARGS-} ]]; then
        local -a extra; read -r -a extra <<<"$GOM_GAMESCOPE_ARGS"; c+=("${extra[@]}")
    fi
    c+=(-- sleep infinity)
    launch "$PROFILE/display.log" "${c[@]}"
    (( DRYRUN )) && { XNUM=1; return; }
    DISPLAY_PID=$!
    local i s
    for (( i = 0; i < 100; i++ )); do
        for s in "$RUN"/x11/X*; do
            [[ -S $s && ${s##*/X} != "$hostnum" ]] && { XNUM=${s##*/X}; return; }
        done
        kill -0 "$DISPLAY_PID" 2>/dev/null || break
        sleep 0.1
    done
    tail -n 15 "$PROFILE/display.log" >&2 || true
    die "gamescope did not start (log: $PROFILE/display.log)"
}

start_audio() {
    # The audio cage never touches the host sound server. Its PulseAudio renders into a FIFO,
    # and a host-side pacat (trusted, playback only) reads raw PCM from it. A fully compromised
    # audio cage can therefore do nothing but write sound samples into a pipe.
    local -a c fs
    install -d -m 0700 "$RUN/audio"
    cage_base c; fs=(); sys_fs fs
    c+=("${fs[@]}" --bind "$RUN/audio" /audio
        --clearenv --setenv HOME /tmp --setenv XDG_RUNTIME_DIR /run --setenv PATH /usr/bin
        -- "$LOCK_MNT" --quiet --nproc 64 --write /tmp --write /run --write /audio --exec /usr
        -- pulseaudio -n --daemonize=no --system=no --use-pid-file=no
           --disallow-module-loading --disallow-exit --exit-idle-time=-1
           --disable-shm=yes --realtime=no --high-priority=no
           --log-target=stderr --log-level=error
           -L "module-native-protocol-unix socket=/audio/native auth-anonymous=1"
           -L "module-pipe-sink file=/audio/out sink_name=game sink_properties=device.description=gom format=s16le rate=48000 channels=2")
    launch "$PROFILE/audio.log" "${c[@]}"
    (( DRYRUN )) && return
    AUDIO_PID=$!
    local i
    for (( i = 0; i < 50; i++ )); do
        [[ -S $RUN/audio/native && -p $RUN/audio/out ]] && break
        kill -0 "$AUDIO_PID" 2>/dev/null || break
        sleep 0.1
    done
    if [[ ! -S $RUN/audio/native || ! -p $RUN/audio/out ]]; then
        warn "audio cage did not start, continuing muted (log: $PROFILE/audio.log)"
        AUDIO=0; return
    fi
    # Shrink the FIFO to one page (~21 ms at 48 kHz stereo) so the pipe adds no audible lag.
    python3 -I -c '
import fcntl, os, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK)
os.set_blocking(fd, True)
fcntl.fcntl(fd, 1031, 4096)          # F_SETPIPE_SZ
os.dup2(fd, 0); os.close(fd)
os.execvp("pacat", ["pacat", "--playback", "--raw", "--format=s16le", "--rate=48000",
                    "--channels=2", "--latency-msec=" + sys.argv[2],
                    "--client-name=gom", "--stream-name=" + sys.argv[3]])
' "$RUN/audio/out" "${GOM_AUDIO_LATENCY_MS:-30}" "$NAME" >>"$PROFILE/audio.log" 2>&1 &
    PACAT_PID=$!
}

start_game() {
    local -a c fs cmd
    cage_base c; fs=(); sys_fs fs
    c+=("${fs[@]}"
        --ro-bind-try /sys/dev/char /sys/dev/char
        --ro-bind-try /sys/devices/pci0000:00 /sys/devices/pci0000:00
        --ro-bind-try /sys/devices/system/cpu /sys/devices/system/cpu
        --ro-bind-try /sys/class/drm /sys/class/drm)
    local node
    for node in /dev/dri/renderD*; do c+=(--dev-bind "$node" "$node"); done
    c+=(--overlay-src "$GAME_DIR" --overlay "$PROFILE/layer/upper" "$PROFILE/layer/work" "$GAME_MNT"
        --bind "$PROFILE/home" "$GUEST_HOME"
        --perms 0700 --dir "/run/user/$MY_UID")
    if (( DIRECT_X )); then
        local hostnum; hostnum=$(host_display_number)
        c+=(--ro-bind "/tmp/.X11-unix/X$hostnum" "/tmp/.X11-unix/X$hostnum")
        wild_xauth "$hostnum" && c+=(--ro-bind "$RUN/xauth" /run/xauth)
        XNUM=$hostnum
    else
        c+=(--ro-bind "$RUN/x11/X$XNUM" "/tmp/.X11-unix/X$XNUM")
    fi
    if (( AUDIO )); then c+=(--ro-bind "$RUN/audio/native" "/run/user/$MY_UID/pulse/native"); fi
    local sub; sub=$(dirname -- "$LAUNCHER")
    c+=(--chdir "$GAME_MNT/${sub#.}"
        --clearenv
        --setenv HOME "$GUEST_HOME" --setenv USER player --setenv LOGNAME player
        --setenv PATH /usr/local/bin:/usr/bin:/bin --setenv SHELL /bin/sh
        --setenv LANG "${LANG:-C.UTF-8}" --setenv TMPDIR /tmp
        --setenv DISPLAY ":$XNUM" --setenv XDG_RUNTIME_DIR "/run/user/$MY_UID"
        --setenv SDL_VIDEODRIVER x11 --setenv GOM 1)
    (( DIRECT_X )) && c+=(--setenv XAUTHORITY /run/xauth)
    (( AUDIO )) && c+=(--setenv PULSE_SERVER "unix:/run/user/$MY_UID/pulse/native")
    (( SELFTEST )) && c+=(--setenv GOM_HOST_HOME "$HOME" --setenv GOM_HOST_RUNTIME "$XDG_RUNTIME_DIR"
                          --setenv GOM_HOST_USER "$(id -un)"
                          --setenv GOM_HOST_DISPLAY "${DISPLAY-}")
    c+=(-- "$LOCK_MNT" --nproc "${GOM_NPROC:-4096}" --write "$GUEST_HOME" --write /tmp --write /var/tmp --write "$GAME_MNT"
           --write /run/user --write /dev --dev /dev --write /proc --exec /usr --exec "$GAME_MNT" --)
    if (( SHELL_MODE )); then cmd=(/bin/bash -i)
    elif [[ -x $GAME_DIR/$LAUNCHER ]]; then cmd=("$GAME_MNT/$LAUNCHER")
    elif [[ $LAUNCHER == *.sh ]]; then cmd=(/bin/bash "$GAME_MNT/$LAUNCHER")
    else die "$LAUNCHER is not executable"
    fi
    c+=("${cmd[@]}" "${GAME_ARGS[@]}")

    if (( DRYRUN )); then launch /dev/null "${c[@]}"; return; fi
    if (( SHELL_MODE )); then   # foreground: background jobs get /dev/null as stdin
        SHELL_RC=0
        "${c[@]}" 3<<<"player:x:$MY_UID:$MY_GID:player:$GUEST_HOME:/bin/sh" \
                  4<<<"player:x:$MY_GID:" 5<<<"$MACHINE_ID" || SHELL_RC=$?
        return
    elif (( VERBOSE )); then
        "${c[@]}" 3<<<"player:x:$MY_UID:$MY_GID:player:$GUEST_HOME:/bin/sh" \
                  4<<<"player:x:$MY_GID:" 5<<<"$MACHINE_ID" > >(tee "$PROFILE/last.log") 2>&1 &
    else
        launch "$PROFILE/last.log" "${c[@]}"
    fi
    GAME_PID=$!
}

# ------------------------------------------------------------------ lifecycle

cleanup() {
    local p
    for p in "$GAME_PID" "$PACAT_PID" "$AUDIO_PID" "$DISPLAY_PID"; do
        [[ -n $p ]] && kill "$p" 2>/dev/null || true
    done
    for p in "$GAME_PID" "$PACAT_PID" "$AUDIO_PID" "$DISPLAY_PID"; do
        [[ -n $p ]] && wait "$p" 2>/dev/null || true
    done
    if [[ -n $RUN && -d $RUN ]]; then rm -rf -- "$RUN"; fi
    return 0
}

prepare_profile() {
    PROFILE=$DATA/$NAME
    install -d -m 0700 "$DATA" "$PROFILE" "$PROFILE/home" "$PROFILE/layer" "$PROFILE/layer/upper" "$PROFILE/layer/work"
    [[ -s $PROFILE/machine-id ]] || od -An -N16 -tx1 /dev/urandom | tr -d ' \n' > "$PROFILE/machine-id"
    MACHINE_ID=$(<"$PROFILE/machine-id")
    exec {PROFILE_LOCK}>"$PROFILE/.lock"
    flock -n "$PROFILE_LOCK" || die "profile '$NAME' is already running"
    RUN=$(mktemp -d -- "$XDG_RUNTIME_DIR/gom.$NAME.XXXXXX")
    chmod 0700 -- "$RUN"
}

run_game() {
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP
    if (( DIRECT_X )); then warn "--direct-x: the game can see your whole X session (keystrokes, other windows)"
    else start_display
    fi
    (( AUDIO )) && start_audio
    start_game
    (( DRYRUN )) && exit 0
    (( SHELL_MODE )) && return "$SHELL_RC"
    info "running '$LAUNCHER' as profile '$NAME' (log: $PROFILE/last.log)"
    local rc=0
    if [[ -n $DISPLAY_PID ]]; then wait -n "$GAME_PID" "$DISPLAY_PID" || rc=$?
    else wait "$GAME_PID" || rc=$?
    fi
    if ! kill -0 "$GAME_PID" 2>/dev/null; then
        wait "$GAME_PID" 2>/dev/null && rc=0 || rc=$?
        GAME_PID=''
    else
        info "gamescope window closed, stopping the game"
    fi
    if (( rc != 0 && rc < 128 && ! SHELL_MODE )); then
        warn "game exited with status $rc; last lines of $PROFILE/last.log:"
        tail -n 15 "$PROFILE/last.log" >&2 || true
    fi
    return "$rc"
}

list_profiles() {
    local p
    [[ -d $DATA ]] || { info "no profiles yet"; return; }
    for p in "$DATA"/*/; do
        p=${p%/}
        printf '%-28s %8s   %s\n' "${p##*/}" "$(du -sh -- "$p" 2>/dev/null | cut -f1)" "$p"
    done
}

reset_profile() {
    [[ $RESET =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid profile name"
    local p=$DATA/$RESET
    [[ -d $p ]] || die "no such profile: $RESET"
    exec {l}>"$p/.lock"; flock -n "$l" || die "profile '$RESET' is running"
    rm -rf -- "$p"
    info "deleted profile $RESET ($p)"
}

# ------------------------------------------------------------------ selftest

selftest() {
    need gcc gcc
    make -s -C "$GOM_ROOT" all >&2 || die "build failed"
    local game=$GOM_ROOT/build/selftest-game h before after
    rm -rf -- "$game"; mkdir -p -- "$game"
    cp -- "$GOM_ROOT/build/attack" "$game/attack"
    printf 'original\n' > "$game/marker.txt"
    rm -rf -- "${DATA:?}/selftest"
    h=$(readlink -f -- "$HOME")
    before=$(cd "$game" && find . -type f -exec sha256sum {} + | sort)

    BACKEND=headless NAME=selftest TARGET=$game/attack
    resolve_game "$TARGET"; prepare_profile
    local dry; dry=$(DRYRUN=1 run_game 2>&1) || true
    local rc=0; VERBOSE=1; run_game || rc=$?
    trap - EXIT; cleanup

    local fail=0
    after=$(cd "$game" && find . -type f -exec sha256sum {} + | sort)
    t() { local d=$1; shift; if "$@"; then printf 'PASS  %s\n' "$d"; else printf 'FAIL  %s\n' "$d"; fail=1; fi; }
    # shellcheck disable=SC2329  # called through t()
    absent_in() { ! grep -q -- "$1" "$2" 2>/dev/null; }
    echo "--- host-side checks"
    t "original game files unchanged"               [ "$before" = "$after" ]
    t "game-side write landed in the overlay"       [ -f "$DATA/selftest/layer/upper/written-by-game" ]
    t "persistence attempt stayed in private home"  [ -f "$DATA/selftest/home/.config/autostart/evil.desktop" ]
    t "real ~/.config/autostart untouched"          [ ! -e "$h/.config/autostart/evil.desktop" ]
    t "real ~/.zshrc untouched"                     absent_in gom-selftest "$h/.zshrc"
    t "nothing written to host /tmp"                [ ! -e /tmp/gom-selftest-escape ]
    # A host path only leaks if it is the SOURCE of a bind (the guest-side path may look the same).
    local binds; binds=$(grep -oE -- '--(ro-|dev-)?bind(-try)? [^ ]+' <<<"$dry" | awk '{ print $2 }')
    t "no cage is given the host sound server"      absent_in "$XDG_RUNTIME_DIR/pulse" <(printf '%s\n' "$binds")
    t "no cage is given the host D-Bus / PipeWire"  absent_in "$XDG_RUNTIME_DIR/bus" <(printf '%s\n' "$binds")
    t "no cage is given any part of your home"      absent_in "^$h\(/\|$\)" <(printf '%s\n' "$binds" | grep -v "^$DATA/selftest/" | grep -v "^$GOM_ROOT/")
    t "only gamescope's cage is given host X"       [ "$(grep -o "/tmp/.X11-unix/X${DISPLAY#*:}" <<<"$dry" | wc -l)" -le 2 ]
    t "attack binary reported no open barrier"      grep -q '^RESULT all-blocked' "$DATA/selftest/last.log"
    rm -rf -- "${DATA:?}/selftest" "$game"
    (( fail == 0 && rc == 0 )) || { echo "SELFTEST FAILED"; exit 1; }
    echo "SELFTEST PASSED"
}

# ------------------------------------------------------------------ main

main() {
    parse_args "$@"
    if (( LIST )); then list_profiles; exit 0; fi
    if [[ -n $RESET ]]; then reset_profile; exit 0; fi
    check_host
    ensure_built
    if (( SELFTEST )); then selftest; exit 0; fi
    [[ -n ${TARGET-} ]] || { usage >&2; exit 2; }
    resolve_game "$TARGET"
    prepare_profile
    run_game
}

main "$@"
